---
import '../styles/global.css';
import SiteHeader from '../components/framer/SiteHeader.astro';
import RevealFooter from '../components/framer/RevealFooter.astro';
import DotGrid from '../components/framer/react/DotGrid.jsx';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  bodyClass?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = '/og.png',
  type = 'website',
  noindex = false,
  bodyClass = '',
  schema,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.brand}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = new URL(image, site.url);

// The cover carries its own full-bleed dot field; every other page gets the
// same cursor-reactive matrix as a top-of-page layer behind the content.
const showPageDots = Astro.url.pathname !== '/';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Student and developer',
  description: site.description,
  sameAs: [site.github],
  knowsAbout: [
    'Artificial intelligence',
    'Machine learning',
    'Computer vision',
    'Software engineering',
    'Robotics',
    'Embedded systems',
    'Creative programming',
  ],
};

const structuredData = schema
  ? [personSchema, ...(Array.isArray(schema) ? schema : [schema])]
  : personSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#131110" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.brand} — Notes`} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Faustina:ital,wght@0,300..800;1,300..800&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Redaction+100&family=Redaction+35&display=swap"
    />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.brand} — ${site.tagline}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.brand} — ${site.tagline}`} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body id="top" class:list={[bodyClass, { 'has-page-dots': showPageDots }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    {showPageDots && (
      <div class="page-dots" aria-hidden="true">
        <DotGrid
          client:only="react"
          dotColor="#cf5a3c"
          dotSize={2}
          dotSpacing={26}
          impactRadius={180}
          scaleOnHover={2.1}
          orbitSpeed={0.75}
        />
      </div>
    )}
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <RevealFooter />

    <script>
      import { initHeadingDecode } from '../scripts/headingDecode.js';
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeadingDecode);
      } else {
        initHeadingDecode();
      }
      document.addEventListener('astro:page-load', initHeadingDecode);
    </script>
  </body>
</html>

<style>
  .page-dots {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: min(145vh, 1500px);
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 56%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 56%, transparent 100%);
  }

  :global(body.has-page-dots) {
    background: transparent;
  }

  @media (max-width: 768px), (hover: none) and (pointer: coarse) {
    .page-dots {
      display: none !important;
    }

    :global(body.has-page-dots) {
      background: var(--bg);
    }
  }
</style>
