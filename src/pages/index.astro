---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import portrait from '../assets/ishan-avatar.jpg';
import { site } from '../config';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// The homepage features three entries by id. Everything else appears in the index panel.
const featuredIds = ['dermoai', 'atlas', 'halcyon'];
const featured = featuredIds
  .map((id) => allProjects.find((project) => project.id === id))
  .filter((project) => project !== undefined);

const indexProjects = allProjects.filter((project) => !featuredIds.includes(project.id));

// Featured cards show two facts each. DermoAI's headline percentages are already
// drawn into its artwork plate, so the card shows its class count and recognition instead.
const featureMetricIndexes: Record<string, [number, number]> = {
  dermoai: [2, 3],
  atlas: [0, 1],
  halcyon: [0, 3],
};

const explorations = [
  {
    number: '01',
    title: 'Artificial intelligence',
    note: 'Machine learning, computer vision, neural architectures and local models.',
    status: 'In use',
  },
  {
    number: '02',
    title: 'Software engineering',
    note: 'Application architecture, TypeScript, React and the craft of shipping.',
    status: 'In use',
  },
  {
    number: '03',
    title: 'Hardware & robotics',
    note: 'ESP32, sensors, displays and small systems that meet the physical world.',
    status: 'Exploring',
  },
  {
    number: '04',
    title: 'Systems & open source',
    note: 'Linux, tooling and how software actually meets the machine.',
    status: 'Exploring',
  },
  {
    number: '05',
    title: 'Creative programming',
    note: 'Python, Pygame and interactive experiments made for curiosity.',
    status: 'Exploring',
  },
];

const plannedNotes = [
  {
    number: '01',
    title: 'What I am learning about machine learning',
    note: 'Evaluation, failure modes and the distance between a score and a system.',
  },
  {
    number: '02',
    title: 'Building local-first software',
    note: 'Notes from Atlas Fit on state, storage and owning your own data.',
  },
  {
    number: '03',
    title: 'Electronics, from the bench',
    note: 'Sensors, timing, wiring mistakes and the things that only appear in hardware.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.brand,
  url: site.url,
  description: site.description,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
};

const dialTicks = Array.from({ length: 12 }, (_, i) => i * 30);
---

<BaseLayout schema={schema}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Ishan Asati / student, developer, maker</p>

        <h1 id="hero-title">
          I build to<br />
          <em>understand.</em>
        </h1>

        <p class="hero-lede">
          I am interested in how technology works — from the systems beneath our software
          to the models learning from data, and the electronics meeting the physical world.
          Most of what I know has arrived through projects that were slightly beyond me at
          the start.
        </p>

        <div class="hero-actions">
          <a class="button button--primary" href="/work">
            Explore the work
            <ArrowRight aria-hidden="true" stroke-width="1.6" />
          </a>
          <a class="button" href="/about">
            About me
          </a>
        </div>

        <div class="hero-chips">
          <span class="chip chip--sage">Based in India</span>
          <span class="chip">AI · software · hardware</span>
          <span class="chip">Building in public</span>
        </div>
      </div>

      <aside class="hero-panel panel" aria-label="At a glance">
        <div class="hero-panel-top">
          <span class="mono">Now / Vol. 01</span>
          <span class="chip chip--accent">{site.year}</span>
        </div>

        <div class="dial" aria-hidden="true">
          <svg viewBox="0 0 240 240" fill="none">
            <circle class="dial-track" cx="120" cy="120" r="95" />
            <circle class="dial-arc" cx="120" cy="120" r="95" />
            {dialTicks.map((angle) => (
              <line
                class:list={['dial-tick', { 'is-major': angle % 90 === 0 }]}
                x1="120"
                y1="18"
                x2="120"
                y2={angle % 90 === 0 ? '32' : '27'}
                transform={`rotate(${angle} 120 120)`}
              />
            ))}
          </svg>
          <div class="dial-center">
            <span class="dial-monogram">IA</span>
            <span class="dial-year">26</span>
          </div>
        </div>

        <p class="hero-panel-caption">A working index, not a finished record.</p>

        <dl class="hero-facts">
          <div>
            <dt>Practice</dt>
            <dd>AI, software, hardware</dd>
          </div>
          <div>
            <dt>Method</dt>
            <dd>Build, observe, revise</dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd>Student, building in public</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="selected section" id="selected-work" aria-labelledby="selected-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="eyebrow eyebrow--cobalt">01 / Selected work</p>
          <h2 id="selected-title">
            Three projects,<br />
            three <em>edges.</em>
          </h2>
        </div>
        <p class="section-note">
          A research study, a study operating system and a focus workspace. Different
          surfaces, one question: how does this work, and what can I make with it?
        </p>
      </header>

      <div class="feature-stack">
        {featured.map((project, i) => (
          <article class:list={['feature-card', 'panel', { 'is-reversed': i % 2 === 1 }]}>
            <a class="feature-media" href={`/work/${project.id}`} aria-label={`View the ${project.data.title} case study`}>
              <ProjectArtwork kind={project.data.cover} />
            </a>

            <div class="feature-body">
              <div class="feature-topline">
                <span class="index-number">{project.data.index}</span>
                <span class="chip">{project.data.category}</span>
                <span class="chip chip--accent">{project.data.status}</span>
              </div>

              <h3><a href={`/work/${project.id}`}>{project.data.title}</a></h3>
              <p class="feature-deck">{project.data.deck}</p>

              <dl class="feature-metrics">
                {(featureMetricIndexes[project.id] ?? [0, 1]).map(
                  (metricIndex) => project.data.metrics[metricIndex],
                ).filter((metric) => metric !== undefined).map((metric) => (
                  <div>
                    <dt>{metric.label}</dt>
                    <dd>{metric.value}</dd>
                  </div>
                ))}
              </dl>

              <div class="feature-foot">
                <a class="button" href={`/work/${project.id}`}>
                  Read the case study
                  <ArrowRight aria-hidden="true" stroke-width="1.6" />
                </a>
                <span class="mono feature-year">{project.data.year}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="index-panel panel">
        <div class="index-panel-head">
          <p class="mono">Also in the index</p>
          <a class="link-line" href="/work">
            All entries
            <ArrowRight aria-hidden="true" stroke-width="1.6" />
          </a>
        </div>

        <div class="index-links">
          {indexProjects.map((project) => (
            <a class="index-link" href={`/work/${project.id}`}>
              <span class="index-link-number">{project.data.index}</span>
              <span class="index-link-title">{project.data.title}</span>
              <span class="index-link-category">{project.data.category}</span>
              <span class="chip">{project.data.status}</span>
              <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="about section" aria-labelledby="about-title">
    <div class="shell about-grid">
      <figure class="about-portrait panel">
        <Image
          src={portrait}
          alt="Portrait of Ishan Asati"
          widths={[320, 480, 640]}
          sizes="(max-width: 900px) 82vw, 380px"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span>Ishan Asati</span>
          <span>{site.location} / {site.year}</span>
        </figcaption>
      </figure>

      <div class="about-copy">
        <p class="eyebrow">02 / About</p>
        <h2 id="about-title">
          A student, still<br />
          collecting <em>disciplines.</em>
        </h2>

        <p class="about-lede">
          I am more interested in understanding systems deeply than in collecting
          achievements. That has taken me across software, machine learning, electronics
          and the spaces in between.
        </p>

        <p>
          My interests rarely stay in one place, and that is how I like it. The through-line
          is not a single stack. It is a preference for understanding the whole system —
          and for making ideas into something that runs.
        </p>

        <dl class="about-facts">
          <div>
            <dt>Currently</dt>
            <dd>Student, building in public</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>India</dd>
          </div>
          <div>
            <dt>Working across</dt>
            <dd>AI, software, hardware</dd>
          </div>
          <div>
            <dt>Preferred method</dt>
            <dd>Build, observe, revise</dd>
          </div>
        </dl>

        <a class="button" href="/about">
          The longer version
          <ArrowRight aria-hidden="true" stroke-width="1.6" />
        </a>
      </div>
    </div>
  </section>

  <section class="exploring section" aria-labelledby="exploring-title">
    <div class="shell exploring-grid">
      <div class="exploring-head">
        <p class="eyebrow">03 / Currently exploring</p>
        <h2 id="exploring-title">
          The syllabus<br />
          is <em>self-set.</em>
        </h2>
        <p class="exploring-note">
          A working list, not a skill chart. <span>In use</span> means it appears in
          something I have built. <span>Exploring</span> means I am still learning my way
          around it.
        </p>
      </div>

      <ol class="exploring-list panel">
        {explorations.map((item) => (
          <li class="exploring-row">
            <span class="exploring-number">{item.number}</span>
            <div class="exploring-body">
              <h3>{item.title}</h3>
              <p>{item.note}</p>
            </div>
            <span class:list={['chip', item.status === 'In use' ? 'chip--sage' : '']}>
              {item.status}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="notes section" aria-labelledby="notes-title">
    <div class="shell notes-grid">
      <div class="notes-head">
        <p class="eyebrow">04 / Notes</p>
        <h2 id="notes-title">
          A place for<br />
          <em>thinking aloud.</em>
        </h2>
        <p class="notes-deck">
          Writing takes longer than building. When there is something worth saying — and
          worth standing behind — it will appear here.
        </p>
      </div>

      <div class="notes-panel panel">
        <div class="notes-empty">
          <span class="notes-folio" aria-hidden="true">00</span>
          <div>
            <p class="mono notes-label">The shelf is empty, on purpose</p>
            <h3>No notes are published yet.</h3>
            <p>
              I would rather publish nothing than publish something manufactured to fill a
              page. The first entries will appear when they are actually written, edited
              and worth your time.
            </p>
            <a class="link-line" href="/notes">
              Visit the notes index
              <ArrowRight aria-hidden="true" stroke-width="1.6" />
            </a>
          </div>
        </div>

        <div class="planned">
          <p class="mono notes-label">Planned, not published</p>
          <ol>
            {plannedNotes.map((note) => (
              <li>
                <span class="planned-number">{note.number}</span>
                <div>
                  <h4>{note.title}</h4>
                  <p>{note.note}</p>
                </div>
                <span class="chip">Planned</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="correspondence section--tight" aria-labelledby="correspondence-title">
    <div class="shell correspondence-panel panel panel--accent">
      <div>
        <p class="eyebrow">05 / Correspondence</p>
        <h2 id="correspondence-title">
          A question, a correction,<br />
          or a <em>half-formed idea?</em>
        </h2>
      </div>
      <div class="correspondence-body">
        <p>
          Email is a real inbox, read by a real person. It is the best place to start a
          conversation about a project, a shared interest or something this site got wrong.
        </p>
        <div class="correspondence-actions">
          <a class="button button--primary" href={`mailto:${site.email}`}>
            Say hello
            <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
          </a>
          <a class="button button--ghost" href="/contact">Contact page</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(3rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.62fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .hero-copy {
    min-width: 0;
    animation: hero-rise 0.9s var(--ease-out) both;
  }

  .hero-copy h1 {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8.5vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .hero-copy h1 em {
    color: var(--primary);
    font-style: normal;
  }

  .hero-lede {
    max-width: 54ch;
    margin-top: 1.75rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2rem;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .hero-panel {
    display: flex;
    flex-direction: column;
    padding: clamp(1.1rem, 2vw, 1.5rem);
    animation: hero-rise 0.9s 0.1s var(--ease-out) both;
  }

  .hero-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-panel-top .mono {
    color: var(--muted);
  }

  .dial {
    position: relative;
    width: min(100%, 270px);
    margin: clamp(1rem, 3vw, 1.75rem) auto 0;
    aspect-ratio: 1;
  }

  .dial svg {
    width: 100%;
    height: 100%;
  }

  .dial-track {
    stroke: var(--line);
    stroke-width: 1.5;
  }

  .dial-arc {
    stroke: var(--primary);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 415 182;
    transform: rotate(-90deg);
    transform-origin: 120px 120px;
  }

  .dial-tick {
    stroke: color-mix(in srgb, var(--muted) 52%, transparent);
    stroke-width: 1.5;
  }

  .dial-tick.is-major {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .dial-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
  }

  .dial-monogram {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 3.8rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .dial-year {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1;
  }

  .hero-panel-caption {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
  }

  .hero-facts {
    display: flex;
    flex-direction: column;
    margin-top: 1.35rem;
    border-top: 1px solid var(--line);
  }

  .hero-facts > div {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 0.85rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-facts > div:last-child {
    border-bottom: 0;
  }

  .hero-facts dt {
    color: var(--muted);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero-facts dd {
    color: var(--ink);
    font-size: 0.78125rem;
    font-weight: 550;
    line-height: 1.5;
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.55fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-head h2,
  .about-copy h2,
  .exploring-head h2,
  .notes-head h2,
  .correspondence-panel h2 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.6vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .section-head h2 em,
  .about-copy h2 em,
  .exploring-head h2 em,
  .notes-head h2 em,
  .correspondence-panel h2 em {
    color: var(--primary);
    font-style: normal;
  }

  .section-note {
    max-width: 44ch;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .feature-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .feature-card {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(0.85rem, 1.6vw, 1.15rem);
    transition:
      border-color var(--motion-state) var(--ease),
      transform 320ms var(--ease);
  }

  .feature-card:hover {
    border-color: var(--control-border);
  }

  .feature-card.is-reversed .feature-media {
    order: 2;
  }

  .feature-media {
    display: flex;
    align-items: center;
    min-width: 0;
    border-radius: 14px;
    transition: transform 420ms var(--ease);
  }

  .feature-media:hover {
    transform: translateY(-3px);
  }

  .feature-media :global(.plate) {
    width: 100%;
    border-color: var(--line);
  }

  .feature-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(0.5rem, 2vw, 1.5rem) clamp(0.35rem, 1.5vw, 1rem);
  }

  .feature-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1.1rem;
  }

  .feature-body h3 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .feature-body h3 a {
    transition: color var(--motion-state) var(--ease);
  }

  .feature-body h3 a:hover {
    color: var(--primary);
  }

  .feature-deck {
    max-width: 42ch;
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .feature-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .feature-metrics > div {
    padding: 0.85rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--warm);
  }

  .feature-metrics dt {
    color: var(--muted);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .feature-metrics dd {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.3vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .feature-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .feature-year {
    color: var(--muted);
  }

  .index-panel {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(1.1rem, 2vw, 1.5rem);
    background: var(--warm);
    box-shadow: none;
  }

  .index-panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .index-panel-head .mono {
    color: var(--muted);
  }

  .index-panel-head .link-line {
    min-height: 36px;
    color: var(--ink);
  }

  .index-links {
    display: flex;
    flex-direction: column;
  }

  .index-link {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) minmax(0, 0.85fr) auto 1rem;
    align-items: center;
    gap: 1rem;
    min-height: 58px;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    transition: color var(--motion-state) var(--ease);
  }

  .index-link:last-child {
    border-bottom: 0;
  }

  .index-link:hover {
    color: var(--primary);
  }

  .index-link-number {
    color: var(--primary);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .index-link-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 500;
