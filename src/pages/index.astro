---
import { Image } from 'astro:assets';
import { ArrowDown, ArrowRight, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import portrait from '../assets/ishan-avatar.jpg';
import { site } from '../config';

const explorations = [
  {
    number: '01',
    title: 'Artificial intelligence',
    note: 'Machine learning, computer vision, neural architectures and local models.',
    status: 'In use',
  },
  {
    number: '02',
    title: 'Software engineering',
    note: 'Application architecture, TypeScript, React and the craft of shipping.',
    status: 'In use',
  },
  {
    number: '03',
    title: 'Hardware & robotics',
    note: 'ESP32, sensors, displays and small systems that meet the physical world.',
    status: 'Exploring',
  },
  {
    number: '04',
    title: 'Systems & open source',
    note: 'Linux, tooling and how software actually meets the machine.',
    status: 'Exploring',
  },
  {
    number: '05',
    title: 'Creative programming',
    note: 'Python, Pygame and interactive experiments made for curiosity.',
    status: 'Exploring',
  },
];

const plannedNotes = [
  {
    number: '01',
    title: 'What I am learning about machine learning',
    note: 'Evaluation, failure modes and the distance between a score and a system.',
  },
  {
    number: '02',
    title: 'Building local-first software',
    note: 'Notes from Atlas Fit on state, storage and owning your own data.',
  },
  {
    number: '03',
    title: 'Electronics, from the bench',
    note: 'Sensors, timing, wiring mistakes and the things that only appear in hardware.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.brand,
  url: site.url,
  description: site.description,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout schema={schema}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="shell hero-inner">
      <div class="hero-meta">
        <span>Vol. 01 / {site.year}</span>
        <span>An independent portfolio</span>
        <span>{site.location}</span>
      </div>

      <div class="hero-main">
        <div class="hero-copy">
          <p class="hero-kicker">
            <span class="hero-kicker-mark" aria-hidden="true"></span>
            Student · Developer · Maker
          </p>

          <h1 class="hero-name" id="hero-title">
            <span class="hero-line">Ishan</span>
            <span class="hero-line hero-line--italic">Asati<span class="hero-dot">.</span></span>
          </h1>

          <div class="hero-deck-row">
            <p class="hero-deck">
              Exploring the intersection of artificial intelligence, software and
              engineering. Interested in how things work — driven by what I can build.
            </p>
            <p class="hero-annotation">
              A field journal of<br />projects, experiments<br />and open questions.
            </p>
          </div>
        </div>

        <figure class="portrait">
          <div class="portrait-frame">
            <span class="reg reg--tl" aria-hidden="true"></span>
            <span class="reg reg--tr" aria-hidden="true"></span>
            <span class="reg reg--bl" aria-hidden="true"></span>
            <span class="reg reg--br" aria-hidden="true"></span>
            <Image
              src={portrait}
              alt="Portrait of Ishan Asati"
              widths={[280, 420, 560]}
              sizes="(max-width: 900px) 70vw, 300px"
              loading="eager"
              fetchpriority="high"
            />
            <span class="portrait-mark" aria-hidden="true">IA / 26</span>
          </div>
          <figcaption>
            <span>Fig. A — The author</span>
            <span>India, {site.year}</span>
          </figcaption>
        </figure>
      </div>

      <div class="hero-foot">
        <a class="hero-scroll" href="#selected-work">
          <span>Continue to selected work</span>
          <ArrowDown aria-hidden="true" stroke-width="1.5" />
        </a>
        <p class="hero-foot-note">
          Documented, not embellished.<br />
          Work in progress, in public.
        </p>
        <nav class="hero-index" aria-label="Portfolio index">
          <span class="mono">Index</span>
          <a href="/work">01—04 Work</a>
          <a href="/about">About</a>
          <a href="/notes">Notes</a>
        </nav>
      </div>
    </div>
  </section>

  <section class="selected section" id="selected-work" aria-labelledby="selected-title">
    <div class="shell">
      <header class="section-head">
        <div class="section-label">
          <p class="eyebrow">01 / Selected work</p>
          <p class="section-side-note">Three projects,<br />three different edges<br />of the same curiosity.</p>
        </div>
        <h2 class="section-title" id="selected-title">
          Built, broken,<br />
          and <em>being built.</em>
        </h2>
      </header>

      <article class="feature feature--dermoai">
        <div class="feature-info">
          <div class="feature-topline">
            <span class="index-number">01</span>
            <span class="tag">AI / Machine Learning</span>
          </div>
          <h3 class="feature-title"><a href="/work/dermoai">DermoAI</a></h3>
          <p class="feature-meta mono">Research study · 2026 · First place, DAV ML Khanna</p>
          <p class="feature-desc">
            A twelve-class skin-image classifier built on ConvNeXt-Base, evaluated with
            test-time augmentation. A study in computer vision — and in the limits of a
            good score.
          </p>
          <dl class="feature-stats">
            <div>
              <dt>Accuracy</dt>
              <dd>82.79<span>%</span></dd>
            </div>
            <div>
              <dt>Cancer sensitivity</dt>
              <dd>87.30<span>%</span></dd>
            </div>
          </dl>
          <ArrowLink href="/work/dermoai" label="Read the case study" />
        </div>
        <a class="feature-art" href="/work/dermoai">
          <span class="sr-only">View the DermoAI case study</span>
          <div aria-hidden="true"><ProjectArtwork kind="dermoai" /></div>
        </a>
      </article>

      <article class="feature feature--atlas">
        <a class="feature-art" href="/work/atlas-fit">
          <span class="sr-only">View the Atlas Fit case study</span>
          <div aria-hidden="true"><ProjectArtwork kind="atlas-fit" /></div>
        </a>
        <div class="feature-info">
          <div class="feature-topline">
            <span class="index-number">02</span>
            <span class="tag">Software Engineering</span>
          </div>
          <h3 class="feature-title"><a href="/work/atlas-fit">Atlas Fit</a></h3>
          <p class="feature-meta mono">Active development · PWA · Local-first</p>
          <p class="feature-desc">
            An offline-first strength-training app with deterministic plan generation,
            session logging, progress tracking and a muscle-focused exercise library.
            No account, no backend, no network required.
          </p>
          <ul class="feature-list">
            <li>React, TypeScript and Vite</li>
            <li>Dexie and IndexedDB persistence</li>
            <li>Installable, offline-first PWA</li>
          </ul>
          <ArrowLink href="/work/atlas-fit" label="Read the case study" />
        </div>
      </article>

      <article class="feature feature--robotics">
        <div class="feature-info">
          <div class="feature-topline">
            <span class="index-number">03</span>
            <span class="tag">Hardware / Embedded</span>
          </div>
          <h3 class="feature-title"><a href="/work/robotics-electronics">Robotics & Electronics</a></h3>
          <p class="feature-meta mono">Ongoing · Prototypes & concepts</p>
          <p class="feature-desc">
            ESP32 experiments with motion, distance, sound and light — including a concept
            for a calm, physical Study Focus Console. Bench work, honestly labelled.
          </p>
          <ArrowLink href="/work/robotics-electronics" label="Read the field notes" />
        </div>
        <a class="feature-art" href="/work/robotics-electronics">
          <span class="sr-only">View the robotics and electronics field notes</span>
          <div aria-hidden="true"><ProjectArtwork kind="robotics" /></div>
        </a>
      </article>

      <div class="index-footer">
        <p class="mono">Also in the index</p>
        <a class="index-footer-link" href="/work/programming-experiments">
          <span>04 — Programming Experiments</span>
          <span class="index-footer-status">Forthcoming</span>
          <ArrowUpRight aria-hidden="true" stroke-width="1.5" />
        </a>
        <a class="index-footer-all" href="/work">
          All projects and experiments
          <ArrowRight aria-hidden="true" stroke-width="1.5" />
        </a>
      </div>
    </div>
  </section>

  <section class="about-section stone-section section" aria-labelledby="about-title">
    <div class="shell about-grid">
      <div class="about-head">
        <p class="eyebrow">02 / About</p>
        <h2 class="about-title" id="about-title">
          A student,<br />
          still collecting<br />
          <em>disciplines.</em>
        </h2>
        <div class="about-sign">
          <span class="about-sign-line" aria-hidden="true"></span>
          <span>Ishan Asati<br />India</span>
        </div>
      </div>

      <div class="about-body">
        <p class="about-lede">
          I'm interested in understanding how technology works — from the systems running
          beneath our software to the models learning from data, and the electronics
          interacting with the physical world.
        </p>
        <div class="about-columns">
          <p>
            I enjoy exploring unfamiliar technologies, building things and learning by
            experimenting. Most of what I know has arrived through projects that were
            slightly beyond me at the start.
          </p>
          <p>
            My interests rarely stay in one place, and that's exactly how I like it. The
            through-line is not a single stack. It is a preference for understanding the
            whole system — and for making ideas into something that runs.
          </p>
        </div>

        <dl class="about-facts">
          <div>
            <dt>Currently</dt>
            <dd>Student, building in public</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>India</dd>
          </div>
          <div>
            <dt>Working across</dt>
            <dd>AI, software, hardware</dd>
          </div>
          <div>
            <dt>Preferred method</dt>
            <dd>Build, observe, revise</dd>
          </div>
        </dl>

        <ArrowLink href="/about" label="More about me" />
      </div>
    </div>
  </section>

  <section class="exploring section" aria-labelledby="exploring-title">
    <div class="shell">
      <header class="exploring-head">
        <div>
          <p class="eyebrow">03 / Currently exploring</p>
          <h2 class="exploring-title" id="exploring-title">
            The syllabus<br />is <em>self-set.</em>
          </h2>
        </div>
        <p class="exploring-note">
          A working list, not a skill chart. <span>In use</span> means it appears in
          something I have built. <span>Exploring</span> means I am still learning my way
          around it.
        </p>
      </header>

      <ol class="exploration-list">
        {explorations.map((item) => (
          <li class="exploration-row">
            <span class="exploration-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
            <span class:list={['exploration-status', item.status === 'In use' ? 'is-active' : '']}>
              {item.status}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="notes-section section" aria-labelledby="notes-title">
    <div class="shell notes-grid">
      <header class="notes-head">
        <p class="eyebrow">04 / Notes</p>
        <h2 class="notes-title" id="notes-title">
          A place for<br /><em>thinking aloud.</em>
        </h2>
        <p class="notes-deck">
          Writing takes longer than building. When there is something worth saying — and
          worth standing behind — it will appear here.
        </p>
        <div class="notes-empty">
          <span class="notes-empty-mark" aria-hidden="true">—</span>
          <p>No notes are published yet. The shelf is intentionally empty.</p>
        </div>
        <ArrowLink href="/notes" label="Visit the notes index" />
      </header>

      <div class="notes-planned">
        <p class="mono notes-planned-label">Planned, not published</p>
        <ol>
          {plannedNotes.map((note) => (
            <li>
              <span class="notes-number">{note.number}</span>
              <div>
                <h3>{note.title}</h3>
                <p>{note.note}</p>
              </div>
              <span class="notes-status">Planned</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="shell correspondence">
      <p class="mono">Correspondence</p>
      <a class="correspondence-link" href={`mailto:${site.email}`}>
        {site.email}
        <ArrowUpRight aria-hidden="true" stroke-width="1.25" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  .hero {
    position: relative;
    border-bottom: 1px solid var(--line);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 5.1rem);
    padding-block: 1.4rem 1.75rem;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.075em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(240px, 0.7fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    flex: 1;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-transform: uppercase;
    animation: rise 0.8s var(--ease-out) both;
  }

  .hero-kicker-mark {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--cobalt);
  }

  .hero-name {
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: clamp(4.75rem, 12.5vw, 10.75rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.79;
  }

  .hero-line {
    display: block;
    animation: rise 1s var(--ease-out) both;
  }

  .hero-line--italic {
    font-style: italic;
    animation-delay: 0.08s;
  }

  .hero-dot {
    color: var(--cobalt);
    font-style: normal;
  }

  .hero-deck-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2.5rem;
    max-width: 41rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    animation: rise 1s 0.16s var(--ease-out) both;
  }

  .hero-deck {
    max-width: 36ch;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .hero-annotation {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    line-height: 1.55;
    text-transform: uppercase;
    text-align: right;
  }

  .portrait {
    justify-self: end;
    width: min(100%, 19rem);
    animation: rise 1.1s 0.12s var(--ease-out) both;
  }

  .portrait-frame {
    position: relative;
    padding: 0.55rem;
    background: var(--paper);
    border: 1px solid var(--line);
  }

  .portrait-frame :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 28%;
    filter: grayscale(1) contrast(1.04) brightness(1.02);
  }

  .portrait-frame::after {
    content: "";
    position: absolute;
    inset: 0.55rem;
    pointer-events: none;
    background: var(--cobalt);
    mix-blend-mode: multiply;
    opacity: 0.14;
  }

  .portrait-mark {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    color: var(--ivory);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-shadow: 0 1px 8px rgba(37, 37, 37, 0.4);
  }

  .reg {
    position: absolute;
    z-index: 1;
    width: 0.7rem;
    height: 0.7rem;
    border-color: var(--cobalt);
    border-style: solid;
  }

  .reg--tl {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  .reg--tr {
    top: -1px;
    right: -1px;
    border-width: 1px 1px 0 0;
  }

  .reg--bl {
    bottom: -1px;
    left: -1px;
    border-width: 0 0 1px 1px;
  }

  .reg--br {
    right: -1px;
    bottom: -1px;
    border-width: 0 1px 1px 0;
  }

  .portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.65rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    align-items: end;
    gap: 2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: max-content;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--charcoal);
    transition: color 0.2s ease;
  }

  .hero-scroll svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--cobalt);
    transition: transform 0.35s var(--ease-out);
  }

  .hero-scroll:hover {
    color: var(--cobalt);
  }

  .hero-scroll:hover svg {
    transform: translateY(0.2rem);
  }

  .hero-foot-note {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .hero-index {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-index a {
    color: var(--ink-muted);
    transition: color 0.2s ease;
  }

  .hero-index a:hover {
    color: var(--cobalt);
  }

  .hero-index .mono {
    color: var(--cobalt);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- Section header ---------- */

  .selected {
    padding-top: clamp(4.5rem, 8vw, 8rem);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.3fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-side-note {
    max-width: 20ch;
    margin-top: 2rem;
    color: var(--ink-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 6.5vw, 6rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .section-title em {
    color: var(--cobalt);
  }

  /* ---------- Project features ---------- */

  .feature {
    display: grid;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(3rem, 6vw, 5.5rem);
    border-top: 1px solid var(--line);
  }

  .feature--dermoai {
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.5fr);
  }

  .feature--atlas {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.78fr);
  }

  .feature--robotics {
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.5fr);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .feature-info {
    min-width: 0;
  }

  .feature-topline {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1rem;
  }

  .feature-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 4.8vw, 4.5rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .feature-title a {
    transition: color 0.25s ease;
  }

  .feature-title a:hover {
    color: var(--cobalt);
  }

  .feature-meta {
    margin-top: 0.85rem;
    color: var(--ink-muted);
  }

  .feature-desc {
    max-width: 42ch;
    margin-top: 1.4rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .feature-stats {
    display: flex;
    gap: 2rem;
    margin-top: 1.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-soft);
  }

  .feature-stats dt {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .feature-stats dd {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .feature-stats dd span {
    color: var(--cobalt);
    font-size: 0.55em;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .feature-list li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .feature-list li::before {
    content: "";
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 0.35rem;
    height: 1px;
    background: var(--cobalt);
  }

  .feature-info :global(.link-line) {
