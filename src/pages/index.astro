---
import { getCollection } from 'astro:content';
import { ArrowDown, ArrowRight, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import DotGrid from '../components/framer/react/DotGrid.jsx';
import Dithering from '../components/framer/react/Dithering.jsx';
import SiteInk from '../components/framer/react/SiteInk.jsx';
import PillNav from '../components/framer/react/PillNav.jsx';
import Tabs from '../components/framer/react/Tabs.jsx';
import Stickers from '../components/framer/react/Stickers.jsx';
import portrait from '../assets/ishan-avatar.jpg?url';
import atlasFitPlan from '../assets/projects/atlas-fit/desktop-plan.png?url';
import atlasFitProgress from '../assets/projects/atlas-fit/desktop-progress.png?url';
import studyflowAnalytics from '../assets/projects/studyflow/analytics-1440.png?url';
import halcyonAlmanac from '../assets/projects/halcyon/almanac-1440.png?url';
import { site } from '../config';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const byId = Object.fromEntries(allProjects.map((project) => [project.id, project]));

const featuredIds = ['dermoai', 'atlas', 'halcyon'];
const featured = featuredIds
  .map((id) => byId[id])
  .filter((project) => project !== undefined);

// Featured stories show two facts each. DermoAI's headline percentages are
// already drawn into its artwork plate, so its story shows the class count and
// the competition result instead of repeating the numbers a third time.
const featureMetricIndexes: Record<string, [number, number]> = {
  dermoai: [2, 3],
  atlas: [0, 1],
  halcyon: [0, 1],
};

const chapters = [
  { id: 'prologue', number: '00', title: 'Prologue', note: 'A note before the work' },
  { id: 'question', number: '01', title: 'The question', note: 'Why any of this' },
  { id: 'work', number: '02', title: 'The work', note: 'Three projects, three edges' },
  { id: 'method', number: '03', title: 'The method', note: 'The honest ledger' },
  { id: 'syllabus', number: '04', title: 'The syllabus', note: 'What I am learning now' },
  { id: 'margin', number: '05', title: 'The margin', note: 'Notes, and the empty shelf' },
];

const railChapters = [
  ...chapters,
  { id: 'correspondence', number: '—', title: 'Epilogue', note: 'Correspondence' },
];

const storyNotes: Record<
  string,
  {
    kicker: string;
    headline: string;
    body: string[];
    caseLabel: string;
    caveat?: string;
    external?: string;
    externalLabel?: string;
  }
> = {
  dermoai: {
    kicker: 'Research study · 2026',
    headline: 'A score is not a system.',
    body: [
      'DermoAI classifies skin images into twelve categories. It uses a ConvNeXt-Base backbone, a classification head adapted to the problem, and test-time augmentation at inference. It placed first in the DAV ML Khanna machine learning competition.',
      'None of that makes it a medical device. The project is a research study, evaluated within itself: 82.79% reported accuracy and 87.30% cancer-class sensitivity. The distance between those numbers and a system that deserves trust is the actual subject of the work.',
    ],
    caseLabel: 'Read the DermoAI study',
    caveat: 'Research prototype — not clinically validated.',
    external: 'https://github.com/IshanAsati/dermoai-final',
    externalLabel: 'Repository',
  },
  atlas: {
    kicker: 'Study operating system · In development',
    headline: 'The plan that argues back.',
    body: [
      'Atlas keeps a confidence score for every syllabus topic, lets that score decay, and asks the next question instead of handing over the answer. A syllabus PDF is extracted into subjects and topics; a streaming coach handles the conversation.',
      'The screens for the full loop exist. The mission-planning pipeline is still mocked, and this entry says so. A demo that hid that difference would be a different, less useful product.',
    ],
    caseLabel: 'Read the Atlas case study',
    external: 'https://atlas-sooty-gamma.vercel.app',
    externalLabel: 'Live demo',
  },
  halcyon: {
    kicker: 'Focus workspace · Complete build',
    headline: 'Make room for one thing.',
    body: [
      'Halcyon is a local-first focus workspace: a timer with room to breathe, a dated schedule you can argue with, a place for stray thoughts, a four-voice sequencer and a weekly almanac.',
      'It has six destinations and no account. Everything lives in the browser. The completeness is the point — a quiet tool that asks for nothing beyond the next session.',
    ],
    caseLabel: 'Read the Halcyon case study',
  },
};

const explorations = [
  {
    number: '01',
    title: 'Artificial intelligence',
    note: 'Machine learning, computer vision, neural architectures and local models.',
    status: 'In use',
  },
  {
    number: '02',
    title: 'Software engineering',
    note: 'Application architecture, TypeScript, React and the craft of shipping.',
    status: 'In use',
  },
  {
    number: '03',
    title: 'Hardware & robotics',
    note: 'ESP32, sensors, displays and small systems that meet the physical world.',
    status: 'Exploring',
  },
  {
    number: '04',
    title: 'Systems & open source',
    note: 'Linux, tooling and how software actually meets the machine.',
    status: 'Exploring',
  },
  {
    number: '05',
    title: 'Creative programming',
    note: 'Python, Pygame and interactive experiments made for curiosity.',
    status: 'Exploring',
  },
];

const plannedNotes = [
  {
    number: '01',
    title: 'What I am learning about machine learning',
    note: 'Evaluation, failure modes and the distance between a score and a system.',
  },
  {
    number: '02',
    title: 'Building local-first software',
    note: 'Notes from Atlas Fit on state, storage and owning your own data.',
  },
  {
    number: '03',
    title: 'Electronics, from the bench',
    note: 'Sensors, timing, wiring mistakes and the things that only appear in hardware.',
  },
];

const methodTabs = [
  {
    tab: 'Build first',
    eyebrow: 'First move',
    title: 'Make the smallest real thing.',
    description:
      'Every entry here started small enough to run: a classifier on a real dataset, a plan screen with a real week behind it. Building first turns an opinion into evidence.',
    image: { src: atlasFitPlan, alt: 'The Atlas Fit desktop plan screen, showing a generated training week.' },
    primaryLabel: 'Read the method',
    primaryLink: '/work/atlas-fit',
    secondaryLabel: 'The work',
    secondaryLink: '/work',
  },
  {
    tab: 'Observe',
    eyebrow: 'Second move',
    title: 'Watch what actually happens.',
    description:
      'A score, a week that survives a calendar, a circuit that misreads its sensor: each returns something the plan could not predict.',
    image: { src: studyflowAnalytics, alt: 'The StudyFlow analytics screen, charting focus sessions over time.' },
    primaryLabel: 'Read the method',
    primaryLink: '/work/studyflow',
    secondaryLabel: 'The work',
    secondaryLink: '/work',
  },
  {
    tab: 'Revise',
    eyebrow: 'Third move',
    title: 'Let the evidence change the plan.',
    description:
      'When a result contradicts the design, the design moves. Atlas labels its mocked pipeline as mocked. DermoAI keeps its caveat above its own numbers.',
    image: { src: atlasFitProgress, alt: 'The Atlas Fit progress screen, showing logged training history.' },
    primaryLabel: 'Read the method',
    primaryLink: '/work/atlas-fit',
    secondaryLabel: 'The work',
    secondaryLink: '/work',
  },
  {
    tab: 'State plainly',
    eyebrow: 'Last move',
    title: 'Say where it actually stands.',
    description:
      'Complete build, in development, research study, reserved entry. A status line is more useful than a highlight reel.',
    image: { src: halcyonAlmanac, alt: 'The Halcyon weekly almanac screen, summarising the week behind.' },
    primaryLabel: 'Read the method',
    primaryLink: '/work/halcyon',
    secondaryLabel: 'The work',
    secondaryLink: '/work',
  },
];

const syllabusStickers = [
  { design: 'burst', label: 'Learning', subtitle: 'In use', color: '#cf5a3c', ink: '#f4efe6', material: 'paper', width: 200, x: 64, y: 39, mobileX: 84, mobileY: 15, rotation: -8, wear: 0.08 },
  { design: 'ticket', label: 'Software', subtitle: 'In use', color: '#8d9a6b', ink: '#131110', material: 'vinyl', width: 205, x: 82, y: 71, mobileX: 86, mobileY: 42, rotation: 5, wear: 0.05 },
  { design: 'orbit', label: 'Hardware', subtitle: 'Exploring', color: '#d8a05e', ink: '#131110', material: 'paper', width: 190, x: 96, y: 30, mobileX: 88, mobileY: 70, rotation: -3, wear: 0.12 },
  { design: 'bubble', label: 'Systems', subtitle: 'Exploring', color: '#6f7f8c', ink: '#f4efe6', material: 'vinyl', width: 198, x: 25, y: 84, mobileX: 20, mobileY: 92, rotation: 4, wear: 0.06 },
  { design: 'burst', label: 'Creative', subtitle: 'Exploring', color: '#b8705f', ink: '#f4efe6', material: 'paper', width: 190, x: 57, y: 93, mobileX: 74, mobileY: 94, rotation: -6, wear: 0.1 },
];

const pillChapters = railChapters.map((chapter) => ({
  label: chapter.title,
  href: `#${chapter.id}`,
}));


const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.brand,
  url: site.url,
  description: site.description,
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
};
---

<BaseLayout schema={schema}>
  <div class="pill-dock" data-pill-nav>
    <PillNav
      client:only="react"
      items={pillChapters}
      activeLink="Prologue"
      backgroundColor="#211d1a"
      textColor="#a49b8c"
      activeBackgroundColor="#cf5a3c"
      activeTextColor="#131110"
      padding={6}
      gap={0}
      linkPadding="10px 16px"
      font={{ fontFamily: "'Redaction 35', serif", fontSize: '13.5px', fontWeight: 500, letterSpacing: '0.04em' }}
    />
  </div>

  <div class="edition">
    <!-- Cover -->
    <section class="cover" aria-labelledby="cover-title">
      <div class="cover-field" aria-hidden="true">
        <DotGrid
          client:only="react"
          dotColor="#cf5a3c"
          dotSize={3}
          dotSpacing={24}
          impactRadius={190}
          scaleOnHover={2.1}
          orbitSpeed={0.7}
        />
        <DotGrid
          client:only="react"
          dotColor="#cf5a3c"
          dotSize={3}
          dotSpacing={24}
          impactRadius={190}
          scaleOnHover={2.1}
          orbitSpeed={1.1}
        />
      </div>
      <div class="cover-wash" aria-hidden="true"></div>

      <div class="shell cover-grid">
        <div class="cover-copy">
          <p class="issue-line">
            <span>{site.issue}</span>
            <span>Issue {site.year}</span>
            <span>{site.location}</span>
          </p>

          <SiteInk
            client:only="react"
            tag="h1"
            text="I build to understand."
            id="cover-title"
            align="left"
            min={46}
            max={136}
            scale={12.8}
            trigger="load"
            delay={0.15}
            stagger={0.09}
          />

          <p class="cover-deck">
            Notes from a student who learns by making things: a skin-image classifier,
            a study coach that argues back, a quieter place to focus, and a few circuits
            on the bench.
          </p>

          <div class="cover-work">
            <p class="cover-work-label">Selected work</p>
            <ul class="cover-work-list">
              {featured.map((project) => (
                <li>
                  <a class="cover-work-item" href={`/work/${project.id}`}>
                    <span class="cover-work-title">{project.data.title}</span>
                    <span class="cover-work-status">{project.data.status}</span>
                    <ArrowUpRight aria-hidden="true" stroke-width="1.4" />
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="cover-actions">
            <a class="button" href="#prologue">
              Begin reading
              <ArrowDown aria-hidden="true" stroke-width="1.5" />
            </a>
            <a class="button" href="#work">
              See the work
              <ArrowRight aria-hidden="true" stroke-width="1.5" />
            </a>
          </div>
        </div>

        <div class="cover-portrait">
          <Dithering
            client:only="react"
            image={{ src: portrait, alt: 'Portrait of Ishan Asati' }}
            ovalSize={210}
            dotSize={4}
            damping={25}
            stiffness={300}
          />
        </div>
      </div>

      <div class="cover-stickers">
        <Stickers
          client:only="react"
          stickers={syllabusStickers}
          background="transparent"
          dots="#3a342e"
          showDots={false}
          radius={0}
          peel={0.95}
          sound={false}
          style={{ width: '100%', height: '100%' }}
        />
      </div>
    </section>

    <!-- Prologue -->
    <section class="prologue" id="prologue" data-chapter="prologue" aria-labelledby="prologue-title">
      <div class="shell prologue-grid">
        <aside class="prologue-folio" aria-hidden="true">
          <p class="folio">00</p>
          <p class="folio-label">Prologue</p>
        </aside>

        <div class="prologue-body" data-reveal>
          <p class="eyebrow">A note before the work</p>

          <h2 id="prologue-title">
            There is a kind of learning that only happens when something has to run.
          </h2>

          <p class="dropcap" data-reveal>
            Most of what I know arrived through projects that were slightly beyond me at
            the start. A model that had to classify images. A study plan that had to
            survive a real week. A timer that had to be quiet enough to use. The making
            came first; the understanding followed.
          </p>

          <p data-reveal>
            I am a student in India, working across artificial intelligence, software and
            the physical edge of computing. I do not have a single stack, and I have
            stopped treating that as a flaw. The through-line is a preference for
            understanding the whole system — and for making ideas into something that runs.
          </p>

          <blockquote data-reveal>
            <p>“Build, observe, revise. Then say plainly what is real and what is still a sketch.”</p>
          </blockquote>

          <div class="toc" data-reveal>
            <div class="toc-head">
              <p class="toc-label">Contents</p>
              <p class="toc-meta">{site.issue} / {site.year}</p>
            </div>

            <ol class="toc-list">
              {chapters.map((chapter) => (
                <li>
                  <a href={`#${chapter.id}`}>
                    <span class="toc-number">{chapter.number}</span>
                    <span class="toc-title">{chapter.title}</span>
                    <span class="toc-dots" aria-hidden="true" />
                    <span class="toc-note">{chapter.note}</span>
                  </a>
                </li>
              ))}
              <li>
                <a href="#correspondence">
                  <span class="toc-number">—</span>
                  <span class="toc-title">Epilogue</span>
                  <span class="toc-dots" aria-hidden="true" />
                  <span class="toc-note">Correspondence</span>
                </a>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Chapter one -->
    <section class="chapter" id="question" data-chapter="question" aria-labelledby="question-title">
      <div class="shell">
        <header class="chapter-head" data-reveal>
          <p class="chapter-number" aria-hidden="true">01</p>
          <div class="chapter-heading">
            <p class="eyebrow">Chapter one</p>
            <SiteInk
              client:only="react"
              tag="h2"
              text="Curiosity, kept in the open."
              id="question-title"
              min={34}
              max={62}
              scale={5.6}
            />
          </div>
          <p class="chapter-deck">
            I am less interested in collecting disciplines than in following a question
            until it becomes a thing that works.
          </p>
        </header>

        <div class="chapter-cols">
          <div class="chapter-prose" data-reveal>
            <p class="lede">
              I move between machine learning, software engineering and embedded systems
              because the questions do.
            </p>
            <p>
              A vision model raises questions about data and trust. A study tool raises
              questions about memory and attention. A circuit raises questions about
              timing, voltage and the gap between a diagram and a wire.
            </p>
            <p>
              The interests rarely stay in one place. That is how I like it. The point was
              never to look like someone who has arrived. It was to keep the questions
              close enough to work on.
            </p>
          </div>

          <aside class="chapter-margin" data-reveal>
            <p class="margin-label">At a glance</p>
            <dl class="margin-list">
              <div>
                <dt>Currently</dt>
                <dd>Student, building in public</dd>
              </div>
              <div>
                <dt>Based in</dt>
                <dd>{site.location}</dd>
              </div>
              <div>
                <dt>Working across</dt>
                <dd>AI, software, hardware</dd>
              </div>
              <div>
                <dt>Preferred method</dt>
                <dd>Build, observe, revise</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <!-- Chapter two: the work -->
    <section class="chapter chapter--work" id="work" data-chapter="work" aria-labelledby="work-title">
      <div class="shell">
        <header class="chapter-head" data-reveal>
          <p class="chapter-number" aria-hidden="true">02</p>
          <div class="chapter-heading">
            <p class="eyebrow">Chapter two</p>
            <SiteInk
              client:only="react"
              tag="h2"
              text="Three things, built to find out."
              id="work-title"
              min={34}
              max={62}
              scale={5.6}
            />
          </div>
          <p class="chapter-deck">
            Each began with a question that a plan alone could not answer.
          </p>
        </header>

        <div class="stories">
          {featured.map((project, i) => {
            const story = storyNotes[project.id];
            const metrics = featureMetricIndexes[project.id]
              .map((index) => project.data.metrics[index])
              .filter((metric) => metric !== undefined);

            return (
              <article class:list={['story', { 'story--reverse': i % 2 === 1 }]} data-reveal>
                <p class="story-index" aria-hidden="true">02.{i + 1}</p>

                <div class="story-copy">
                  <p class="story-kicker">{story.kicker}</p>
                  <h3>{story.headline}</h3>
                  <p class="story-deck">{project.data.deck}</p>

                  <div class="story-body">
                    {story.body.map((paragraph) => <p>{paragraph}</p>)}
                  </div>

                  <dl class="story-facts">
                    {metrics.map((metric) => (
                      <div>
                        <dt>{metric.label}</dt>
                        <dd>
                          <span class="story-fact-value">{metric.value}</span>
                          {metric.note && <span class="story-fact-note">{metric.note}</span>}
                        </dd>
                      </div>
                    ))}
                  </dl>

                  {story.caveat && <p class="story-caveat">{story.caveat}</p>}

                  <div class="story-links">
                    <a class="story-link" href={`/work/${project.id}`}>
                      {story.caseLabel}
                      <ArrowRight aria-hidden="true" stroke-width="1.4" />
                    </a>
                    {story.external && (
                      <a
                        class="story-link story-link--quiet"
                        href={story.external}
                        target="_blank"
                        rel="noreferrer noopener"
                      >
                        {story.externalLabel}
                        <ArrowUpRight aria-hidden="true" stroke-width="1.4" />
                        <span class="sr-only"> (opens in a new tab)</span>
                      </a>
                    )}
                  </div>
                </div>

                <figure class="story-plate">
                  <ProjectArtwork kind={project.data.cover} />
                  <figcaption>
                    <span>Fig. {project.data.index} — {project.data.title}</span>
                    <span>{project.data.status}</span>
                  </figcaption>
                </figure>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Chapter three: method -->
    <section class="chapter" id="method" data-chapter="method" aria-labelledby="method-title">
      <div class="shell">
        <header class="chapter-head" data-reveal>
          <p class="chapter-number" aria-hidden="true">03</p>
          <div class="chapter-heading">
            <p class="eyebrow">Chapter three</p>
            <SiteInk
              client:only="react"
              tag="h2"
              text="Build. Observe. Revise."
              id="method-title"
              min={34}
              max={62}
              scale={5.6}
            />
          </div>
          <p class="chapter-deck">
            A portfolio is more useful when it says where each thing actually stands.
          </p>
        </header>

        <div class="method-intro" data-reveal>
          <p class="lede">
            Honest records, not a highlight reel.
          </p>
          <p>
            Every entry carries its real stage and status. These four moves describe how
            the work gets made — and what happens when a result disagrees with the plan.
          </p>
        </div>

        <div class="method-tabs" data-reveal>
          <Tabs
            client:only="react"
            items={methodTabs}
            cardBackground="#1b1816"
            textColor="#f4efe6"
            mutedTextColor="#a49b8c"
            tabColor="#a49b8c"
            activeTabColor="#f4efe6"
            primaryBackground="#cf5a3c"
            primaryTextColor="#131110"
            secondaryColor="#f4efe6"
            arrowBackground="#cf5a3c"
            arrowColor="#131110"
            cardWidth={48}
            imageWidth={64}
            imageHeight={78}
            style={{ width: '100%', height: 'clamp(620px, 56vw, 700px)' }}
            cardRadius={4}
            imageRadius={2}
            grainOpacity={0.03}
            imageOverlayColor="#131110"
            imageOverlayOpacity={0.18}
            eyebrowFont={{ fontFamily: "'Redaction 35', serif", fontSize: '12px', fontWeight: 500, letterSpacing: '0.08em', textTransform: 'uppercase' }}
            tabFont={{ fontFamily: "'Redaction 35', serif", fontSize: '14.5px', fontWeight: 500, letterSpacing: '0.04em' }}
            titleFont={{ fontFamily: "'Redaction 35', serif", fontSize: '38px', fontWeight: 400, letterSpacing: '-0.03em', lineHeight: '1.05em' }}
            bodyFont={{ fontFamily: "'Redaction 35', serif", fontSize: '18.5px', fontWeight: 400, lineHeight: '1.6em' }}
            buttonFont={{ fontFamily: "'Redaction 35', serif", fontSize: '13px', fontWeight: 500, letterSpacing: '0.04em' }}
          />
        </div>
      </div>
    </section>

    <!-- Chapter four: syllabus -->
    <section class="chapter" id="syllabus" data-chapter="syllabus" aria-labelledby="syllabus-title">
      <div class="shell">
        <header class="chapter-head" data-reveal>
          <p class="chapter-number" aria-hidden="true">04</p>
          <div class="chapter-heading">
            <p class="eyebrow">Chapter four</p>
            <SiteInk
              client:only="react"
              tag="h2"
              text="A syllabus I set myself."
              id="syllabus-title"
              min={34}
              max={62}
              scale={5.6}
            />
          </div>
          <p class="chapter-deck">
            <em>In use</em> means it appears in something I have built.
            <em>Exploring</em> means I am still learning my way around it.
          </p>
        </header>

        <div class="syllabus-grid" data-reveal>
          <ol class="syllabus">
            {explorations.map((item) => (
              <li class="syllabus-row">
                <span class="syllabus-number" aria-hidden="true">{item.number}</span>
                <div class="syllabus-body">
                  <h3>{item.title}</h3>
                  <p>{item.note}</p>
                </div>
                <span class:list={['tag', { 'tag--active': item.status === 'In use' }]}>
                  {item.status}
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Chapter five: margin -->
    <section class="chapter" id="margin" data-chapter="margin" aria-labelledby="margin-title">
      <div class="shell">
        <header class="chapter-head" data-reveal>
          <p class="chapter-number" aria-hidden="true">05</p>
          <div class="chapter-heading">
            <p class="eyebrow">Chapter five</p>
            <SiteInk client:only="react" tag="h2" text="The margin." id="margin-title" min={34} max={62} scale={5.6} />
          </div>
          <p class="chapter-deck">
            Notes, when there is something worth standing behind.
          </p>
        </header>

        <div class="margin-grid">
          <div class="margin-statement" data-reveal>
            <p class="lede">
              The shelf is empty on purpose.
            </p>
            <p>
              Writing takes longer than building. I would rather publish nothing than
