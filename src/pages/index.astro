<script>
  // Reveal editorial blocks as they enter the reading column.
  const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

  if (!('IntersectionObserver' in window)) {
    revealItems.forEach((item) => item.classList.add('is-in'));
  } else {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          revealObserver.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.06 },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  }

  // The floating chapter pill steps aside for the cover and the footer.
  const pill = document.querySelector<HTMLElement>('[data-pill-nav]');
  const cover = document.querySelector('.cover');
  const footer = document.querySelector('[data-reveal-footer]');

  if (pill && cover && footer) {
    const setHidden = () => {
      const bottom = window.innerHeight * 0.08;
      const coverRect = cover.getBoundingClientRect();
      const footerRect = footer.getBoundingClientRect();
      const atCover = coverRect.bottom > bottom;
      const atFooter = footerRect.top < window.innerHeight - bottom;
      pill.toggleAttribute('data-hidden', atCover || atFooter);
    };

    setHidden();
    window.addEventListener('scroll', setHidden, { passive: true });
    window.addEventListener('resize', setHidden);
  }
</script>
