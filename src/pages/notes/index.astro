---
import { getCollection } from 'astro:content';
import { ArrowUpRight, Rss } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const planned = [
  {
    number: '01',
    title: 'What I am learning about machine learning',
    note: 'Evaluation, failure modes and the distance between a score and a system.',
    category: 'AI / ML',
  },
  {
    number: '02',
    title: 'Building local-first software',
    note: 'Notes from Atlas Fit on state, storage and owning your own data.',
    category: 'Software',
  },
  {
    number: '03',
    title: 'Electronics, from the bench',
    note: 'Sensors, timing, wiring mistakes and the things that only appear in hardware.',
    category: 'Hardware',
  },
  {
    number: '04',
    title: 'Linux, slowly',
    note: 'Learning the system underneath the tools instead of memorising commands.',
    category: 'Systems',
  },
];

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Notes — Ishan Asati',
  description: 'Technical notes and writing by Ishan Asati. Currently forthcoming.',
  url: `${site.url}/notes`,
};

const hasNotes = notes.length > 0;
---

<BaseLayout
  title="Notes"
  description="Technical notes and writing by Ishan Asati on machine learning, software, electronics and learning by building. The first entries are forthcoming."
  schema={schema}
>
  <section class="notes-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Index</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Notes</li>
        </ol>
      </nav>

      <div class="head-grid">
        <div>
          <p class="eyebrow">Notes / {hasNotes ? `${notes.length} published` : 'Forthcoming'}</p>
          <h1>
            Thinking<br />
            <em>in public.</em>
          </h1>
        </div>

        <div class="head-note panel">
          <p>
            Occasional writing about what I am learning: machine learning, local-first
            software, electronics, Linux and the unglamorous parts of building things.
          </p>
          <p class="mono head-note-detail">
            {hasNotes ? 'Published entries are listed below.' : 'No entries published yet.'}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="notes-body section" aria-labelledby="notes-index-title">
    <div class="shell notes-layout">
      <aside class="notes-aside">
        <div class="notes-aside-panel panel panel--warm">
          <p class="eyebrow eyebrow--plain">The index</p>
          <p class="notes-count">
            <span>{String(notes.length).padStart(2, '0')}</span>
            published {notes.length === 1 ? 'entry' : 'entries'}
          </p>
          <a class="rss-link" href="/rss.xml">
            <Rss aria-hidden="true" stroke-width="1.6" />
            RSS feed
          </a>
        </div>
      </aside>

      <div class="notes-main">
        {hasNotes ? (
          <ol class="entry-list panel" aria-labelledby="notes-index-title">
            {notes.map((note, i) => (
              <li class="entry">
                <a href={`/notes/${note.id}`}>
                  <span class="entry-number">{String(i + 1).padStart(2, '0')}</span>
                  <div class="entry-body">
                    <div class="entry-meta">
                      <span class="mono">{note.data.category}</span>
                      <time datetime={note.data.pubDate.toISOString()}>
                        {dateFormatter.format(note.data.pubDate)}
                      </time>
                    </div>
                    <h2>{note.data.title}</h2>
                    <p>{note.data.description}</p>
                  </div>
                  <ArrowUpRight class="entry-arrow" aria-hidden="true" stroke-width="1.6" />
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty-state panel">
            <p class="empty-folio" aria-hidden="true">00</p>
            <div class="empty-copy">
              <p class="mono empty-label">The shelf is empty, on purpose</p>
              <h2 id="notes-index-title">No notes are published yet.</h2>
              <p>
                Writing takes longer than building, and I would rather publish nothing than
                publish something manufactured to fill a page. The first entries will appear
                here when they are actually written, edited and worth your time.
              </p>
              <p>
                There is no newsletter and no account. The <a href="/rss.xml">RSS feed</a> is
                the honest way to know when something changes.
              </p>
            </div>
          </div>
        )}

        <div class="planned panel">
          <div class="planned-head">
            <p class="mono">Planned, not published</p>
            <p>
              These are topics I intend to write about. They are not articles, and they will
              not be presented as such until they exist.
            </p>
          </div>

          <ol class="planned-list">
            {planned.map((item) => (
              <li>
                <span class="planned-number">{item.number}</span>
                <div>
                  <span class="mono planned-category">{item.category}</span>
                  <h3>{item.title}</h3>
                  <p>{item.note}</p>
                </div>
                <span class="chip">Planned</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="notes-contact section--tight">
    <div class="shell contact-panel panel panel--accent">
      <div>
        <p class="eyebrow">Correspondence</p>
        <p class="notes-contact-note">
          If something here is wrong, unclear or worth arguing with, I would like to hear it.
        </p>
      </div>
      <a class="button button--primary" href={`mailto:${site.email}`}>
        {site.email}
        <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .notes-head {
    padding-block: var(--page-head-pad-top, clamp(5.5rem, 8.5vw, 7.5rem)) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a {
    transition: color var(--motion-state) var(--ease);
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  .crumbs [aria-current] {
    color: var(--ink);
  }

  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.55fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .head-grid h1 {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8.5vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  .head-grid h1 em {
    color: var(--primary);
    font-style: normal;
  }

  .head-note {
    padding: clamp(1.1rem, 2vw, 1.5rem);
    background: var(--warm);
    box-shadow: none;
  }

  .head-note p {
    max-width: 42ch;
    color: var(--ink-soft);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .head-note-detail {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    color: var(--muted) !important;
  }

  .notes-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .notes-aside {
    position: sticky;
    top: 7.5rem;
  }

  .notes-aside-panel {
    padding: 1.1rem 1.2rem;
    box-shadow: none;
  }

  .notes-count {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 550;
    line-height: 1.5;
  }

  .notes-count span {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    margin-top: 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 650;
    transition: color var(--motion-state) var(--ease);
  }

  .rss-link:hover {
    color: var(--primary);
  }

  .rss-link svg {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--primary);
  }

  .notes-main {
    display: flex;
    flex-direction: column;
    gap: clamp(0.85rem, 1.6vw, 1.25rem);
    min-width: 0;
  }

  .empty-state {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: none;
  }

  .empty-folio {
    color: var(--primary);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.8;
  }

  .empty-label {
    color: var(--muted);
  }

  .empty-copy h2 {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .empty-copy p:not(.empty-label) {
    max-width: 56ch;
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .empty-copy a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .entry-list {
    overflow: hidden;
    box-shadow: none;
  }

  .entry a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 1rem;
    align-items: start;
    gap: 1rem;
    padding: clamp(1.1rem, 2vw, 1.4rem);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--motion-state) var(--ease);
  }

  .entry:last-child a {
    border-bottom: 0;
  }

  .entry a:hover {
    background: var(--warm);
  }

  .entry-number {
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.8;
    font-variant-numeric: tabular-nums;
  }

  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .entry-body h2 {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .entry-body p {
    max-width: 56ch;
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.65;
  }

  .entry-arrow {
    width: 1rem;
    height: 1rem;
    margin-top: 0.25rem;
    color: var(--primary);
  }

  .planned {
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    background: var(--warm);
    box-shadow: none;
  }

  .planned-head {
    display: grid;
    grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .planned-head .mono {
    color: var(--muted);
  }

  .planned-head p:not(.mono) {
    max-width: 52ch;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .planned-list {
    display: flex;
    flex-direction: column;
  }

  .planned-list li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.85rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .planned-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .planned-number {
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.7;
    font-variant-numeric: tabular-nums;
  }

  .planned-category {
    color: var(--muted);
  }

  .planned-list h3 {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }

  .planned-list p {
    max-width: 60ch;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    box-shadow: none;
  }

  .notes-contact-note {
    max-width: 56ch;
    margin-top: 0.65rem;
    color: var(--ink-soft);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .head-grid,
    .notes-layout,
    .contact-panel {
      grid-template-columns: 1fr;
    }

    .head-note {
      max-width: 620px;
    }

    .notes-aside {
      position: static;
    }

    .notes-aside-panel {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem 1.5rem;
    }

    .notes-count {
      margin-top: 0;
    }

    .notes-count span {
      display: inline;
      margin-right: 0.35rem;
      font-size: 1.5rem;
    }

    .rss-link {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    .contact-panel .button {
      justify-self: start;
    }
  }

  @media (max-width: 700px) {
    .head-grid h1 {
      font-size: clamp(3rem, 15vw, 4.6rem);
    }

    .empty-state {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .planned-head {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .planned-list li {
      grid-template-columns: 1.5rem minmax(0, 1fr);
    }

    .planned-list li .chip {
      display: none;
    }

    .entry a {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .entry-arrow {
      display: none;
    }

    .contact-panel .button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
