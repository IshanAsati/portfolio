---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);

const toc = headings.filter((heading) => heading.depth === 2);

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: note.data.title,
  description: note.data.description,
  datePublished: note.data.pubDate.toISOString(),
  ...(note.data.updatedDate ? { dateModified: note.data.updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
  publisher: {
    '@type': 'Person',
    name: site.name,
  },
  mainEntityOfPage: `${site.url}/notes/${note.id}`,
};
---

<BaseLayout title={note.data.title} description={note.data.description} type="article" schema={schema}>
  <article class="note">
    <header class="note-head">
      <div class="shell">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Index</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/notes">Notes</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{note.data.title}</li>
          </ol>
        </nav>

        <div class="note-head-grid">
          <div>
            <p class="eyebrow">{note.data.category}</p>
            <h1>{note.data.title}</h1>
            <p class="note-deck">{note.data.description}</p>
          </div>

          <dl class="note-meta panel">
            <div>
              <dt>Published</dt>
              <dd><time datetime={note.data.pubDate.toISOString()}>{dateFormatter.format(note.data.pubDate)}</time></dd>
            </div>
            {note.data.updatedDate && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={note.data.updatedDate.toISOString()}>{dateFormatter.format(note.data.updatedDate)}</time></dd>
              </div>
            )}
            <div>
              <dt>Author</dt>
              <dd>{site.name}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <div class="note-body section">
      <div class="shell note-body-grid">
        <aside class="note-aside">
          {toc.length > 0 && (
            <nav class="toc panel panel--warm" aria-label="On this page">
              <p class="mono toc-label">Contents</p>
              <ol>
                {toc.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          )}

          <a class="note-back" href="/notes">
            <ArrowLeft aria-hidden="true" stroke-width="1.6" />
            All notes
          </a>
        </aside>

        <div class="note-content prose-case">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .note-head {
    padding-block: 1.5rem clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.5625rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a {
    transition: color var(--motion-state) var(--ease);
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  .crumbs [aria-current] {
    color: var(--ink);
  }

  .note-head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.45fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .note-head h1 {
    max-width: 22ch;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .note-deck {
    max-width: 52ch;
    margin-top: 1.25rem;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.65;
  }

  .note-meta {
    padding: 1.1rem 1.2rem;
    background: var(--warm);
    box-shadow: none;
  }

  .note-meta > div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.65rem;
    border-bottom: 1px solid var(--line);
  }

  .note-meta > div:first-child {
    padding-top: 0;
  }

  .note-meta > div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .note-meta dt {
    color: var(--muted);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .note-meta dd {
    color: var(--ink);
    font-size: 0.78125rem;
    line-height: 1.5;
  }

  .note-body-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .note-aside {
    position: sticky;
    top: 7.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-self: start;
  }

  .toc {
    padding: 1rem 1.1rem;
    box-shadow: none;
  }

  .toc-label {
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .toc ol {
    display: flex;
    flex-direction: column;
  }

  .toc li {
    border-bottom: 1px solid var(--line);
  }

  .toc li:last-child {
    border-bottom: 0;
  }

  .toc a {
    display: block;
    padding-block: 0.5rem;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.4;
    transition: color var(--motion-state) var(--ease);
  }

  .toc a:hover {
    color: var(--ink);
  }

  .note-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 40px;
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 650;
    transition: color var(--motion-state) var(--ease);
  }

  .note-back:hover {
    color: var(--primary);
  }

  .note-back svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .note-content {
    min-width: 0;
  }

  @media (max-width: 1000px) {
    .note-head-grid,
    .note-body-grid {
      grid-template-columns: 1fr;
    }

    .note-meta {
      max-width: 600px;
    }

    .note-aside {
      position: static;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 700px) {
    .note-head h1 {
      font-size: clamp(2.4rem, 12vw, 3.5rem);
    }
  }
</style>
