---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content, headings } = await render(note);

const toc = headings.filter((heading) => heading.depth === 2);

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: note.data.title,
  description: note.data.description,
  datePublished: note.data.pubDate.toISOString(),
  ...(note.data.updatedDate ? { dateModified: note.data.updatedDate.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
  },
  publisher: {
    '@type': 'Person',
    name: site.name,
  },
  mainEntityOfPage: `https://ishanasati.me/notes/${note.id}`,
};
---

<BaseLayout title={note.data.title} description={note.data.description} type="article" schema={schema}>
  <article class="note">
    <header class="note-head">
      <div class="shell">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Index</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/notes">Notes</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{note.data.title}</li>
          </ol>
        </nav>

        <div class="note-head-grid">
          <div>
            <p class="eyebrow">{note.data.category}</p>
            <h1>{note.data.title}</h1>
            <p class="note-deck">{note.data.description}</p>
          </div>
          <dl class="note-meta">
            <div>
              <dt>Published</dt>
              <dd><time datetime={note.data.pubDate.toISOString()}>{dateFormatter.format(note.data.pubDate)}</time></dd>
            </div>
            {note.data.updatedDate && (
              <div>
                <dt>Updated</dt>
                <dd><time datetime={note.data.updatedDate.toISOString()}>{dateFormatter.format(note.data.updatedDate)}</time></dd>
              </div>
            )}
            <div>
              <dt>Author</dt>
              <dd>{site.name}</dd>
            </div>
          </dl>
        </div>
      </div>
    </header>

    <div class="note-body section">
      <div class="shell note-body-grid">
        <aside class="note-aside">
          {toc.length > 0 && (
            <nav aria-label="On this page">
              <p class="mono">Contents</p>
              <ol>
                {toc.map((heading) => (
                  <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
                ))}
              </ol>
            </nav>
          )}
          <a class="note-back" href="/notes">
            <ArrowLeft aria-hidden="true" stroke-width="1.5" />
            All notes
          </a>
        </aside>

        <div class="note-content prose-case">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .note-head {
    padding-top: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a:hover {
    color: var(--cobalt);
  }

  .crumbs [aria-current] {
    color: var(--charcoal);
  }

  .note-head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.55fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(1.5rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
  }

  .note-head h1 {
    max-width: 20ch;
    margin-top: 1.1rem;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6.5vw, 5.75rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .note-deck {
    max-width: 50ch;
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .note-meta {
    padding-top: 0.35rem;
  }

  .note-meta > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.65rem;
    border-top: 1px solid var(--line-soft);
  }

  .note-meta > div:first-child {
    border-top: 1px solid var(--line);
  }

  .note-meta dt {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .note-meta dd {
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .note-body-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .note-aside {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .note-aside .mono {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--charcoal);
    color: var(--ink-muted);
  }

  .note-aside ol {
    display: flex;
    flex-direction: column;
  }

  .note-aside li {
    border-bottom: 1px solid var(--line-soft);
  }

  .note-aside li a {
    display: block;
    padding-block: 0.55rem;
    color: var(--ink-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .note-aside li a:hover {
    color: var(--cobalt);
  }

  .note-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .note-back svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .note-back:hover {
    color: var(--cobalt);
  }

  @media (max-width: 900px) {
    .note-head-grid,
    .note-body-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .note-meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1.5rem;
    }

    .note-aside {
      position: static;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
