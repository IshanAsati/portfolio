---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { site } from '../../config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allProjects.findIndex((entry) => entry.id === project.id);
const previous = currentIndex > 0 ? allProjects[currentIndex - 1] : undefined;
const next = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : undefined;

const toc = headings.filter((heading) => heading.depth === 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  url: `${site.url}/work/${project.id}`,
  author: {
    '@type': 'Person',
    name: 'Ishan Asati',
    url: site.url,
  },
  keywords: project.data.tools.join(', '),
  ...(project.data.repo ? { sameAs: [project.data.repo] } : {}),
  ...(project.data.demo ? { discussionUrl: project.data.demo } : {}),
};

const metaTitle = project.data.title;
const metaDescription = project.data.summary;
---

<BaseLayout title={metaTitle} description={metaDescription} type="article" schema={schema}>
  <article>
    <header class="case-head">
      <div class="shell">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Index</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/work">Work</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{project.data.title}</li>
          </ol>
        </nav>

        <div class="case-title-grid">
          <div class="case-title-block">
            <div class="case-kicker">
              <span class="index-number">{project.data.index}</span>
              <span class="chip">{project.data.category}</span>
              <span class="chip chip--accent">{project.data.status}</span>
            </div>

            <h1>{project.data.title}</h1>
            <p class="case-deck">{project.data.deck}</p>

            {project.data.award && (
              <p class="case-award">
                <span class="mono">Recognition</span>
                <span>{project.data.award}</span>
              </p>
            )}
          </div>

          <aside class="case-meta panel" aria-label="Project metadata">
            <p class="mono case-meta-label">Project record</p>

            <dl>
              <div>
                <dt>Period</dt>
                <dd>{project.data.year}</dd>
              </div>
              <div>
                <dt>Category</dt>
                <dd>{project.data.category}</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>{project.data.status}</dd>
              </div>
              <div>
                <dt>Tools</dt>
                <dd>{project.data.tools.join(' · ')}</dd>
              </div>
            </dl>

            {(project.data.repo || project.data.demo) && (
              <div class="case-links">
                {project.data.repo && (
                  <a class="button" href={project.data.repo} target="_blank" rel="noreferrer noopener">
                    Repository
                    <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )}
                {project.data.demo && (
                  <a class="button button--primary" href={project.data.demo} target="_blank" rel="noreferrer noopener">
                    Live build
                    <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )}
              </div>
            )}

            {project.data.placeholder && (
              <p class="case-placeholder">Reserved entry — no published work yet</p>
            )}
          </aside>
        </div>

        <div class="case-hero-art">
          <ProjectArtwork kind={project.data.cover} priority />
        </div>

        {project.data.metrics.length > 0 && (
          <dl class="case-metrics">
            {project.data.metrics.map((metric) => (
              <div class="case-metric panel">
                <dt>{metric.label}</dt>
                <dd>
                  {metric.value}
                  {metric.note && <span class="case-metric-note">{metric.note}</span>}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </header>

    <div class="case-body section">
      <div class="shell case-body-grid">
        <aside class="case-aside">
          <div class="toc panel panel--warm">
            <p class="mono toc-label">Contents</p>
            <nav aria-label="On this page">
              <ol>
                {toc.map((heading, i) => (
                  <li>
                    <a href={`#${heading.slug}`}>
                      <span>{String(i + 1).padStart(2, '0')}</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>

          <div class="aside-meta panel panel--flush">
            <p class="mono">Filed under</p>
            <p>{project.data.category}</p>
            <p class="mono aside-status">{project.data.status}</p>
          </div>
        </aside>

        <div class="case-content prose-case">
          <Content />

          <footer class="case-end panel panel--warm">
            <div class="case-end-top">
              <p class="mono">End of entry / {project.data.index}</p>
              <a class="button" href="#top">
                Back to top
                <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
              </a>
            </div>
            <p>
              This record reflects the project at the time of writing. It will be updated as
              the work changes — including when the honest answer is that it stopped.
            </p>
          </footer>
        </div>
      </div>
    </div>
  </article>

  <nav class="case-nav" aria-label="Project navigation">
    <div class="shell case-nav-grid">
      {previous ? (
        <a class="case-nav-item panel" href={`/work/${previous.id}`}>
          <span class="mono case-nav-label">
            <ArrowLeft aria-hidden="true" stroke-width="1.5" /> Previous entry
          </span>
          <strong>{previous.data.title}</strong>
          <span class="case-nav-index">{previous.data.index}</span>
        </a>
      ) : (
        <a class="case-nav-item panel" href="/work">
          <span class="mono case-nav-label">
            <ArrowLeft aria-hidden="true" stroke-width="1.5" /> The index
          </span>
          <strong>All work</strong>
        </a>
      )}

      {next ? (
        <a class="case-nav-item case-nav-item--next panel" href={`/work/${next.id}`}>
          <span class="mono case-nav-label">
            Next entry <ArrowRight aria-hidden="true" stroke-width="1.5" />
          </span>
          <strong>{next.data.title}</strong>
          <span class="case-nav-index">{next.data.index}</span>
        </a>
      ) : (
        <a class="case-nav-item case-nav-item--next panel" href="/contact">
          <span class="mono case-nav-label">
            Elsewhere <ArrowUpRight aria-hidden="true" stroke-width="1.5" />
          </span>
          <strong>Get in touch</strong>
        </a>
      )}
    </div>
  </nav>
</BaseLayout>

<style>
  .case-head {
    padding-block: 1.5rem clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a {
    transition: color var(--motion-state) var(--ease);
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  .crumbs [aria-current] {
    color: var(--ink);
  }

  .case-title-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.55fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(0.5rem, 2vw, 1.5rem) clamp(2rem, 4vw, 3rem);
  }

  .case-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .case-title-block h1 {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 8vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  .case-deck {
    max-width: 52ch;
    margin-top: 1.35rem;
    color: var(--ink-soft);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    line-height: 1.65;
  }

  .case-award {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.85rem;
    max-width: 58ch;
    margin-top: 1.5rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--primary-border);
    border-radius: var(--radius);
    background: var(--primary-soft);
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .case-award .mono {
    color: var(--control-highlight);
  }

  .case-meta {
    padding: clamp(1.1rem, 2vw, 1.4rem);
    background: var(--warm);
    box-shadow: none;
  }

  .case-meta-label {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .case-meta dl {
    display: flex;
    flex-direction: column;
  }

  .case-meta dl > div {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 0.85rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .case-meta dt {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .case-meta dd {
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 550;
    line-height: 1.5;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .case-links .button {
    flex: 1 1 auto;
    min-height: 44px;
    padding-inline: 16px;
    font-size: 0.9375rem;
  }

  .case-placeholder {
    margin-top: 1rem;
    padding: 0.7rem 0.85rem;
    border: 1px dashed var(--primary-border);
    border-radius: 2px;
    color: var(--primary);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .case-hero-art {
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .case-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .case-metric {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.1rem 1.15rem;
    background: var(--warm);
    box-shadow: none;
  }

  .case-metric dt {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .case-metric dd {
    margin-top: 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .case-metric-note {
    display: block;
    margin-top: 0.55rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 550;
    letter-spacing: 0;
    line-height: 1.45;
  }

  .case-body-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .case-aside {
    position: sticky;
    top: 7.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-self: start;
  }

  .toc {
    padding: 1rem 1.1rem;
    box-shadow: none;
  }

  .toc-label {
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .toc ol {
    display: flex;
    flex-direction: column;
  }

  .toc li {
    border-bottom: 1px solid var(--line);
  }

  .toc li:last-child {
    border-bottom: 0;
  }

  .toc a {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 550;
    line-height: 1.4;
    transition: color var(--motion-state) var(--ease);
  }

  .toc a span {
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.8;
    font-variant-numeric: tabular-nums;
  }

  .toc a:hover {
    color: var(--ink);
  }

  .aside-meta {
    padding: 1rem 1.1rem;
    box-shadow: none;
  }

  .aside-meta .mono {
    color: var(--muted);
  }

  .aside-meta p:not(.mono) {
    margin-top: 0.25rem;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .aside-status {
    margin-top: 0.85rem !important;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    color: var(--primary) !important;
  }

  .case-content {
    min-width: 0;
  }

  .case-end {
    max-width: 68ch;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding: clamp(1.1rem, 2vw, 1.4rem);
    background: var(--warm);
    box-shadow: none;
  }

  .case-end-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .case-end-top .mono {
    color: var(--primary);
  }

  .case-end-top .button {
    min-height: 40px;
    padding-inline: 16px;
    font-size: 0.9375rem;
  }

  .case-end > p {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .case-nav {
    padding-bottom: 0;
  }

  .case-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.6vw, 1.1rem);
  }

  .case-nav-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
    padding: clamp(1.2rem, 2.5vw, 1.75rem);
    box-shadow: none;
    transition:
      border-color var(--motion-state) var(--ease),
      transform 260ms var(--ease);
  }

  .case-nav-item:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .case-nav-item--next {
    align-items: flex-end;
    text-align: right;
  }

  .case-nav-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
  }

  .case-nav-label svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .case-nav-item strong {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.8vw, 2.2rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    transition: color var(--motion-state) var(--ease);
  }

  .case-nav-item:hover strong {
    color: var(--primary);
  }

  .case-nav-index {
    position: absolute;
    top: 50%;
    color: var(--primary);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    transform: translateY(-50%);
  }

  .case-nav-item:not(.case-nav-item--next) .case-nav-index {
    right: 1.25rem;
  }

  .case-nav-item--next .case-nav-index {
    left: 1.25rem;
  }

  @media (max-width: 1000px) {
    .case-title-grid,
    .case-body-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .case-meta {
      max-width: 620px;
    }

    .case-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-aside {
      position: static;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.55fr);
      align-items: start;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 700px) {
    .case-title-block h1 {
      font-size: clamp(2.9rem, 15vw, 4.5rem);
    }

    .case-metrics {
      grid-template-columns: 1fr;
    }

    .case-aside {
      grid-template-columns: 1fr;
    }

    .toc ol {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 1rem;
    }

    .case-nav-grid {
      grid-template-columns: 1fr;
    }

    .case-nav-item--next {
      align-items: flex-start;
      text-align: left;
    }

    .case-nav-index {
      position: static;
      transform: none;
    }

    .case-nav-item--next .case-nav-index {
      left: auto;
    }

    .case-end-top .button {
      width: 100%;
    }
  }
</style>
