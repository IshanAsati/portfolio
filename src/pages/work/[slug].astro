---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import ArrowLink from '../../components/ArrowLink.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentIndex = allProjects.findIndex((entry) => entry.id === project.id);
const previous = currentIndex > 0 ? allProjects[currentIndex - 1] : undefined;
const next = currentIndex < allProjects.length - 1 ? allProjects[currentIndex + 1] : undefined;

const toc = headings.filter((heading) => heading.depth === 2);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.data.title,
  description: project.data.summary,
  url: `https://ishanasati.me/work/${project.id}`,
  author: {
    '@type': 'Person',
    name: 'Ishan Asati',
    url: 'https://ishanasati.me',
  },
  keywords: project.data.tools.join(', '),
  ...(project.data.repo ? { sameAs: [project.data.repo] } : {}),
  ...(project.data.demo ? { discussionUrl: project.data.demo } : {}),
};

const metaTitle = project.data.title;
const metaDescription = project.data.summary;
---

<BaseLayout title={metaTitle} description={metaDescription} type="article" schema={schema}>
  <article>
    <header class="case-head">
      <div class="shell">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Index</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/work">Work</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page">{project.data.title}</li>
          </ol>
        </nav>

        <div class="case-title-grid">
          <div class="case-title-block">
            <div class="case-kicker">
              <span class="index-number">{project.data.index}</span>
              <span class="tag">{project.data.category}</span>
            </div>
            <h1>{project.data.title}</h1>
            <p class="case-deck">{project.data.deck}</p>
            {project.data.award && (
              <p class="case-award">
                <span class="mono">Recognition</span>
                {project.data.award}
              </p>
            )}
          </div>

          <aside class="case-meta" aria-label="Project metadata">
            <dl>
              <div>
                <dt>Period</dt>
                <dd>{project.data.year}</dd>
              </div>
              <div>
                <dt>Category</dt>
                <dd>{project.data.category}</dd>
              </div>
              <div>
                <dt>Status</dt>
                <dd>{project.data.status}</dd>
              </div>
              <div>
                <dt>Tools</dt>
                <dd>{project.data.tools.join(' · ')}</dd>
              </div>
            </dl>

            {(project.data.repo || project.data.demo) && (
              <div class="case-links">
                {project.data.repo && (
                  <ArrowLink href={project.data.repo} label="Repository" external />
                )}
                {project.data.demo && (
                  <ArrowLink href={project.data.demo} label="Live build" external />
                )}
              </div>
            )}

            {project.data.placeholder && (
              <p class="case-placeholder mono">Reserved entry — no published work yet</p>
            )}
          </aside>
        </div>

        <div class="case-hero-art">
          <ProjectArtwork kind={project.data.cover} priority />
        </div>

        {project.data.metrics.length > 0 && (
          <dl class="case-metrics">
            {project.data.metrics.map((metric) => (
              <div>
                <dt>{metric.label}</dt>
                <dd>
                  {metric.value}
                  {metric.note && <span class="case-metric-note">{metric.note}</span>}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </header>

    <div class="case-body section">
      <div class="shell case-body-grid">
        <aside class="case-aside">
          <div class="toc">
            <p class="mono toc-label">Contents</p>
            <nav aria-label="On this page">
              <ol>
                {toc.map((heading, i) => (
                  <li>
                    <a href={`#${heading.slug}`}>
                      <span>{String(i + 1).padStart(2, '0')}</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>

          <div class="aside-meta">
            <p class="mono">Filed under</p>
            <p>{project.data.category}</p>
            <p class="mono aside-status">{project.data.status}</p>
          </div>
        </aside>

        <div class="case-content prose-case">
          <Content />

          <footer class="case-end">
            <p class="mono">End of entry / {project.data.index}</p>
            <p>
              This record reflects the project at the time of writing. It will be updated as
              the work changes — including when the honest answer is that it stopped.
            </p>
            <a class="case-top" href="#top">Back to top ↑</a>
          </footer>
        </div>
      </div>
    </div>
  </article>

  <nav class="case-nav" aria-label="Project navigation">
    <div class="shell case-nav-grid">
      {previous ? (
        <a class="case-nav-item case-nav-item--prev" href={`/work/${previous.id}`}>
          <span class="mono"><ArrowLeft aria-hidden="true" stroke-width="1.5" /> Previous entry</span>
          <strong>{previous.data.title}</strong>
          <span class="case-nav-index">{previous.data.index}</span>
        </a>
      ) : (
        <a class="case-nav-item case-nav-item--prev" href="/work">
          <span class="mono"><ArrowLeft aria-hidden="true" stroke-width="1.5" /> The index</span>
          <strong>All work</strong>
        </a>
      )}

      {next ? (
        <a class="case-nav-item case-nav-item--next" href={`/work/${next.id}`}>
          <span class="mono">Next entry <ArrowRight aria-hidden="true" stroke-width="1.5" /></span>
          <strong>{next.data.title}</strong>
          <span class="case-nav-index">{next.data.index}</span>
        </a>
      ) : (
        <a class="case-nav-item case-nav-item--next" href="/contact">
          <span class="mono">Elsewhere <ArrowUpRight aria-hidden="true" stroke-width="1.5" /></span>
          <strong>Get in touch</strong>
        </a>
      )}
    </div>
  </nav>
</BaseLayout>

<style>
  .case-head {
    padding-top: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a:hover {
    color: var(--cobalt);
  }

  .crumbs [aria-current] {
    color: var(--charcoal);
  }

  .case-title-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.65fr);
    align-items: start;
    gap: clamp(2rem, 6vw, 5.5rem);
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .case-kicker {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
  }

  .case-title-block h1 {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 8.5vw, 7.5rem);
    letter-spacing: -0.055em;
    line-height: 0.84;
  }

  .case-deck {
    max-width: 48ch;
    margin-top: 1.6rem;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 1.8rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink-soft);
  }

  .case-award {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .case-award .mono {
    color: var(--cobalt);
  }

  .case-meta {
    padding-top: 0.4rem;
  }

  .case-meta dl {
    display: flex;
    flex-direction: column;
  }

  .case-meta dl > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--line-soft);
  }

  .case-meta dl > div:first-child {
    border-top: 1px solid var(--line);
  }

  .case-meta dt {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .case-meta dd {
    color: var(--charcoal);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .case-placeholder {
    margin-top: 1.25rem;
    color: var(--cobalt);
  }

  .case-hero-art {
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .case-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .case-metrics > div {
    padding: 1.35rem 1.25rem 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .case-metrics > div + div {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line-soft);
  }

  .case-metrics dt {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .case-metrics dd {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.85rem, 3.4vw, 2.9rem);
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .case-metric-note {
    display: block;
    margin-top: 0.5rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.03em;
    line-height: 1.45;
  }

  .case-body-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .case-aside {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .toc-label {
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--charcoal);
    color: var(--ink-muted);
  }

  .toc ol {
    display: flex;
    flex-direction: column;
  }

  .toc li {
    border-bottom: 1px solid var(--line-soft);
  }

  .toc a {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 0.55rem;
    color: var(--ink-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .toc a span {
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    line-height: 1.8;
  }

  .toc a:hover {
    color: var(--cobalt);
  }

  .toc a:hover span {
    color: var(--cobalt);
  }

  .aside-meta {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .aside-meta .mono {
    color: var(--ink-muted);
  }

  .aside-meta p:not(.mono) {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .aside-status {
    margin-top: 1rem;
    color: var(--cobalt) !important;
  }

  .case-content {
    min-width: 0;
  }

  .case-end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 2rem;
    max-width: 68ch;
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--charcoal);
  }

  .case-end .mono {
    color: var(--cobalt);
    white-space: nowrap;
  }

  .case-end > p:nth-child(2) {
    flex: 1;
    min-width: 14rem;
    color: var(--ink-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .case-top {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .case-top:hover {
    color: var(--cobalt);
  }

  .case-nav {
    border-top: 1px solid var(--line);
  }

  .case-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .case-nav-item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    min-width: 0;
    transition: background 0.25s ease;
  }

  .case-nav-item--prev {
    padding-right: 2rem;
    border-right: 1px solid var(--line);
  }

  .case-nav-item--next {
    align-items: flex-end;
    padding-left: 2rem;
    text-align: right;
  }

  .case-nav-item .mono {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-muted);
  }

  .case-nav-item .mono svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .case-nav-item strong {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .case-nav-item:hover strong {
    color: var(--cobalt);
  }

  .case-nav-index {
    position: absolute;
    top: 50%;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    transform: translateY(-50%);
  }

  .case-nav-item--prev .case-nav-index {
    right: 1.25rem;
  }

  .case-nav-item--next .case-nav-index {
    left: 1.25rem;
  }

  @media (max-width: 900px) {
    .case-title-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .case-meta dl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1.5rem;
    }

    .case-meta dl > div:nth-child(2) {
      border-top: 1px solid var(--line);
    }

    .case-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-metrics > div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .case-metrics > div:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .case-body-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .case-aside {
      position: static;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.6fr);
      gap: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--line);
    }

    .aside-meta {
      margin-top: 0;
    }
  }

  @media (max-width: 620px) {
    .case-title-block h1 {
      font-size: clamp(3rem, 15vw, 5rem);
    }

    .case-meta dl {
      grid-template-columns: 1fr;
    }

    .case-meta dl > div:nth-child(2) {
      border-top: 1px solid var(--line-soft);
    }

    .case-metrics {
      grid-template-columns: 1fr 1fr;
    }

    .case-metrics > div {
      padding-right: 0.75rem;
    }

    .case-aside {
      grid-template-columns: 1fr;
    }

    .toc {
      display: none;
    }

    .case-nav-grid {
      grid-template-columns: 1fr;
    }

    .case-nav-item--prev {
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .case-nav-item--next {
      align-items: flex-start;
      padding-left: 0;
      text-align: left;
    }

    .case-nav-index {
      position: static;
      transform: none;
    }
  }
</style>
