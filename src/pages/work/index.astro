---
import { getCollection } from 'astro:content';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectArtwork from '../../components/ProjectArtwork.astro';
import { site } from '../../config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const filters = [
  { key: 'all', label: 'All' },
  { key: 'ai', label: 'AI / ML' },
  { key: 'software', label: 'Software' },
  { key: 'hardware', label: 'Hardware' },
  { key: 'experiments', label: 'Experiments' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Work — Ishan Asati',
  description:
    'Projects, prototypes and experiments by Ishan Asati, spanning AI, software engineering, hardware and creative coding.',
  url: `${site.url}/work`,
};
---

<BaseLayout
  title="Work"
  description="Projects, prototypes and experiments by Ishan Asati — AI and machine learning, software engineering, hardware, and creative coding."
  schema={schema}
>
  <section class="page-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Index</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Work</li>
        </ol>
      </nav>

      <div class="head-grid">
        <div class="head-title">
          <p class="eyebrow">The index / {String(projects.length).padStart(2, '0')} entries</p>
          <h1>
            Work,<br />
            <em>in progress.</em>
          </h1>
        </div>
        <div class="head-note">
          <p>
            A complete record of the projects, prototypes and experiments currently in the
            index. Some are finished studies. Some are under active development. One is a
            placeholder for work that does not exist yet — and is labelled as such.
          </p>
          <div class="head-chips">
            <span class="chip chip--sage">Vol. 01</span>
            <span class="chip">{site.year}</span>
            <span class="chip">{site.location}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="work-index section--tight" aria-label="Projects and experiments">
    <div class="shell">
      <div class="filter-panel panel">
        <div class="filter-copy">
          <p class="eyebrow eyebrow--plain">Filter the record</p>
          <p class="filter-count" data-filter-count aria-live="polite">
            Showing {projects.length} of {projects.length} entries
          </p>
        </div>

        <div class="segmented" role="group" aria-label="Filter work by category">
          {filters.map((filter) => (
            <button
              type="button"
              data-filter={filter.key}
              aria-pressed={filter.key === 'all' ? 'true' : 'false'}
            >
              {filter.label}
            </button>
          ))}
        </div>
      </div>

      <noscript>
        <p class="noscript-note">
          Filters require JavaScript. All {projects.length} entries are listed below.
        </p>
      </noscript>

      <div class="project-grid" data-project-grid>
        {projects.map((project) => (
          <article
            class:list={['project-card', 'panel', `project-card--${project.data.cover}`]}
            data-category={project.data.filter}
          >
            <a class="card-art" href={`/work/${project.id}`}>
              <span class="sr-only">View {project.data.title}</span>
              <div aria-hidden="true"><ProjectArtwork kind={project.data.cover} /></div>
            </a>

            <div class="card-body">
              <div class="card-topline">
                <span class="index-number">{project.data.index}</span>
                <span class="chip">{project.data.category}</span>
                <span class="chip chip--accent card-status">{project.data.status}</span>
              </div>

              <h2><a href={`/work/${project.id}`}>{project.data.title}</a></h2>
              <p class="card-summary">{project.data.summary}</p>

              <div class="card-foot">
                <span class="mono card-year">{project.data.year}</span>
                <a class="card-link" href={`/work/${project.id}`}>
                  Open entry
                  <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="empty-filter panel" data-empty-filter hidden>
        <p class="mono">No entries in this category yet.</p>
        <button type="button" class="button" data-filter-reset>Show all entries</button>
      </div>
    </div>
  </section>

  <section class="work-foot section--tight">
    <div class="shell">
      <div class="work-foot-panel panel">
        <p class="eyebrow">A note on the record</p>
        <p class="work-foot-note">
          Projects are described at the stage they are actually in. Research work is marked
          as research. Unfinished software is marked as unfinished. Concepts are not
          presented as products. If an entry looks quiet, it is because the work is still
          being done.
        </p>
        <a class="button" href="/about">
          About the person behind the index
          <ArrowRight aria-hidden="true" stroke-width="1.6" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: 1.5rem clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.5625rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a {
    transition: color var(--motion-state) var(--ease);
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  .crumbs [aria-current] {
    color: var(--ink);
  }

  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.6fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .head-title h1 {
    margin-top: 1.15rem;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 8.5vw, 7.5rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  .head-title h1 em {
    color: var(--primary);
    font-style: normal;
  }

  .head-note {
    padding: clamp(1.1rem, 2vw, 1.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: none;
  }

  .head-note p {
    max-width: 42ch;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .head-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .filter-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding: clamp(0.85rem, 1.6vw, 1.1rem);
    background: var(--warm);
    box-shadow: none;
  }

  .filter-copy {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-left: 0.35rem;
  }

  .filter-count {
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 550;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .noscript-note {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.6vw, 1.25rem);
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.75rem;
    background: var(--paper);
    box-shadow: none;
    transition:
      border-color var(--motion-state) var(--ease),
      transform 300ms var(--ease);
  }

  .project-card:hover {
    border-color: var(--control-border);
    transform: translateY(-2px);
  }

  .project-card:nth-child(1) {
    grid-column: span 7;
  }

  .project-card:nth-child(2) {
    grid-column: span 5;
  }

  .project-card:nth-child(3),
  .project-card:nth-child(4),
  .project-card:nth-child(5) {
    grid-column: span 4;
  }

  .project-card:nth-child(6) {
    grid-column: span 7;
  }

  .project-card:nth-child(7) {
    grid-column: span 5;
  }

  .project-card[hidden] {
    display: none;
  }

  .card-art {
    display: block;
    overflow: hidden;
    border-radius: 14px;
    transition: transform 420ms var(--ease);
  }

  .card-art:hover {
    transform: translateY(-2px);
  }

  .card-art :global(.plate) {
    height: 100%;
    border-color: var(--line);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1rem, 2vw, 1.35rem) 0.4rem 0.35rem;
  }

  .card-topline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.85rem;
  }

  .card-status {
    margin-left: auto;
  }

  .card-body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.02;
  }

  .card-body h2 a {
    transition: color var(--motion-state) var(--ease);
  }

  .card-body h2 a:hover {
    color: var(--primary);
  }

  .card-summary {
    max-width: 52ch;
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.65;
  }

  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.1rem;
  }

  .card-year {
    color: var(--muted);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 650;
    line-height: 1.4;
    transition: color var(--motion-state) var(--ease);
  }

  .card-link svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--primary);
    transition: transform 220ms var(--ease);
  }

  .card-link:hover {
    color: var(--primary);
  }

  .card-link:hover svg {
    transform: translate(2px, -2px);
  }

  .empty-filter {
    margin-top: 1.5rem;
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .empty-filter .mono {
    color: var(--muted);
  }

  .empty-filter .button {
    margin-top: 1rem;
  }

  .work-foot {
    padding-top: 0;
  }

  .work-foot-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--warm);
    box-shadow: none;
  }

  .work-foot-note {
    max-width: 58ch;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  @media (max-width: 1000px) {
    .head-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .head-note {
      max-width: 640px;
    }

    .project-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .project-card:nth-child(1),
    .project-card:nth-child(2),
    .project-card:nth-child(3),
    .project-card:nth-child(4),
    .project-card:nth-child(5),
    .project-card:nth-child(6),
    .project-card:nth-child(7) {
      grid-column: span 3;
    }

    .work-foot-panel {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 700px) {
    .filter-panel {
      align-items: stretch;
    }

    .filter-copy {
      padding-left: 0;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .project-card:nth-child(1),
    .project-card:nth-child(2),
    .project-card:nth-child(3),
    .project-card:nth-child(4),
    .project-card:nth-child(5),
    .project-card:nth-child(6),
    .project-card:nth-child(7) {
      grid-column: 1 / -1;
    }

    .card-status {
      margin-left: 0;
    }

    .card-body h2 {
      font-size: clamp(1.75rem, 8vw, 2.3rem);
    }
  }
</style>

<script>
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-filter]'),
  );
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('[data-category]'),
  );
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty-filter]');
  const reset = document.querySelector<HTMLButtonElement>('[data-filter-reset]');

  const applyFilter = (filter: string) => {
    let visible = 0;

    cards.forEach((card) => {
      const match = filter === 'all' || card.dataset.category === filter;
      card.hidden = !match;
      if (match) visible += 1;
    });

    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
    });

    if (count) {
      count.textContent = `Showing ${visible} of ${cards.length} entries`;
    }

    if (empty) {
      empty.hidden = visible !== 0;
    }
  };

  const fromUrl = new URLSearchParams(window.location.search).get('filter');
  const valid = buttons.some((button) => button.dataset.filter === fromUrl);
  if (valid && fromUrl) applyFilter(fromUrl);

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      applyFilter(filter);

      const url = new URL(window.location.href);
      if (filter === 'all') {
        url.searchParams.delete('filter');
      } else {
        url.searchParams.set('filter', filter);
      }
      window.history.replaceState({}, '', url);
    });
  });

  reset?.addEventListener('click', () => {
    applyFilter('all');
    const url = new URL(window.location.href);
    url.searchParams.delete('filter');
    window.history.replaceState({}, '', url);
  });
</script>
