---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, socialLinks } from '../config';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact — Ishan Asati',
  url: `${site.url}/contact`,
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    email: `mailto:${site.email}`,
    url: site.url,
    sameAs: [site.github],
  },
};
---

<BaseLayout
  title="Contact"
  description="Contact Ishan Asati by email, or find him on GitHub. No forms, no funnels — just a direct line."
  schema={schema}
>
  <section class="contact-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Index</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">Contact</li>
        </ol>
      </nav>

      <div class="contact-title-grid">
        <div>
          <p class="eyebrow">Correspondence / Vol. 01</p>
          <h1>
            Say<br />
            <em>hello.</em>
          </h1>
        </div>

        <div class="contact-deck-panel panel">
          <p class="contact-deck">
            A question about a project, a correction, a useful pointer or a conversation
            worth having — email is the best place to start.
          </p>
          <div class="contact-chips">
            <span class="chip chip--sage">Direct email</span>
            <span class="chip">No form</span>
            <span class="chip">India / IST</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-body section" aria-labelledby="contact-options">
    <div class="shell contact-grid">
      <div class="contact-primary panel panel--accent">
        <h2 class="mono contact-label" id="contact-options">Primary</h2>
        <a class="email-link" href={`mailto:${site.email}`}>
          <span>{site.email}</span>
          <ArrowUpRight aria-hidden="true" stroke-width="1.4" />
        </a>
        <p class="contact-note">
          Email is a real inbox, read by a real person. There is no contact form because
          there is no backend and no desire to put a form between us.
        </p>
        <a class="button button--primary" href={`mailto:${site.email}`}>
          Write an email
          <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
        </a>
      </div>

      <div class="contact-secondary">
        <div class="contact-card panel">
          <h2 class="mono contact-label">Elsewhere</h2>
          <ul class="contact-links">
            {socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noreferrer noopener' : undefined}
                >
                  <span>{link.label}</span>
                  <span class="contact-link-detail">
                    {link.label === 'GitHub' ? 'github.com/IshanAsati' : 'Direct email'}
                  </span>
                  <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="contact-card panel panel--warm">
          <h3 class="mono contact-label">Based in</h3>
          <p class="contact-place">India</p>
          <p class="contact-timezone">IST / UTC+5:30</p>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-foot section--tight">
    <div class="shell">
      <div class="contact-foot-panel panel">
        <div>
          <p class="eyebrow">Before you write</p>
          <p class="contact-foot-note">
            I am a student, so my time is not always my own. I read everything that is not
            obviously automated, and I reply when I can.
          </p>
        </div>
        <p class="contact-foot-note">
          If you are asking about DermoAI, please remember that it is a research project,
          not a diagnostic service. I cannot offer medical advice or evaluate a skin image.
        </p>
        <a class="button" href="/work">
          While you're here, read the work
          <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-head {
    padding-block: var(--page-head-pad-top, clamp(5.5rem, 8.5vw, 7.5rem)) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a {
    transition: color var(--motion-state) var(--ease);
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  .crumbs [aria-current] {
    color: var(--ink);
  }

  .contact-title-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.55fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .contact-title-grid h1 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(5rem, 13vw, 11rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 0.82;
  }

  .contact-title-grid h1 em {
    color: var(--primary);
    font-style: normal;
  }

  .contact-deck-panel {
    padding: clamp(1.1rem, 2vw, 1.5rem);
    background: var(--warm);
    box-shadow: none;
  }

  .contact-deck {
    max-width: 38ch;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .contact-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.65fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .contact-primary {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: none;
  }

  .contact-label {
    color: var(--muted);
  }

  .email-link {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--primary-border);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4.5vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.05;
    overflow-wrap: anywhere;
    transition: color var(--motion-state) var(--ease);
  }

  .email-link:hover {
    color: var(--primary);
  }

  .email-link svg {
    width: clamp(1rem, 2vw, 1.5rem);
    height: clamp(1rem, 2vw, 1.5rem);
    flex: 0 0 auto;
    margin-top: 0.2rem;
    color: var(--primary);
  }

  .contact-note {
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .contact-primary .button {
    align-self: flex-start;
    margin-top: 1.35rem;
  }

  .contact-secondary {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.6vw, 1.1rem);
  }

  .contact-card {
    padding: clamp(1.1rem, 2vw, 1.4rem);
    background: var(--paper);
    box-shadow: none;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    margin-top: 0.55rem;
  }

  .contact-links li {
    border-bottom: 1px solid var(--line);
  }

  .contact-links li:last-child {
    border-bottom: 0;
  }

  .contact-links a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 52px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 650;
    transition: color var(--motion-state) var(--ease);
  }

  .contact-links a:hover {
    color: var(--primary);
  }

  .contact-link-detail {
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: right;
  }

  .contact-links svg {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--primary);
  }

  .contact-place {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .contact-timezone {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-foot-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--warm);
    box-shadow: none;
  }

  .contact-foot-note {
    max-width: 48ch;
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .contact-foot-note:first-of-type {
    margin-top: 0.35rem;
  }

  @media (max-width: 1000px) {
    .contact-title-grid,
    .contact-grid,
    .contact-foot-panel {
      grid-template-columns: 1fr;
    }

    .contact-deck-panel {
      max-width: 620px;
    }

    .contact-secondary {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .contact-foot-panel {
      gap: 1.25rem;
    }

    .contact-foot-panel .button {
      justify-self: start;
    }
  }

  @media (max-width: 700px) {
    .contact-title-grid h1 {
      font-size: clamp(4.5rem, 24vw, 7rem);
    }

    .contact-secondary {
      grid-template-columns: 1fr;
    }

    .email-link {
      font-size: clamp(1.05rem, 5.4vw, 1.5rem);
    }

    .contact-link-detail {
      display: none;
    }

    .contact-primary .button,
    .contact-foot-panel .button {
      width: 100%;
    }
  }
</style>
