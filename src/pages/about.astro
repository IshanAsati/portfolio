---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/ishan-avatar.jpg';
import { site } from '../config';

const facts = [
  { label: 'Status', value: 'Student' },
  { label: 'Based in', value: site.location },
  { label: 'Focus', value: 'Machine learning, software engineering, embedded systems' },
  { label: 'Best result', value: 'First place, DAV ML Khanna ML competition (DermoAI)' },
  { label: 'Code', value: 'github.com/IshanAsati', href: site.github },
  { label: 'Contact', value: site.email, href: `mailto:${site.email}` },
];

const interests = [
  { number: '01', title: 'Artificial intelligence', note: 'Computer vision, deep learning, local models.', status: 'In use' },
  { number: '02', title: 'Software engineering', note: 'TypeScript, React, local-first apps.', status: 'In use' },
  { number: '03', title: 'Hardware & robotics', note: 'ESP32, sensors, displays.', status: 'Exploring' },
  { number: '04', title: 'Systems & open source', note: 'Linux, tooling, how software meets the machine.', status: 'Exploring' },
  { number: '05', title: 'Creative programming', note: 'Python and Pygame experiments.', status: 'Exploring' },
];
const usedInProjects = [
  'Python',
  'PyTorch',
  'TypeScript',
  'React',
  'Vite',
  'Tailwind CSS',
  'shadcn/ui',
  'Dexie / IndexedDB',
  'ESP32',
  'Sensors & displays',
];

const alsoUsing = [
  'HTML & CSS',
  'Astro',
  'Git & GitHub',
  'Linux / WSL',
  'VS Code',
  'Command-line tools',
];

const learning = [
  'Systems programming',
  'Local AI models',
  'Pygame & game loops',
  'Computer-vision evaluation',
  'Embedded systems',
  'Software architecture',
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Ishan Asati',
  url: `${site.url}/about`,
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
    description: site.description,
    sameAs: [site.github],
  },
};
---

<BaseLayout
  title="About"
  description="Ishan Asati is a student, developer and maker in India, interested in artificial intelligence, software engineering, embedded systems and learning by building."
  schema={schema}
>
  <section class="about-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Index</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">About</li>
        </ol>
      </nav>

      <div class="head-grid">
        <div class="head-copy">
          <p class="eyebrow">The longer version / Vol. 01</p>
          <h1>
            A student with<br />
            a wide <em>syllabus.</em>
          </h1>
          <p class="head-lede">
            I am Ishan Asati, a student in India. I build machine-learning, software and
            hardware projects, and label each at its real stage.
          </p>
          <div class="head-chips">
            <span class="chip chip--sage">India</span>
            <span class="chip">Student</span>
            <span class="chip">Building in public</span>
          </div>
        </div>

        <figure class="about-portrait panel">
          <Image
            src={portrait}
            alt="Portrait of Ishan Asati"
            widths={[320, 480, 640]}
            sizes="(max-width: 900px) 78vw, 380px"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            <span>Ishan Asati</span>
            <span>{site.location}, {site.year}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="bio section" aria-labelledby="bio-title">
    <div class="shell bio-grid">
      <div class="bio-side">
        <p class="eyebrow">01 / Background</p>
        <h2 class="bio-title" id="bio-title">
          The facts,<br />
          <em>briefly.</em>
        </h2>
      </div>

      <div class="bio-body">
        <dl class="facts panel">
          {facts.map((fact) => (
            <div class="fact">
              <dt>{fact.label}</dt>
              <dd>
                {fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}
              </dd>
            </div>
          ))}
        </dl>
        <p class="bio-lede">
          I learn by building things slightly beyond me, then reading, breaking and
          revising. I am early in that process, and the site says so.
        </p>
      </div>
    </div>
  </section>

  <section class="interests section" aria-labelledby="interests-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="eyebrow">02 / Fields of interest</p>
          <h2 id="interests-title">
            Five directions,<br />
            one <em>curiosity.</em>
          </h2>
        </div>
        <p class="section-note">
          <span>In use</span>: appears in a project here. <span>Exploring</span>: still learning.
        </p>
      </header>

      <ol class="interest-list panel">
        {interests.map((interest) => (
          <li class="interest-row">
            <span class="interest-number">{interest.number}</span>
            <div class="interest-body">
              <h3>{interest.title}</h3>
              <p>{interest.note}</p>
            </div>
            <span class:list={['chip', interest.status === 'In use' ? 'chip--sage' : '']}>
              {interest.status}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="toolkit-section section" aria-labelledby="toolkit-title">
    <div class="shell">
      <header class="section-head">
        <div>
          <p class="eyebrow">03 / A working inventory</p>
          <h2 id="toolkit-title">
            Tools, not<br />
            <em>trophies.</em>
          </h2>
        </div>
        <p class="section-note">Listed because I have used it or am learning it.</p>
      </header>

      <div class="toolkit-grid">
        <div class="toolkit-column panel">
          <p class="mono toolkit-label">Used in projects</p>
          <ul>
            {usedInProjects.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>

        <div class="toolkit-column panel">
          <p class="mono toolkit-label">Also working with</p>
          <ul>
            {alsoUsing.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>

        <div class="toolkit-column panel">
          <p class="mono toolkit-label">Currently learning</p>
          <ul>
            {learning.map((tool) => <li>{tool}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="credentials section--tight">
    <div class="shell">
      <div class="credentials-panel panel panel--accent">
        <p class="mono">A note on credentials</p>
        <p class="credentials-note">
          I am a student with no industry experience yet. This site shows real work at its
          real stage: research as research, software still in development, hardware still on
          the bench.
        </p>
      </div>
    </div>
  </section>

  <section class="contact-strip section--tight">
    <div class="shell contact-panel panel">
      <div>
        <p class="eyebrow">04 / Continue</p>
        <h2>Say hello, or<br /><em>read the work.</em></h2>
      </div>
      <div class="contact-actions">
        <a class="button button--primary" href="/contact">
          Say hello
          <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
        </a>
        <a class="button" href="/#work">
          Read the work
          <ArrowRight aria-hidden="true" stroke-width="1.6" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-head {
    padding-block: var(--page-head-pad-top, clamp(5.5rem, 8.5vw, 7.5rem)) clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a {
    display: inline-block;
    padding-block: 0.4rem;
    transition: color var(--motion-state) var(--ease);
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  .crumbs [aria-current] {
    color: var(--ink);
  }

  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.5fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .head-copy h1 {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7.5vw, 6.75rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.95;
  }

  .head-copy h1 em {
    color: var(--primary);
    font-style: normal;
  }

  .head-lede {
    max-width: 52ch;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: clamp(1.25rem, 1.8vw, 1.45rem);
    line-height: 1.7;
  }

  .head-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .about-portrait {
    overflow: hidden;
    padding: 0.6rem;
    background: var(--warm);
    box-shadow: none;
  }

  .about-portrait :global(img) {
    width: 100%;
    border-radius: 2px;
    filter: saturate(0.9);
  }

  .about-portrait figcaption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0.35rem 0.25rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .bio-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .bio-side {
    position: sticky;
    top: 7.5rem;
  }

  .bio-title,
  .section-head h2,
  .contact-panel h2 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4.4vw, 3.9rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.02;
  }

  .bio-title em,
  .section-head h2 em,
  .contact-panel h2 em {
    color: var(--primary);
    font-style: normal;
  }

  .bio-lede {
    max-width: 56ch;
    color: var(--ink);
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    line-height: 1.65;
  }

  .facts {
    padding: 0.25rem clamp(1rem, 2vw, 1.5rem);
    background: var(--warm);
    box-shadow: none;
  }

  .fact {
    display: grid;
    grid-template-columns: minmax(6rem, 0.3fr) minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .fact:last-child {
    border-bottom: 0;
  }

  .fact dt {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .fact dd {
    color: var(--ink);
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .fact a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.2em;
    transition: color var(--motion-state) var(--ease);
  }

  .fact a:hover {
    color: var(--primary);
  }

  .bio-lede {
    margin-top: 1.5rem;
  }
  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.55fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-note {
    max-width: 46ch;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .section-note span {
    color: var(--ink);
    font-weight: 650;
  }

  .interest-list {
    padding: 0.35rem clamp(1rem, 2vw, 1.5rem);
    background: var(--warm);
    box-shadow: none;
  }

  .interest-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .interest-row:last-child {
    border-bottom: 0;
  }

  .interest-number {
    color: var(--primary);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .interest-body h3 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.3;
  }

  .interest-body p {
    max-width: 60ch;
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .toolkit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.1rem);
  }

  .toolkit-column {
    padding: 1.1rem 1.2rem;
    background: var(--warm);
    box-shadow: none;
  }

  .toolkit-label {
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .toolkit-column ul {
    display: flex;
    flex-direction: column;
    margin-top: 0.35rem;
  }

  .toolkit-column li {
    padding-block: 0.45rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 1.05rem;
    font-weight: 550;
    line-height: 1.5;
  }

  .toolkit-column li:last-child {
    border-bottom: 0;
  }

  .credentials-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.35fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: none;
  }

  .credentials-panel .mono {
    color: var(--primary);
  }

  .credentials-note {
    max-width: 70ch;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: var(--warm);
    box-shadow: none;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (max-width: 1000px) {
    .head-grid,
    .bio-grid,
    .section-head,
    .credentials-panel,
    .contact-panel {
      grid-template-columns: 1fr;
    }

    .about-portrait {
      max-width: 420px;
    }

    .bio-side {
      position: static;
    }

    .toolkit-grid {
      grid-template-columns: 1fr;
    }

    .section-head {
      gap: 1.5rem;
    }

    .contact-actions {
      justify-self: start;
    }
  }

  @media (max-width: 700px) {
    .head-copy h1 {
      font-size: clamp(2.9rem, 14vw, 4.2rem);
    }

    .fact {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .interest-row {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      gap: 0.75rem;
      padding-block: 1rem;
    }

    .interest-row .chip {
      grid-column: 2;
      justify-self: start;
    }

    .contact-actions .button {
      flex: 1 1 auto;
    }
  }
</style>
