---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import portrait from '../assets/ishan-avatar.jpg';
import { site } from '../config';

const interests = [
  {
    number: '01',
    title: 'Artificial intelligence',
    note: 'Machine learning, deep learning, computer vision, neural network architectures and local AI experimentation.',
    status: 'In use',
  },
  {
    number: '02',
    title: 'Software engineering',
    note: 'Application development, architecture, TypeScript, React and the practice of making software maintainable.',
    status: 'In use',
  },
  {
    number: '03',
    title: 'Hardware & robotics',
    note: 'Embedded systems, microcontrollers, sensors and the point where code has to survive the physical world.',
    status: 'Exploring',
  },
  {
    number: '04',
    title: 'Systems & open source',
    note: 'Linux, operating systems, development environments and how software actually meets the machine.',
    status: 'Exploring',
  },
  {
    number: '05',
    title: 'Creative programming',
    note: 'Python, Pygame and interactive experiments made for curiosity rather than a product roadmap.',
    status: 'Exploring',
  },
];

const principles = [
  {
    number: '01',
    title: 'Build to understand',
    note: 'Reading about a system is useful. Building one, watching it fail and fixing it is what makes the knowledge stay.',
  },
  {
    number: '02',
    title: 'Keep the loop short',
    note: 'Small, finished experiments teach more than large, abandoned ones. Scope is a design decision, not an apology.',
  },
  {
    number: '03',
    title: 'Document honestly',
    note: 'A result is more useful when its limits travel with it. I would rather show an unfinished thing clearly than a finished-looking thing falsely.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Ishan Asati',
  url: `${site.url}/about`,
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    url: site.url,
    description: site.description,
    sameAs: [site.github],
  },
};
---

<BaseLayout
  title="About"
  description="Ishan Asati is a student, developer and maker in India, interested in artificial intelligence, software engineering, embedded systems and learning by building."
  schema={schema}
>
  <section class="about-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Index</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page">About</li>
        </ol>
      </nav>

      <div class="head-grid">
        <div class="head-copy">
          <p class="eyebrow">The longer version / Vol. 01</p>
          <h1>
            A student<br />
            with a wide<br />
            <em>syllabus.</em>
          </h1>
          <p class="head-lede">
            I am Ishan Asati — a student, developer and maker based in India. I am interested
            in how technology works, and in turning that curiosity into things that run.
          </p>
        </div>

        <figure class="about-portrait">
          <div class="about-portrait-frame">
            <Image
              src={portrait}
              alt="Portrait of Ishan Asati"
              widths={[320, 480, 640]}
              sizes="(max-width: 900px) 70vw, 360px"
              loading="eager"
            />
            <span class="portrait-index" aria-hidden="true">IA / 26</span>
          </div>
          <figcaption>
            <span>Ishan Asati</span>
            <span>India, {site.year}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="bio section" aria-labelledby="bio-title">
    <div class="shell bio-grid">
      <div class="bio-side">
        <p class="eyebrow">01 / The short story</p>
        <h2 class="bio-title" id="bio-title">Not one<br />discipline.</h2>
      </div>
      <div class="bio-body">
        <p class="bio-lede">
          I am more interested in understanding systems deeply than in collecting
          achievements. That has taken me across software, machine learning, electronics and
          the spaces in between.
        </p>
        <div class="bio-columns">
          <p>
            My interests span artificial intelligence and computer vision, application
            development, Python, robotics and embedded systems, Linux and open-source
            software, and small creative experiments. I do not treat these as separate
            identities. They are different angles on the same question: how does this work,
            and what can I make with it?
          </p>
          <p>
            I learn best through projects. Most of what I know has arrived by building
            something slightly beyond me at the start — then reading, breaking it, and
            trying again. I am still early in that process. That is the honest position, and
            it is also the interesting one.
          </p>
        </div>
        <blockquote class="bio-quote">
          <p>
            “My interests rarely stay in one place, and that's exactly how I like it.”
          </p>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="interests section" aria-labelledby="interests-title">
    <div class="shell">
      <header class="interests-head">
        <div>
          <p class="eyebrow">02 / Fields of interest</p>
          <h2 class="interests-title" id="interests-title">
            Five directions,<br />one <em>curiosity.</em>
          </h2>
        </div>
        <p class="interests-note">
          <span>In use</span> means the field appears in a project on this site.
          <span>Exploring</span> means I am actively learning, without claiming mastery.
          There are no percentages here because proficiency is not a progress bar.
        </p>
      </header>

      <ol class="interest-list">
        {interests.map((interest) => (
          <li class="interest-row">
            <span class="interest-number">{interest.number}</span>
            <h3>{interest.title}</h3>
            <p>{interest.note}</p>
            <span class:list={['interest-status', interest.status === 'In use' ? 'is-active' : '']}>
              {interest.status}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="toolkit-section stone-section section" aria-labelledby="toolkit-title">
    <div class="shell">
      <header class="toolkit-head">
        <p class="eyebrow">03 / A working inventory</p>
        <h2 class="toolkit-title" id="toolkit-title">
          Tools, not<br /><em>trophies.</em>
        </h2>
      </header>

      <div class="toolkit-grid">
        <div class="toolkit-column">
          <p class="mono toolkit-label">Used in projects</p>
          <ul>
            <li>Python</li>
            <li>PyTorch</li>
            <li>TypeScript</li>
            <li>React</li>
            <li>Vite</li>
            <li>Tailwind CSS</li>
            <li>shadcn/ui</li>
            <li>Dexie / IndexedDB</li>
            <li>ESP32</li>
            <li>Sensors & displays</li>
          </ul>
        </div>

        <div class="toolkit-column">
          <p class="mono toolkit-label">Also working with</p>
          <ul>
            <li>HTML & CSS</li>
            <li>Astro</li>
            <li>Git & GitHub</li>
            <li>Linux / WSL</li>
            <li>VS Code</li>
            <li>Command-line tools</li>
          </ul>
        </div>

        <div class="toolkit-column">
          <p class="mono toolkit-label">Currently learning</p>
          <ul>
            <li>Systems programming</li>
            <li>Local AI models</li>
            <li>Pygame & game loops</li>
            <li>Computer-vision evaluation</li>
            <li>Embedded systems</li>
            <li>Software architecture</li>
          </ul>
        </div>
      </div>

      <p class="toolkit-note">
        This is a living inventory. A tool appears here because I have used it in something,
        or because I am spending time with it — not because it belongs on a résumé keyword
        list.
      </p>
    </div>
  </section>

  <section class="principles section" aria-labelledby="principles-title">
    <div class="shell principles-grid">
      <div class="principles-head">
        <p class="eyebrow">04 / How I work</p>
        <h2 class="principles-title" id="principles-title">
          Three<br /><em>habits.</em>
        </h2>
        <p class="principles-note">
          Not a manifesto. Just the working rules I keep returning to.
        </p>
      </div>

      <ol class="principle-list">
        {principles.map((principle) => (
          <li>
            <span class="principle-number">{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="credentials">
    <div class="shell credentials-grid">
      <p class="mono">A note on credentials</p>
      <p class="credentials-note">
        I am a student. I do not have years of industry experience, a list of publications or
        a company to my name, and this site does not pretend otherwise. What it documents is
        real work at its real stage: research that is research, software that is still being
        built, and hardware that is still on the bench.
      </p>
    </div>
  </section>

  <section class="contact-strip section--tight">
    <div class="shell contact-grid">
      <p class="eyebrow">05 / Continue</p>
      <a class="contact-link" href="/contact">
        Say hello
        <ArrowUpRight aria-hidden="true" stroke-width="1.25" />
      </a>
      <ArrowLink href="/work" label="Or read the work" />
    </div>
  </section>
</BaseLayout>

<style>
  .about-head {
    padding-top: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .crumbs {
    padding-bottom: 1.5rem;
  }

  .crumbs ol {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .crumbs a:hover {
    color: var(--cobalt);
  }

  .crumbs [aria-current] {
    color: var(--charcoal);
  }

  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: clamp(1.5rem, 3vw, 2rem) clamp(3rem, 6vw, 5rem);
  }

  .head-copy h1 {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(3.75rem, 8.5vw, 7.5rem);
    letter-spacing: -0.055em;
    line-height: 0.86;
  }

  .head-copy h1 em {
    color: var(--cobalt);
  }

  .head-lede {
    max-width: 42ch;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .about-portrait {
    width: min(100%, 22rem);
    justify-self: end;
  }

  .about-portrait-frame {
    position: relative;
    padding: 0.55rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .about-portrait-frame :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 28%;
    filter: grayscale(1) contrast(1.04) brightness(1.02);
  }

  .about-portrait-frame::after {
    content: "";
    position: absolute;
    inset: 0.55rem;
    pointer-events: none;
    background: var(--cobalt);
    mix-blend-mode: multiply;
    opacity: 0.13;
  }

  .portrait-index {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 1;
    color: var(--ivory);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-shadow: 0 1px 8px rgba(37, 37, 37, 0.4);
  }

  .about-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.65rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .bio-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .bio-title {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 5.4vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .bio-lede {
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2.5vw, 2.1rem);
    letter-spacing: -0.025em;
    line-height: 1.25;
    color: var(--charcoal);
  }

  .bio-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .bio-quote {
    margin-top: 2.5rem;
    padding: 1.4rem 0 1.4rem 1.5rem;
    border-left: 1px solid var(--cobalt);
  }

  .bio-quote p {
    max-width: 30ch;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    letter-spacing: -0.025em;
    line-height: 1.16;
  }

  .interests {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .interests-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .interests-title {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 5.6vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .interests-title em {
    color: var(--cobalt);
  }

  .interests-note {
    max-width: 40ch;
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .interests-note span {
    color: var(--charcoal);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .interest-list {
    border-top: 1px solid var(--charcoal);
  }

  .interest-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1.2fr) auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }

  .interest-number {
    color: var(--cobalt);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
  }

  .interest-row h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.6vw, 2.15rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .interest-row p {
    color: var(--ink-muted);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .interest-status {
    padding-left: 1rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .interest-status.is-active {
    color: var(--cobalt);
  }

  .interest-status.is-active::before {
    content: "";
    display: inline-block;
    width: 0.35rem;
    height: 0.35rem;
    margin-right: 0.4rem;
    background: var(--cobalt);
    vertical-align: 0.08em;
  }

  .toolkit-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .toolkit-title {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 5.4vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .toolkit-title em {
    color: var(--cobalt);
  }

  .toolkit-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    border-top: 1px solid var(--charcoal);
  }

  .toolkit-column {
    padding-top: 1.25rem;
  }

  .toolkit-label {
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .toolkit-column ul {
    display: flex;
    flex-direction: column;
  }

  .toolkit-column li {
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line-soft);
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .toolkit-note {
    max-width: 62ch;
    margin-top: 2rem;
    color: var(--ink-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 6rem);
  }

  .principles-title {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 5.4vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .principles-title em {
    color: var(--cobalt);
  }

  .principles-note {
    max-width: 28ch;
    margin-top: 1.5rem;
    color: var(--ink-muted);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .principle-list {
    border-top: 1px solid var(--charcoal);
  }

  .principle-list li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.35rem 1rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--line);
  }

  .principle-number {
    grid-row: span 2;
    color: var(--cobalt);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    line-height: 1.7;
  }

  .principle-list h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .principle-list p {
    max-width: 52ch;
    color: var(--ink-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .credentials {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .credentials-grid .mono {
    color: var(--ink-muted);
  }

  .credentials-note {
    max-width: 60ch;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    justify-self: start;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 1;
    transition: color 0.25s ease;
  }

  .contact-link svg {
    width: clamp(1rem, 2vw, 1.4rem);
    height: clamp(1rem, 2vw, 1.4rem);
    color: var(--cobalt);
    transition: transform 0.35s var(--ease-out);
  }

  .contact-link:hover {
    color: var(--cobalt);
  }

  .contact-link:hover svg {
    transform: translate(0.2rem, -0.2rem);
  }

  @media (max-width: 900px) {
    .head-grid,
    .bio-grid,
    .principles-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .about-portrait {
      justify-self: start;
      width: min(70%, 18rem);
    }

    .bio-columns {
      grid-template-columns: 1fr;
    }

    .interests-head {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .interest-row {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }

    .interest-row p {
      grid-column: 2 / 4;
    }

    .toolkit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  @media (max-width: 620px) {
    .head-copy h1 {
      font-size: clamp(3.25rem, 15vw, 5rem);
    }

    .toolkit-grid {
      grid-template-columns: 1fr;
    }

    .toolkit-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .interest-row {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .interest-status {
      grid-column: 2;
      padding-left: 0;
    }

    .interest-row p {
      grid-column: 2;
    }

    .credentials-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
