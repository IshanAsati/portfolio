---
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page is not in the index. Return to the portfolio of Ishan Asati."
  noindex={true}
>
  <section class="not-found">
    <div class="shell not-found-grid">
      <div class="not-found-folio panel" aria-hidden="true">
        <span>404</span>
        <p class="mono">Not in the index</p>
      </div>

      <div class="not-found-copy">
        <p class="eyebrow">A missing page</p>
        <h1>
          This page is<br />
          <em>not in the index.</em>
        </h1>
        <p class="not-found-note">
          The address may be wrong, the page may have moved, or the work it described may
          never have been published. All three are possible.
        </p>

        <div class="not-found-links">
          <a class="button button--primary" href="/">
            <ArrowLeft aria-hidden="true" stroke-width="1.6" />
            Return to the index
          </a>
          <a class="button" href="/work">
            Browse the work
            <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
          </a>
        </div>

        <div class="not-found-foot">
          <p class="mono">ishan.asati / Vol. 01</p>
          <p class="mono">Nothing here — which is also a kind of answer.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: calc(100svh - 5.5rem);
    padding-block: var(--page-head-pad-top, clamp(5.5rem, 8.5vw, 7.5rem)) clamp(2.5rem, 6vw, 5rem);
    border-bottom: 1px solid var(--border);
  }

  .not-found-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.68fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .not-found-folio {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    aspect-ratio: 1;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--primary) 12%, transparent), transparent 55%),
      var(--warm);
    box-shadow: none;
  }

  .not-found-folio span {
    color: var(--primary);
    font-family: var(--font-display);
    font-size: clamp(6rem, 17vw, 12rem);
    font-weight: 500;
    letter-spacing: -0.09em;
    line-height: 0.8;
  }

  .not-found-folio .mono {
    color: var(--muted);
  }

  .not-found-copy h1 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.98;
  }

  .not-found-copy h1 em {
    color: var(--primary);
    font-style: normal;
  }

  .not-found-note {
    max-width: 46ch;
    margin-top: 1.35rem;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.7;
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .not-found-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }

  .not-found-foot .mono {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .not-found-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .not-found-folio {
      max-width: 360px;
      aspect-ratio: 16 / 9;
    }

    .not-found-folio span {
      font-size: clamp(5rem, 20vw, 8rem);
    }
  }

  @media (max-width: 700px) {
    .not-found-links .button {
      width: 100%;
    }

    .not-found-foot {
      flex-direction: column;
    }
  }
</style>
