---
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="This page is not in the index. Return to the portfolio of Ishan Asati."
  noindex={true}
>
  <section class="not-found">
    <div class="shell not-found-inner">
      <div class="not-found-meta">
        <span>Error 404</span>
        <span>Not in the index</span>
      </div>

      <div class="not-found-main">
        <p class="not-found-folio" aria-hidden="true">404</p>
        <div class="not-found-copy">
          <p class="eyebrow">A missing page</p>
          <h1>This page is<br /><em>not in the index.</em></h1>
          <p>
            The address may be wrong, the page may have moved, or the work it described may
            never have been published. All three are possible.
          </p>
          <div class="not-found-links">
            <a class="not-found-primary" href="/">
              <ArrowLeft aria-hidden="true" stroke-width="1.5" />
              Return to the index
            </a>
            <a class="not-found-secondary" href="/work">
              Browse the work
              <ArrowUpRight aria-hidden="true" stroke-width="1.5" />
            </a>
          </div>
        </div>
      </div>

      <div class="not-found-foot">
        <p class="mono">ishan.asati / Vol. 01</p>
        <p class="mono">Nothing here — which is also a kind of answer.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    background:
      repeating-linear-gradient(90deg, transparent 0, transparent 99px, var(--line-soft) 100px),
      var(--ivory);
    border-bottom: 1px solid var(--line);
  }

  .not-found-inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: calc(100svh - 5.1rem);
    padding-block: 1.4rem 1.75rem;
  }

  .not-found-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.07em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .not-found-main {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    flex: 1;
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .not-found-folio {
    font-family: var(--font-serif);
    font-size: clamp(7rem, 22vw, 18rem);
    letter-spacing: -0.075em;
    line-height: 0.7;
    color: var(--stone);
  }

  .not-found-copy h1 {
    margin-top: 1.25rem;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .not-found-copy h1 em {
    color: var(--cobalt);
  }

  .not-found-copy > p:not(.eyebrow) {
    max-width: 42ch;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .not-found-primary,
  .not-found-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
    transition: color 0.2s ease;
  }

  .not-found-primary svg,
  .not-found-secondary svg {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 0.3s var(--ease-out);
  }

  .not-found-primary {
    color: var(--charcoal);
  }

  .not-found-primary svg {
    color: var(--cobalt);
  }

  .not-found-secondary {
    color: var(--ink-muted);
  }

  .not-found-secondary svg {
    color: var(--cobalt);
  }

  .not-found-primary:hover,
  .not-found-secondary:hover {
    color: var(--cobalt);
  }

  .not-found-primary:hover svg {
    transform: translateX(-0.2rem);
  }

  .not-found-secondary:hover svg {
    transform: translate(0.15rem, -0.15rem);
  }

  .not-found-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .not-found-inner {
      min-height: auto;
    }

    .not-found-main {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .not-found-folio {
      font-size: clamp(6rem, 30vw, 10rem);
    }
  }

  @media (max-width: 560px) {
    .not-found-foot {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
