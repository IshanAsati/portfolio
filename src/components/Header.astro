---
import { ArrowUpRight, LayoutGrid, Menu, NotebookPen, UserRound, X } from '@lucide/astro';
import { navigation, site, socialLinks } from '../config';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) => {
  if (href === '/work') return currentPath === '/work' || currentPath.startsWith('/work/');
  return currentPath === href;
};

const icons = {
  Work: LayoutGrid,
  About: UserRound,
  Notes: NotebookPen,
} as const;
---

<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M12 2.6c.7 4.6 4.1 8 8.7 8.7-4.6.7-8 4.1-8.7 8.7-.7-4.6-4.1-8-8.7-8.7 4.6-.7 8-4.1 8.7-8.7Z" fill="currentColor"/>
        </svg>
      </span>
      <span class="brand-name">ishan.asati<span class="brand-dot">.</span></span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      {navigation.map((item) => {
        const Icon = icons[item.label as keyof typeof icons] ?? LayoutGrid;
        return (
          <a
            class:list={['nav-item', { 'is-active': isActive(item.href) }]}
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <Icon aria-hidden="true" stroke-width="1.6" />
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <div class="header-end">
      <a class="header-contact" href="/contact">
        <span>Contact</span>
        <ArrowUpRight aria-hidden="true" stroke-width="1.6" />
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-label="Open menu"
        aria-haspopup="dialog"
        data-menu-open
      >
        <Menu aria-hidden="true" stroke-width="1.6" />
      </button>
    </div>
  </div>

  <nav class="header-fallback" aria-label="Mobile navigation">
    <div class="shell header-fallback-inner">
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href="/contact">Contact</a>
    </div>
  </nav>
</header>

<dialog class="menu-dialog" aria-label="Site menu" data-menu-dialog>
  <div class="menu-inner shell">
    <div class="menu-top">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 2.6c.7 4.6 4.1 8 8.7 8.7-4.6.7-8 4.1-8.7 8.7-.7-4.6-4.1-8-8.7-8.7 4.6-.7 8-4.1 8.7-8.7Z" fill="currentColor"/>
          </svg>
        </span>
        <span class="brand-name">ishan.asati<span class="brand-dot">.</span></span>
      </a>
      <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>
        <X aria-hidden="true" stroke-width="1.6" />
      </button>
    </div>

    <nav class="menu-nav" aria-label="Mobile navigation">
      {navigation.map((item, i) => (
        <a
          class:list={['menu-link', { 'is-active': isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="menu-index">0{i + 1}</span>
          <span class="menu-label">{item.label}</span>
          <ArrowUpRight aria-hidden="true" stroke-width="1.4" />
        </a>
      ))}
      <a class:list={['menu-link', { 'is-active': currentPath === '/contact' }]} href="/contact">
        <span class="menu-index">04</span>
        <span class="menu-label">Contact</span>
        <ArrowUpRight aria-hidden="true" stroke-width="1.4" />
      </a>
    </nav>

    <div class="menu-foot">
      <div class="menu-socials">
        {socialLinks.map((link) => (
          <a
            class="menu-social"
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer noopener' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
      <p class="mono">{site.location} / {site.year}</p>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 72%, transparent);
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(190px, 1fr) auto minmax(190px, 1fr);
    align-items: center;
    min-height: 5.5rem;
    gap: 1.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    justify-self: start;
    min-height: 44px;
    line-height: 1;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: var(--primary);
    transition: transform 280ms var(--ease);
  }

  .brand-mark svg {
    width: 24px;
    height: 24px;
  }

  .brand:hover .brand-mark {
    transform: rotate(45deg);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .brand-dot {
    color: var(--primary);
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    box-shadow: 0 7px 18px #0000002e;
  }

  .nav-item {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid transparent;
    border-radius: 11px;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1;
    transition: color var(--motion-state) var(--ease), border-color var(--motion-state) var(--ease);
  }

  .nav-item::before {
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, var(--primary-dark), var(--primary) 58%, var(--control-highlight));
    content: "";
    opacity: 0;
    transform: scale(.92);
    transition: opacity 190ms var(--ease), transform 260ms cubic-bezier(.16, 1, .3, 1);
  }

  .nav-item:hover {
    border-color: color-mix(in srgb, var(--primary) 22%, var(--border));
    color: var(--ink);
  }

  .nav-item:hover::before {
    opacity: .1;
    transform: scale(1);
  }

  .nav-item.is-active {
    border-color: var(--primary-border);
    color: var(--on-primary);
  }

  .nav-item.is-active::before {
    opacity: 1;
    transform: scale(1);
  }

  .nav-item > svg,
  .nav-item > span {
    position: relative;
    z-index: 1;
  }

  .nav-item svg {
    width: 15px;
    height: 15px;
    transition: transform var(--motion-press) var(--ease);
  }

  .nav-item:hover svg {
    transform: translateY(-1px);
  }

  .header-end {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 0.7rem;
  }

  .header-contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--control-border);
    border-radius: 100px;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 650;
    transition: background-color var(--motion-state) var(--ease), border-color var(--motion-state) var(--ease), color var(--motion-state) var(--ease);
  }

  .header-contact svg {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--primary);
    transition: transform 220ms var(--ease);
  }

  .header-contact:hover {
    border-color: var(--primary);
    background: var(--primary-soft);
    color: var(--primary);
  }

  .header-contact:hover svg {
    transform: translate(2px, -2px);
  }

  .menu-toggle,
  .menu-close {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .menu-toggle:hover,
  .menu-close:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .menu-toggle svg,
  .menu-close svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .header-fallback {
    display: none;
  }

  .header-fallback-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.35rem;
    padding-block: 0.8rem;
  }

  .header-fallback a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--muted);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .header-fallback a:hover {
    color: var(--primary);
  }

  .menu-dialog {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--surface);
    color: var(--ink);
  }

  .menu-dialog[open] {
    display: flex;
    animation: menu-in 0.35s var(--ease-out) both;
  }

  .menu-dialog::backdrop {
    background: var(--surface);
  }

  .menu-dialog :focus-visible {
    outline-color: var(--primary);
  }

  .menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: 1.4rem 1.9rem;
  }

  .menu-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--border);
  }

  .menu-close {
    display: inline-flex;
  }

  .menu-nav {
    display: flex;
    flex-direction: column;
    margin-block: auto;
    padding-block: 2rem;
  }

  .menu-link {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 0.9rem;
    min-height: 4.75rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  .menu-link:first-child {
    border-top: 1px solid var(--line);
  }

  .menu-index {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .menu-label {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 10vw, 4.25rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .menu-link svg {
    width: clamp(1.1rem, 4vw, 1.5rem);
    height: clamp(1.1rem, 4vw, 1.5rem);
    color: var(--primary);
    opacity: 0;
    transform: translate(-0.3rem, 0.3rem);
    transition: opacity 0.25s ease, transform 0.35s var(--ease-out);
  }

  .menu-link:hover .menu-label,
  .menu-link.is-active .menu-label {
    color: var(--primary);
  }

  .menu-link:hover svg,
  .menu-link.is-active svg {
    opacity: 1;
    transform: translate(0, 0);
  }

  .menu-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .menu-socials {
    display: flex;
    gap: 0.6rem;
  }

  .menu-social {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 13px;
    border: 1px solid var(--border);
    border-radius: 100px;
    color: var(--muted);
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .menu-social:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .menu-foot p {
    color: var(--muted);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.75rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: 4.5rem;
      gap: 1rem;
    }

    .primary-nav,
    .header-contact {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    :global(html:not(.js)) .header-fallback {
      display: block;
      border-top: 1px solid var(--border);
    }

    :global(html:not(.js)) .menu-toggle {
      display: none;
    }
  }

  @media (max-width: 430px) {
    .menu-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.9rem;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu-dialog]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (dialog && openButton) {
    const lockScroll = () => {
      document.documentElement.classList.add('menu-open');
    };

    const unlockScroll = () => {
      document.documentElement.classList.remove('menu-open');
    };

    openButton.addEventListener('click', () => {
      dialog.showModal();
      lockScroll();
    });

    closeButton?.addEventListener('click', () => {
      dialog.close();
    });

    dialog.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('close', unlockScroll);

    const desktopQuery = window.matchMedia('(min-width: 901px)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches && dialog.open) {
        dialog.close();
      }
    });
  }
</script>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>
