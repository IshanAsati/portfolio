---
import { ArrowUpRight, Menu, X } from '@lucide/astro';
import { navigation, site, socialLinks } from '../config';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) => {
  if (href === '/work') return currentPath === '/work' || currentPath.startsWith('/work/');
  return currentPath === href;
};

const entries = [
  ...navigation.map((item) => ({ ...item, index: String(navigation.indexOf(item) + 1).padStart(2, '0') })),
  { label: 'Contact', href: '/contact', index: '04' },
];
---

<header class="masthead">
  <div class="masthead-inner shell">
    <a class="wordmark" href="/" aria-label={`${site.brand}, home`}>
      {site.brand}<span class="wordmark-stop">.</span>
    </a>

    <nav class="masthead-nav" aria-label="Primary navigation">
      {entries.map((item) => (
        <a
          class:list={['masthead-link', { 'is-active': isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="masthead-index">{item.index}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <p class="masthead-meta">
      <span>{site.issue}</span>
      <span>{site.year} · {site.location}</span>
    </p>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-haspopup="dialog"
      data-menu-open
    >
      <Menu aria-hidden="true" stroke-width="1.5" />
    </button>
  </div>

  <div class="read-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <nav class="header-fallback" aria-label="Mobile navigation">
    {entries.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

<dialog class="menu-dialog" aria-label="Site menu" data-menu-dialog>
  <div class="menu-inner shell">
    <div class="menu-top">
      <a class="wordmark" href="/">
        {site.brand}<span class="wordmark-stop">.</span>
      </a>
      <button class="menu-close" type="button" aria-label="Close menu" data-menu-close>
        <X aria-hidden="true" stroke-width="1.5" />
      </button>
    </div>

    <nav class="menu-nav" aria-label="Mobile navigation">
      {entries.map((item) => (
        <a class:list={['menu-link', { 'is-active': isActive(item.href) }]} href={item.href}>
          <span class="menu-index">{item.index}</span>
          <span class="menu-label">{item.label}</span>
          <ArrowUpRight aria-hidden="true" stroke-width="1.2" />
        </a>
      ))}
    </nav>

    <div class="menu-foot">
      <div class="menu-socials">
        {socialLinks.map((link) => (
          <a
            class="menu-social"
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer noopener' : undefined}
          >
            {link.label}
          </a>
        ))}
      </div>
      <p class="menu-meta">{site.issue} / {site.year} / {site.location}</p>
    </div>
  </div>
</dialog>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(18px);
  }

  .masthead-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: 5rem;
    gap: 2rem;
  }

  .wordmark {
    justify-self: start;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark-stop {
    color: var(--primary);
  }

  .masthead-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.2rem);
  }

  .masthead-link {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    min-height: 44px;
    padding: 0;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    transition: color 180ms var(--ease);
  }

  .masthead-index {
    color: color-mix(in srgb, var(--muted) 55%, transparent);
    font-size: 0.5rem;
    font-variant-numeric: tabular-nums;
    transition: color 180ms var(--ease);
  }

  .masthead-link:hover,
  .masthead-link.is-active {
    color: var(--ink);
  }

  .masthead-link:hover .masthead-index,
  .masthead-link.is-active .masthead-index {
    color: var(--primary);
  }

  .masthead-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-self: end;
    gap: 3px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-align: right;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .masthead-meta span:first-child {
    color: var(--ink);
  }

  .read-progress {
    position: absolute;
    inset: auto 0 -1px;
    height: 1px;
    overflow: hidden;
    pointer-events: none;
  }

  .read-progress span {
    display: block;
    height: 100%;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 120ms linear;
  }

  .menu-toggle,
  .menu-close {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .menu-toggle {
    justify-self: end;
  }

  .menu-toggle:hover,
  .menu-close:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .menu-toggle svg,
  .menu-close svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .header-fallback {
    display: none;
  }

  .header-fallback a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .menu-dialog {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--surface);
    color: var(--ink);
  }

  .menu-dialog[open] {
    display: flex;
    animation: menu-in 0.32s var(--ease-out) both;
  }

  .menu-dialog::backdrop {
    background: var(--surface);
  }

  .menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: 1.5rem 2rem;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .menu-close {
    display: inline-flex;
  }

  .menu-nav {
    display: flex;
    flex-direction: column;
    margin-block: auto;
    padding-block: 2.5rem;
  }

  .menu-link {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 5.25rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  .menu-link:first-child {
    border-top: 1px solid var(--line);
  }

  .menu-index {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
  }

  .menu-label {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 11vw, 4.5rem);
    font-weight: 450;
    letter-spacing: -0.035em;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .menu-link svg {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--primary);
    opacity: 0;
    transform: translate(-0.35rem, 0.35rem);
    transition: opacity 0.25s ease, transform 0.35s var(--ease-out);
  }

  .menu-link:hover .menu-label,
  .menu-link.is-active .menu-label {
    color: var(--primary);
  }

  .menu-link:hover svg,
  .menu-link.is-active svg {
    opacity: 1;
    transform: translate(0, 0);
  }

  .menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .menu-socials {
    display: flex;
    gap: 0.5rem;
  }

  .menu-social {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .menu-social:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .menu-meta {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 860px) {
    .masthead-inner {
      grid-template-columns: 1fr auto;
      min-height: 4.5rem;
      gap: 1rem;
    }

    .masthead-nav,
    .masthead-meta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    :global(html:not(.js)) .header-fallback {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      padding-block: 0.75rem;
      border-top: 1px solid var(--border);
    }

    :global(html:not(.js)) .menu-toggle {
      display: none;
    }
  }

  @media (max-width: 430px) {
    .menu-foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu-dialog]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (dialog && openButton) {
    const lockScroll = () => document.documentElement.classList.add('menu-open');
    const unlockScroll = () => document.documentElement.classList.remove('menu-open');

    openButton.addEventListener('click', () => {
      dialog.showModal();
      lockScroll();
    });

    closeButton?.addEventListener('click', () => dialog.close());

    dialog.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('close', unlockScroll);

    const desktopQuery = window.matchMedia('(min-width: 861px)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches && dialog.open) dialog.close();
    });
  }

  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');

  if (progress) {
    let frame = 0;

    const paint = () => {
      frame = 0;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
      progress.style.transform = `scaleX(${ratio})`;
    };

    const queue = () => {
      if (!frame) frame = window.requestAnimationFrame(paint);
    };

    paint();
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
  }
</script>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>
