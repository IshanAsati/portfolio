---
import { ArrowUp, ArrowUpRight } from '@lucide/astro';
import { navigation, site, socialLinks } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <a class="footer-brand" href="/" aria-label={`${site.brand}, home`}>
        <span class="footer-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 2.6c.7 4.6 4.1 8 8.7 8.7-4.6.7-8 4.1-8.7 8.7-.7-4.6-4.1-8-8.7-8.7 4.6-.7 8-4.1 8.7-8.7Z" fill="currentColor" />
          </svg>
        </span>
        <span>ishan.asati<span class="footer-dot">.</span></span>
      </a>

      <a class="back-top" href="#top">
        <span>Back to top</span>
        <ArrowUp aria-hidden="true" stroke-width="1.6" />
      </a>
    </div>

    <div class="footer-grid">
      <div class="footer-column footer-statement">
        <p class="footer-kicker">Colophon</p>
        <p class="footer-note">
          An independent portfolio, set in Sora and Manrope. Built with Astro,
          TypeScript and Tailwind CSS. Written and maintained in {site.location}.
        </p>
        <p class="footer-note footer-note--muted">
          Documented at the stage the work is actually in.
        </p>
      </div>

      <nav class="footer-column" aria-label="Footer navigation">
        <p class="footer-kicker">Index</p>
        <ul class="footer-list">
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <div class="footer-column">
        <p class="footer-kicker">Elsewhere</p>
        <ul class="footer-list">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noreferrer noopener' : undefined}
              >
                {link.label}
                {link.external && <ArrowUpRight aria-hidden="true" stroke-width="1.6" />}
                {link.external && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))}
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>

      <div class="footer-column footer-meta">
        <p class="footer-kicker">Issue</p>
        <p class="footer-issue">Vol. 01</p>
        <p class="footer-year">{site.year}</p>
        <p class="footer-place">{site.location} · IST</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}</p>
      <p class="footer-built">A living document, not a finished one.</p>
      <p>Set in India</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-pad);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .footer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .footer-mark {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    color: var(--primary);
  }

  .footer-mark svg {
    width: 23px;
    height: 23px;
  }

  .footer-dot {
    color: var(--primary);
  }

  .back-top {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: var(--paper);
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition:
      border-color var(--motion-state) var(--ease),
      color var(--motion-state) var(--ease),
      transform var(--motion-state) var(--ease);
  }

  .back-top svg {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--primary);
    transition: transform 260ms var(--ease);
  }

  .back-top:hover {
    border-color: var(--primary);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .back-top:hover svg {
    transform: translateY(-3px);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 0.8fr) minmax(0, 0.8fr) minmax(0, 0.8fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .footer-column {
    min-width: 0;
  }

  .footer-kicker {
    margin-bottom: 1rem;
    color: var(--primary);
    font-size: 0.625rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .footer-note {
    max-width: 38ch;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .footer-note + .footer-note {
    margin-top: 0.8rem;
  }

  .footer-note--muted {
    color: color-mix(in srgb, var(--muted) 72%, transparent);
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-list a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 550;
    line-height: 1.4;
    transition: color var(--motion-state) var(--ease);
  }

  .footer-list a svg {
    width: 0.72rem;
    height: 0.72rem;
    color: var(--primary);
    opacity: 0.85;
  }

  .footer-list a:hover {
    color: var(--primary);
  }

  .footer-issue {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .footer-year {
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .footer-place {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .footer-built {
    text-align: center;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-statement {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .footer-top {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .footer-grid {
      gap: 2rem 1.5rem;
    }

    .footer-built {
      order: 3;
      width: 100%;
      text-align: left;
    }
  }
</style>
