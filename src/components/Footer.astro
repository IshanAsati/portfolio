---
import { ArrowUp, ArrowUpRight } from '@lucide/astro';
import { navigation, site, socialLinks } from '../config';

const year = new Date().getFullYear();
---

<footer class="colophon">
  <div class="shell">
    <div class="colophon-top">
      <p class="colophon-kicker">Colophon</p>
      <p class="colophon-statement">
        An independent record of things made in order to understand them.
      </p>
      <a class="back-top" href="#top">
        <span>Return to the top</span>
        <ArrowUp aria-hidden="true" stroke-width="1.4" />
      </a>
    </div>

    <div class="colophon-grid">
      <div class="colophon-column colophon-identity">
        <a class="colophon-brand" href="/" aria-label={`${site.brand}, home`}>
          {site.brand}<span>.</span>
        </a>
        <p class="colophon-note">
          Set in Fraunces, Newsreader and IBM Plex Mono. Built with Astro,
          TypeScript and Tailwind CSS. Written and maintained in {site.location}.
        </p>
        <p class="colophon-note colophon-note--muted">
          Documented at the stage the work is actually in.
        </p>
      </div>

      <nav class="colophon-column" aria-label="Footer navigation">
        <p class="colophon-label">Index</p>
        <ul class="colophon-list">
          {navigation.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <div class="colophon-column">
        <p class="colophon-label">Elsewhere</p>
        <ul class="colophon-list">
          {socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noreferrer noopener' : undefined}
              >
                {link.label}
                {link.external && <ArrowUpRight aria-hidden="true" stroke-width="1.4" />}
                {link.external && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </li>
          ))}
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>

      <div class="colophon-column colophon-issue">
        <p class="colophon-label">Issue</p>
        <p class="colophon-volume">{site.issue}</p>
        <p class="colophon-year">{site.year}</p>
        <p class="colophon-place">{site.location} · IST</p>
      </div>
    </div>

    <div class="colophon-bottom">
      <p>© {year} {site.name}</p>
      <p class="colophon-built">A living document, not a finished one.</p>
      <p>Set in India</p>
    </div>
  </div>
</footer>

<style>
  .colophon {
    margin-top: var(--section-pad);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .colophon-top {
    display: grid;
    grid-template-columns: minmax(0, 0.45fr) minmax(0, 1.6fr) auto;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
  }

  .colophon-kicker,
  .colophon-label {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .colophon-statement {
    max-width: 28ch;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.9rem);
    font-weight: 420;
    letter-spacing: -0.02em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .back-top {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--control-border);
    border-radius: 2px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: border-color var(--motion-state) var(--ease), color var(--motion-state) var(--ease);
  }

  .back-top svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--primary);
    transition: transform 260ms var(--ease);
  }

  .back-top:hover {
    border-color: var(--primary);
    color: var(--ink);
  }

  .back-top:hover svg {
    transform: translateY(-3px);
  }

  .colophon-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.9fr) minmax(0, 0.8fr) minmax(0, 0.8fr) minmax(0, 0.7fr);
    gap: clamp(1.75rem, 4vw, 4rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .colophon-column {
    min-width: 0;
  }

  .colophon-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .colophon-brand {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .colophon-brand span {
    color: var(--primary);
  }

  .colophon-note {
    max-width: 40ch;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .colophon-note + .colophon-note {
    margin-top: 0.7rem;
  }

  .colophon-note--muted {
    color: color-mix(in srgb, var(--muted) 70%, transparent);
    font-style: italic;
  }

  .colophon-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .colophon-list a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 26px;
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.4;
    transition: color var(--motion-state) var(--ease);
  }

  .colophon-list a svg {
    width: 0.7rem;
    height: 0.7rem;
    color: var(--primary);
    opacity: 0.85;
  }

  .colophon-list a:hover {
    color: var(--primary);
  }

  .colophon-volume {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 450;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .colophon-year {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .colophon-place {
    margin-top: 0.9rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .colophon-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .colophon-built {
    text-align: center;
  }

  @media (max-width: 900px) {
    .colophon-top {
      grid-template-columns: 1fr auto;
    }

    .colophon-statement {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .colophon-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .colophon-identity {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .colophon-top {
      grid-template-columns: 1fr;
    }

    .back-top {
      justify-self: start;
    }

    .colophon-grid {
      gap: 2rem 1.5rem;
    }

    .colophon-built {
      order: 3;
      width: 100%;
      text-align: left;
    }
  }
</style>
