---
/**
 * Reveal Footer — an Astro-native rebuild of the Framer component.
 * A typographic band lifts into view, then the colophon settles underneath it.
 */
import { ArrowUp, ArrowUpRight } from '@lucide/astro';
import { navigation, site, socialLinks } from '../../config';
import DotGrid from './react/DotGrid.jsx';
import SiteInk from './react/SiteInk.jsx';

const year = new Date().getFullYear();
---

<footer class="reveal-footer" data-reveal-footer>
  <div class="reveal-band">
    <DotGrid client:only="react" dotColor="#cf5a3c" dotSize={2} dotSpacing={30} impactRadius={150} orbitSpeed={0.7} />

    <div class="shell band-inner">
      <div class="band-top">
        <p class="band-kicker">The record</p>
        <p class="band-meta">{site.issue} / {site.year}</p>
      </div>
      <SiteInk
        client:only="react"
        tag="p"
        text="Seven entries. Still learning."
        align="left"
        min={34}
        max={96}
        scale={7.6}
        stagger={0.08}
        className="band-line"
      />
      <div class="band-foot">
        <span>Every status stated as it is</span>
        <span>Build / Observe / Revise</span>
      </div>
    </div>
  </div>

  <div class="footer-body">
    <DotGrid client:only="react" dotColor="#cf5a3c" dotSize={2} dotSpacing={28} impactRadius={140} orbitSpeed={0.7} />

    <div class="shell footer-grid">
      <div class="footer-claim">
        <p class="footer-kicker">Colophon</p>
        <SiteInk
          client:only="react"
          tag="h2"
          text="I build to understand."
          align="left"
          min={34}
          max={72}
          scale={6.2}
          className="footer-title"
        />
        <p class="footer-note">
          An independent record of things made in order to understand them.
        </p>
        <a class="footer-mail" href={`mailto:${site.email}`}>
          {site.email}
          <ArrowUpRight aria-hidden="true" stroke-width="1.3" />
        </a>
      </div>

      <div class="footer-columns">
        <nav class="footer-column" aria-label="Footer navigation">
          <p class="footer-column-label">Sitemap</p>
          <a href="/">Index</a>
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/contact">Contact</a>
        </nav>

        <div class="footer-column">
          <p class="footer-column-label">Elsewhere</p>
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noreferrer noopener' : undefined}
            >
              {link.label}
              {link.external && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
          ))}
        </div>

        <div class="footer-column footer-column--wide">
          <p class="footer-column-label">Set in</p>
          <p class="footer-set">
            Fraunces, Newsreader and IBM Plex Mono. Built with Astro,
            TypeScript and Tailwind CSS. Written and maintained in
            {' '}{site.location}.
          </p>
        </div>
      </div>
    </div>

    <div class="shell footer-bottom">
      <p>© {year} {site.name}</p>
      <p>{site.issue} / {site.year}</p>
      <a class="footer-top" href="#top">
        Return to the top
        <ArrowUp aria-hidden="true" stroke-width="1.4" />
      </a>
    </div>
  </div>
</footer>

<style>
  .reveal-footer {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .reveal-band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2.25rem, 5vw, 3.75rem) clamp(1.75rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border);
    background: linear-gradient(180deg, var(--paper), var(--surface));
  }

  .reveal-band :global(.dot-grid) {
    opacity: 0.7;
    -webkit-mask-image: radial-gradient(110% 130% at 12% 8%, #000 0%, transparent 72%);
    mask-image: radial-gradient(110% 130% at 12% 8%, #000 0%, transparent 72%);
  }

  .band-inner {
    position: relative;
    z-index: 1;
  }

  .band-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .band-kicker {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .band-meta {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .band-inner :global(.band-line) {
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7.4vw, 6.2rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .band-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .band-kicker,
  .band-meta,
  .band-foot {
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 0.9s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .reveal-footer.is-revealed .band-kicker,
  .reveal-footer.is-revealed .band-meta {
    opacity: 1;
    transform: none;
    transition-delay: 0.1s;
  }

  .reveal-footer.is-revealed .band-foot {
    opacity: 1;
    transform: none;
    transition-delay: 0.35s;
  }

  .footer-body {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }

  .footer-body :global(.dot-grid) {
    opacity: 0.8;
  }

  .footer-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .footer-kicker {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .footer-body :global(.footer-title) {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.6vw, 5rem);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 0.94;
  }

  .footer-note {
    max-width: 36ch;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .footer-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 1.35rem;
    border-bottom: 1px solid var(--primary);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 450;
    letter-spacing: -0.01em;
    line-height: 1.3;
    transition: color 180ms var(--ease);
  }

  .footer-mail svg {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--primary);
  }

  .footer-mail:hover {
    color: var(--primary);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
    gap: 2rem 1.5rem;
    padding-top: 0.35rem;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .footer-column--wide {
    grid-column: 1 / -1;
    padding-top: 1.35rem;
    border-top: 1px solid var(--line);
  }

  .footer-column-label {
    margin-bottom: 0.5rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .footer-column a {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 38px;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
    transition: color 180ms var(--ease);
  }

  .footer-column a:hover {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .footer-set {
    max-width: 46ch;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .footer-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .footer-top {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    color: var(--ink);
    transition: color 180ms var(--ease);
  }

  .footer-top svg {
    width: 0.85rem;
    height: 0.85rem;
    color: var(--primary);
    transition: transform 220ms var(--ease);
  }

  .footer-top:hover {
    color: var(--primary);
  }

  .footer-top:hover svg {
    transform: translateY(-2px);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-columns {
      padding-top: 0;
    }
  }

  @media (max-width: 560px) {
    .footer-columns {
      grid-template-columns: 1fr;
    }

    .footer-column--wide {
      grid-column: 1;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .band-foot {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>

<script>
  const footer = document.querySelector<HTMLElement>('[data-reveal-footer]');

  if (footer) {
    if (!('IntersectionObserver' in window)) {
      footer.classList.add('is-revealed');
    } else {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          footer.classList.add('is-revealed');
          observer.disconnect();
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      observer.observe(footer);
    }
  }
</script>
