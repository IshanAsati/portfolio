---
/**
 * Motion Overlay Menu — an Astro-native rebuild of the Framer component.
 * A floating glass bar that becomes a full-screen overlay with a staggered
 * index. The bar carries the reading progress line.
 */
import { ArrowUpRight, Menu, X } from '@lucide/astro';
import { navigation, site, socialLinks } from '../../config';
import DotGrid from './DotGrid.astro';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) => {
  if (href === '/work') return currentPath === '/work' || currentPath.startsWith('/work/');
  return currentPath === href;
};

const entries = [
  ...navigation.map((item, index) => ({
    ...item,
    index: String(index + 1).padStart(2, '0'),
  })),
  { label: 'Contact', href: '/contact', index: '04' },
];
---

<header class="motion-header" data-motion-header>
  <div class="motion-bar">
    <a class="motion-brand" href="/" aria-label={`${site.brand}, home`}>
      {site.brand}<span aria-hidden="true">.</span>
    </a>

    <nav class="motion-nav" aria-label="Primary navigation">
      {entries.map((item) => (
        <a
          class:list={['motion-link', { 'is-active': isActive(item.href) }]}
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="motion-link-index">{item.index}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <p class="motion-meta">
      <span>{site.issue}</span>
      <span>{site.year} / {site.location}</span>
    </p>

    <div class="motion-actions">
      <a
        class:list={['motion-work', { 'is-active': isActive('/work') }]}
        href="/work"
        aria-current={isActive('/work') ? 'page' : undefined}
      >
        Work
      </a>

      <button
        class="motion-toggle"
        type="button"
        aria-label="Open menu"
        aria-haspopup="dialog"
        data-menu-open
      >
        <Menu aria-hidden="true" stroke-width="1.5" />
        <span class="motion-toggle-label">Index</span>
      </button>
    </div>
  </div>

  <div class="motion-progress" aria-hidden="true"><span data-reading-progress></span></div>
</header>

<dialog class="motion-overlay" aria-label="Site index" data-menu-dialog>
  <DotGrid color="#cf5a3c" size={1.8} spacing={30} impact={150} opacity={0.5} />

  <div class="overlay-inner shell">
    <div class="overlay-top">
      <a class="motion-brand" href="/">
        {site.brand}<span aria-hidden="true">.</span>
      </a>
      <p class="overlay-meta">{site.issue} / {site.year}</p>
      <button class="overlay-close" type="button" aria-label="Close menu" data-menu-close>
        <X aria-hidden="true" stroke-width="1.5" />
      </button>
    </div>

    <nav class="overlay-nav" aria-label="Site index">
      {entries.map((item, index) => (
        <a
          class:list={['overlay-link', { 'is-active': isActive(item.href) }]}
          href={item.href}
          style={`--i:${index}`}
        >
          <span class="overlay-index">{item.index}</span>
          <span class="overlay-label">{item.label}</span>
          <ArrowUpRight aria-hidden="true" stroke-width="1.1" />
        </a>
      ))}
    </nav>

    <div class="overlay-foot">
      <a class="overlay-mail" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      <div class="overlay-socials">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noreferrer noopener' : undefined}
          >
            {link.label}
            {link.external && <span class="sr-only"> (opens in a new tab)</span>}
          </a>
        ))}
      </div>
      <p class="overlay-note">{site.tagline}</p>
    </div>
  </div>
</dialog>

<style>
  .motion-header {
    position: sticky;
    top: 0;
    z-index: 60;
    padding: 0.65rem var(--gutter) 0;
    pointer-events: none;
  }

  .motion-bar {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    width: min(100%, 1500px);
    min-height: 3.75rem;
    margin-inline: auto;
    padding: 0.35rem 0.4rem 0.35rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--border) 88%, transparent);
    border-radius: 999px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--ink) 4%, transparent), transparent 70%),
      color-mix(in srgb, var(--surface) 74%, transparent);
    box-shadow:
      0 18px 46px -28px #000000e6,
      inset 0 1px 0 color-mix(in srgb, var(--ink) 7%, transparent);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    pointer-events: auto;
  }

  .motion-brand {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    white-space: nowrap;
  }

  .motion-brand span {
    color: var(--primary);
  }

  .motion-nav {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    transform: translate(-50%, -50%);
  }

  .motion-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 44px;
    padding-inline: 0.15rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    transition: color 180ms var(--ease);
  }

  .motion-link-index {
    color: color-mix(in srgb, var(--muted) 55%, transparent);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    transition: color 180ms var(--ease);
  }

  .motion-link:hover,
  .motion-link.is-active {
    color: var(--ink);
  }

  .motion-link:hover .motion-link-index,
  .motion-link.is-active .motion-link-index {
    color: var(--primary);
  }

  .motion-meta {
    justify-self: end;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-align: right;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .motion-meta span:first-child {
    color: var(--ink);
  }

  .motion-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .motion-work {
    display: none;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    transition: border-color 180ms var(--ease), color 180ms var(--ease);
  }

  .motion-work:hover,
  .motion-work.is-active {
    border-color: var(--primary);
    color: var(--primary);
  }

  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.95rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--primary);
    color: var(--on-primary);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    transition: background-color 180ms var(--ease);
  }

  .motion-toggle:hover {
    background: var(--control-highlight);
  }

  .motion-toggle svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .motion-toggle-label {
    display: inline;
  }

  .motion-progress {
    width: min(100%, 1500px);
    height: 2px;
    margin: 0.3rem auto 0;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--line) 80%, transparent);
  }

  .motion-progress span {
    display: block;
    height: 100%;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 120ms linear;
  }

  /* ---------- Overlay ---------- */

  .motion-overlay {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background:
      radial-gradient(120% 90% at 80% 0%, color-mix(in srgb, var(--primary) 10%, transparent), transparent 55%),
      var(--surface);
    color: var(--ink);
    overflow: hidden;
  }

  .motion-overlay[open] {
    display: flex;
    animation: overlay-in 0.42s var(--ease-out) both;
  }

  .motion-overlay::backdrop {
    background: var(--surface);
  }

  .overlay-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block: 1rem 2rem;
  }

  .overlay-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .overlay-meta {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .overlay-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: end;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 180ms var(--ease), color 180ms var(--ease);
  }

  .overlay-close:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .overlay-close svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .overlay-nav {
    display: flex;
    flex-direction: column;
    margin-block: auto;
    padding-block: clamp(1.25rem, 4vh, 2.75rem);
  }

  .overlay-link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: clamp(4.5rem, 11vh, 6.5rem);
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    clip-path: inset(0 100% 0 0);
    animation: link-in 0.7s var(--ease-out) both;
    animation-delay: calc(0.12s + var(--i) * 0.075s);
  }

  .overlay-link:first-child {
    border-top: 1px solid var(--line);
  }

  .overlay-index {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .overlay-label {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 8vw, 5.25rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.95;
    transition: color 200ms var(--ease), transform 320ms var(--ease-out);
  }

  .overlay-link svg {
    width: clamp(1.1rem, 2.4vw, 1.6rem);
    height: clamp(1.1rem, 2.4vw, 1.6rem);
    color: var(--primary);
    opacity: 0;
    transform: translate(-0.4rem, 0.4rem);
    transition: opacity 220ms var(--ease), transform 320ms var(--ease-out);
  }

  .overlay-link:hover .overlay-label,
  .overlay-link:focus-visible .overlay-label,
  .overlay-link.is-active .overlay-label {
    color: var(--primary);
  }

  .overlay-link:hover svg,
  .overlay-link:focus-visible svg,
  .overlay-link.is-active svg {
    opacity: 1;
    transform: none;
  }

  .overlay-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .overlay-mail {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 450;
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--primary);
    transition: color 180ms var(--ease);
  }

  .overlay-mail:hover {
    color: var(--primary);
  }

  .overlay-socials {
    display: flex;
    gap: 0.5rem;
  }

  .overlay-socials a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: border-color 180ms var(--ease), color 180ms var(--ease);
  }

  .overlay-socials a:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .overlay-note {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-style: italic;
    letter-spacing: -0.01em;
  }

  @keyframes overlay-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes link-in {
    from {
      clip-path: inset(0 100% 0 0);
      transform: translateY(0.4rem);
    }
    to {
      clip-path: inset(0 0 0 0);
      transform: none;
    }
  }

  @media (max-width: 1020px) {
    .motion-meta {
      display: none;
    }

    .motion-bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .motion-nav {
      justify-content: flex-end;
    }
  }

  @media (max-width: 860px) {
    .motion-bar {
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
      padding-left: 1rem;
    }

    .motion-nav {
      display: none;
    }

    .motion-work {
      display: inline-flex;
    }

    .motion-toggle-label {
      display: none;
    }

    .motion-toggle {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
  }

  @media (max-width: 430px) {
    .overlay-top {
      grid-template-columns: auto 1fr auto;
    }

    .overlay-meta {
      display: none;
    }

    .overlay-foot {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-height: 640px) {
    .overlay-link {
      min-height: 3.5rem;
    }

    .overlay-label {
      font-size: clamp(1.8rem, 5vw, 2.8rem);
    }

    .overlay-nav {
      padding-block: 0.75rem;
    }

    .overlay-inner {
      padding-block: 0.75rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-overlay[open],
    .overlay-link {
      animation: none;
      clip-path: none;
    }

    .overlay-label,
    .overlay-link svg,
    .motion-progress span {
      transition: none;
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu-dialog]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (dialog && openButton) {
    const lockScroll = () => document.documentElement.classList.add('menu-open');
    const unlockScroll = () => document.documentElement.classList.remove('menu-open');

    openButton.addEventListener('click', () => {
      dialog.showModal();
      closeButton?.focus();
      lockScroll();
    });

    closeButton?.addEventListener('click', () => dialog.close());

    dialog.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('close', unlockScroll);

    const desktopQuery = window.matchMedia('(min-width: 861px)');
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches && dialog.open) dialog.close();
    });
  }

  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');

  if (progress) {
    let frame = 0;

    const paint = () => {
      frame = 0;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
      progress.style.transform = `scaleX(${ratio})`;
    };

    const queue = () => {
      if (!frame) frame = window.requestAnimationFrame(paint);
    };

    paint();
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
  }
</script>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>
