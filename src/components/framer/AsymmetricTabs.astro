---
/**
 * Flexible Accordion — an Astro-native rebuild of the Framer `AsymmetricTabs`.
 * A media panel, an overlapping paper card, and a vertical tab rail.
 */
import type { ImageMetadata } from 'astro';
import DitheringHover from './DitheringHover.astro';

interface TabItem {
  tab: string;
  eyebrow: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  facts?: Array<{ label: string; value: string }>;
}

interface Props {
  items: TabItem[];
  label?: string;
  class?: string;
}

const { items, label = 'Method', class: className = '' } = Astro.props;
const uid = `tabs-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['f-tabs', className]} data-f-tabs data-tabs-id={uid}>
  <div class="f-tabs-frame">
    <div class="f-tabs-media" aria-hidden="true">
      {items.map((item, index) => (
        <div
          class:list={['f-tabs-shot', { 'is-active': index === 0 }]}
          data-tab-shot={index}
        >
          <DitheringHover
            image={item.image}
            alt={item.imageAlt}
            ratio="16 / 10"
            sizes="(max-width: 900px) 92vw, 780px"
            widths={[480, 720, 960, 1280]}
          />
        </div>
      ))}
      <span class="f-tabs-grain" aria-hidden="true"></span>
      <span class="f-tabs-folio" aria-hidden="true" data-tab-folio>01 / 04</span>
    </div>

    <div class="f-tabs-card">
      <div class="f-tabs-card-head">
        <span class="f-tabs-eyebrow" data-tab-eyebrow>{items[0]?.eyebrow}</span>
        <span class="f-tabs-count" data-tab-count>01</span>
      </div>

      {items.map((item, index) => (
        <div
          class:list={['f-tabs-panel', { 'is-active': index === 0 }]}
          id={`${uid}-panel-${index}`}
          role="tabpanel"
          aria-labelledby={`${uid}-tab-${index}`}
          tabindex="0"
          data-tab-panel={index}
          hidden={index !== 0}
        >
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          {item.facts && (
            <dl class="f-tabs-facts">
              {item.facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      ))}
    </div>

    <div class="f-tabs-rail" role="tablist" aria-label={label}>
      {items.map((item, index) => (
        <button
          class:list={['f-tabs-tab', { 'is-active': index === 0 }]}
          id={`${uid}-tab-${index}`}
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`${uid}-panel-${index}`}
          tabindex={index === 0 ? 0 : -1}
          data-tab-button={index}
          data-eyebrow={item.eyebrow}
        >
          <span class="f-tabs-tab-number">0{index + 1}</span>
          <span class="f-tabs-tab-label">{item.tab}</span>
          <span class="f-tabs-tab-line" aria-hidden="true"></span>
        </button>
      ))}
    </div>
  </div>
</div>

<style>
  .f-tabs {
    position: relative;
  }

  .f-tabs-frame {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 0.82fr);
    grid-template-rows: auto auto;
    gap: 0;
    padding: clamp(0.5rem, 1.5vw, 1rem);
    border: 1px solid var(--border);
    border-radius: 22px;
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in srgb, var(--sage) 9%, transparent), transparent 55%),
      var(--paper);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .f-tabs-media {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 1;
    min-height: clamp(360px, 48vw, 600px);
    margin-left: clamp(1rem, 10vw, 8rem);
    border-radius: 16px;
    overflow: hidden;
    background: var(--warm);
  }

  .f-tabs-shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.02);
    transition:
      opacity 600ms var(--ease),
      transform 900ms var(--ease-out);
  }

  .f-tabs-shot.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .f-tabs-shot :global(.dither-frame),
  .f-tabs-shot :global(.dither-media) {
    height: 100%;
  }

  .f-tabs-shot :global(.dither-media) {
    aspect-ratio: auto;
    height: 100%;
    border: 0;
  }

  .f-tabs-grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.16;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .f-tabs-folio {
    position: absolute;
    z-index: 3;
    top: 1rem;
    right: 1rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: 2px;
    background: color-mix(in srgb, var(--surface) 62%, transparent);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    backdrop-filter: blur(10px);
  }

  .f-tabs-card {
    position: relative;
    z-index: 4;
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    width: min(100%, 34rem);
    margin: 0 0 clamp(1.5rem, 4vw, 3rem) 0;
    padding: clamp(1.5rem, 3.2vw, 2.6rem);
    border: 1px solid color-mix(in srgb, var(--border) 92%, transparent);
    border-radius: 18px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--ink) 4%, transparent), transparent 42%),
      var(--warm);
    box-shadow: 0 28px 70px -28px #000000e6;
  }

  .f-tabs-card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .f-tabs-eyebrow,
  .f-tabs-count {
    color: var(--sage);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .f-tabs-count {
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }

  .f-tabs-panel {
    padding-top: 1.35rem;
  }

  .f-tabs-panel h3 {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.6vw, 3.15rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .f-tabs-panel p {
    max-width: 42ch;
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 0.96875rem;
    line-height: 1.75;
  }

  .f-tabs-panel[hidden] {
    display: none;
  }

  .f-tabs-panel.is-active {
    animation: card-in 460ms var(--ease-out) both;
  }

  .f-tabs-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.35rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--line);
  }

  .f-tabs-facts div {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .f-tabs-facts dt {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .f-tabs-facts dd {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .f-tabs-rail {
    position: relative;
    z-index: 5;
    grid-column: 1 / -1;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(1rem, 2.5vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--line);
    overflow: hidden;
  }

  .f-tabs-tab {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-height: 54px;
    padding: 0 1rem;
    border: 0;
    background: var(--paper);
    color: var(--muted);
    text-align: left;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease);
  }

  .f-tabs-tab:hover {
    background: var(--warm);
    color: var(--ink);
  }

  .f-tabs-tab.is-active {
    background: var(--warm);
    color: var(--ink);
  }

  .f-tabs-tab-number {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .f-tabs-tab-label {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .f-tabs-tab-line {
    position: absolute;
    inset: auto 1rem 0;
    height: 2px;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 300ms var(--ease-out);
  }

  .f-tabs-tab.is-active .f-tabs-tab-line {
    transform: scaleX(1);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(0.8rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 1000px) {
    .f-tabs-media {
      margin-left: clamp(1rem, 5vw, 3rem);
      min-height: clamp(300px, 50vw, 460px);
    }

    .f-tabs-card {
      width: min(100%, 32rem);
    }
  }

  @media (max-width: 760px) {
    .f-tabs-frame {
      display: flex;
      flex-direction: column;
      border-radius: 16px;
      padding: 0.5rem;
    }

    .f-tabs-media {
      margin-left: 0;
      min-height: 58vw;
      border-radius: 12px;
    }

    .f-tabs-card {
      width: calc(100% - 1.5rem);
      margin: -2.5rem 0.75rem 0.75rem;
      border-radius: 14px;
    }

    .f-tabs-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 0;
    }

    .f-tabs-tab {
      min-height: 50px;
    }
  }

  @media (max-width: 420px) {
    .f-tabs-rail {
      grid-template-columns: minmax(0, 1fr);
    }

    .f-tabs-panel h3 {
      font-size: 1.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .f-tabs-shot,
    .f-tabs-tab-line {
      transition: none;
    }

    .f-tabs-panel.is-active {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-f-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab-button]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-tab-panel]'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('[data-tab-shot]'));
    const eyebrow = root.querySelector<HTMLElement>('[data-tab-eyebrow]');
    const count = root.querySelector<HTMLElement>('[data-tab-count]');
    const folio = root.querySelector<HTMLElement>('[data-tab-folio]');

    if (!tabs.length || tabs.length !== panels.length) return;

    const total = String(tabs.length).padStart(2, '0');

    const activate = (index: number, focus = false) => {
      const activeTab = tabs[index];
      if (!activeTab) return;

      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.classList.toggle('is-active', selected);
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      });

      panels.forEach((panel, panelIndex) => {
        const selected = panelIndex === index;
        panel.hidden = !selected;
        panel.classList.toggle('is-active', selected);
      });

      shots.forEach((shot, shotIndex) => {
        shot.classList.toggle('is-active', shotIndex === index);
      });

      if (eyebrow) {
        eyebrow.textContent = activeTab.dataset.eyebrow ?? '';
      }
      if (count) count.textContent = String(index + 1).padStart(2, '0');
      if (folio) {
        folio.textContent = `${String(index + 1).padStart(2, '0')} / ${total}`;
      }

      if (focus) activeTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(next, true);
      });
    });
  });
</script>
