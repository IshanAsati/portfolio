---
/**
 * Peelable Stickers — an Astro-native rebuild of the Framer component.
 * A dot-grid desk with paper, vinyl and foil labels that lift at the corner
 * and can be nudged around with a mouse.
 */
import DotGrid from './DotGrid.astro';

interface Sticker {
  label: string;
  sub?: string;
  tone?: 'coral' | 'sage' | 'apricot' | 'steel' | 'cream' | 'rose';
  material?: 'paper' | 'vinyl' | 'foil';
  x: number;
  y: number;
  rotate?: number;
  width?: number;
}

interface Props {
  stickers: Sticker[];
  title?: string;
  note?: string;
  class?: string;
  ariaHidden?: boolean;
}

const {
  stickers,
  title = 'On the desk',
  note = 'Areas of practice, not a finished syllabus.',
  class: className = '',
  ariaHidden = false,
} = Astro.props;
---

<div class:list={['sticker-field', className]} data-sticker-field aria-hidden={ariaHidden ? 'true' : undefined}>
  <DotGrid color="#8d9a6b" size={1.6} spacing={24} impact={110} opacity={0.42} />
  <div class="sticker-head">
    <p class="sticker-kicker">{title}</p>
    <p class="sticker-note">{note}</p>
  </div>
  <div class="sticker-body">
    {stickers.map((sticker) => (
      <div
        class:list={[
          'sticker',
          `sticker--${sticker.tone ?? 'coral'}`,
          `sticker--${sticker.material ?? 'paper'}`,
        ]}
        style={`--x:${sticker.x}%;--y:${sticker.y}%;--r:${sticker.rotate ?? 0}deg;--w:${sticker.width ?? 148}px`}
        data-sticker
        data-rotate={sticker.rotate ?? 0}
      >
        <span class="sticker-grain" aria-hidden="true"></span>
        <span class="sticker-label">{sticker.label}</span>
        {sticker.sub && <span class="sticker-sub">{sticker.sub}</span>}
        <span class="sticker-peel" aria-hidden="true"></span>
        <span class="sticker-tack" aria-hidden="true"></span>
      </div>
    ))}
  </div>
  <p class="sticker-foot" aria-hidden="true">Drag a corner. Nothing here is fixed.</p>
</div>

<style>
  .sticker-field {
    position: relative;
    min-height: clamp(390px, 44vw, 500px);
    padding: clamp(1.25rem, 2.6vw, 2rem);
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(120% 130% at 80% 0%, color-mix(in srgb, var(--sage) 9%, transparent), transparent 55%),
      linear-gradient(180deg, var(--warm), var(--paper));
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--ink) 5%, transparent);
    overflow: hidden;
    isolation: isolate;
  }

  .sticker-head {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .sticker-kicker {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .sticker-note {
    max-width: 28ch;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    line-height: 1.5;
    text-align: right;
  }

  .sticker-body {
    position: relative;
    z-index: 2;
    min-height: clamp(260px, 32vw, 360px);
    margin-top: 0.75rem;
  }

  .sticker {
    position: absolute;
    top: var(--y);
    left: var(--x);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: var(--w);
    min-height: 88px;
    padding: 0.9rem 1rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--sticker-ink) 22%, transparent);
    border-radius: 3px;
    background: var(--sticker-bg);
    color: var(--sticker-ink);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--sticker-ink) 20%, transparent),
      0 14px 26px -18px #000000d9;
    cursor: grab;
    transform: translate(-50%, -50%) rotate(var(--r));
    transform-origin: 50% 60%;
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease),
      filter 260ms var(--ease);
    user-select: none;
    touch-action: pan-y;
    isolation: isolate;
  }

  .sticker:hover,
  .sticker:focus-visible {
    z-index: 4;
    filter: brightness(1.04);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--sticker-ink) 20%, transparent),
      0 24px 38px -18px #000000f2;
    transform: translate(-50%, -50%) rotate(calc(var(--r) - 1.4deg)) translateY(-5px);
  }

  .sticker:active {
    cursor: grabbing;
  }

  .sticker--paper {
    --sticker-bg:
      repeating-linear-gradient(0deg, color-mix(in srgb, var(--sticker-ink) 4%, transparent) 0 1px, transparent 1px 4px),
      var(--sticker-tone);
  }

  .sticker--vinyl {
    --sticker-bg:
      linear-gradient(135deg, color-mix(in srgb, white 18%, transparent), transparent 42%),
      linear-gradient(315deg, color-mix(in srgb, black 18%, transparent), transparent 48%),
      var(--sticker-tone);
  }

  .sticker--foil {
    --sticker-bg:
      linear-gradient(118deg, color-mix(in srgb, white 38%, transparent) 0%, transparent 38%, color-mix(in srgb, black 16%, transparent) 52%, transparent 66%, color-mix(in srgb, white 26%, transparent) 100%),
      var(--sticker-tone);
  }

  .sticker--coral {
    --sticker-tone: #d96b4e;
    --sticker-ink: #241410;
  }

  .sticker--sage {
    --sticker-tone: #a7b787;
    --sticker-ink: #1c2117;
  }

  .sticker--apricot {
    --sticker-tone: #d2a36b;
    --sticker-ink: #241a10;
  }

  .sticker--steel {
    --sticker-tone: #9aaba9;
    --sticker-ink: #142020;
  }

  .sticker--cream {
    --sticker-tone: #e9dfcc;
    --sticker-ink: #2a241e;
  }

  .sticker--rose {
    --sticker-tone: #ce8f88;
    --sticker-ink: #2a1414;
  }

  .sticker-grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    opacity: 0.28;
    mix-blend-mode: multiply;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 120 120' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .sticker-label {
    color: var(--sticker-ink);
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 550;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .sticker-sub {
    margin-top: 0.25rem;
    color: color-mix(in srgb, var(--sticker-ink) 72%, transparent);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .sticker-peel {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 34px;
    height: 34px;
    border-radius: 0 0 3px 0;
    background:
      linear-gradient(135deg, transparent 49%, color-mix(in srgb, var(--sticker-ink) 24%, transparent) 50%, transparent 51%),
      linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--sticker-tone) 72%, white) 50%);
    box-shadow: -4px -4px 9px -6px color-mix(in srgb, var(--sticker-ink) 50%, transparent);
    transform: scale(0.6);
    transform-origin: bottom right;
    transition: transform 260ms var(--ease-out);
    pointer-events: none;
  }

  .sticker:hover .sticker-peel,
  .sticker.is-peeling .sticker-peel {
    transform: scale(1);
  }

  .sticker-tack {
    position: absolute;
    top: 0.45rem;
    right: 0.5rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--sticker-ink) 35%, transparent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sticker-tone) 18%, transparent);
    pointer-events: none;
  }

  .sticker-foot {
    position: absolute;
    right: clamp(1.25rem, 2.6vw, 2rem);
    bottom: 0.85rem;
    z-index: 2;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .sticker-field {
      min-height: 0;
    }

    .sticker-head {
      flex-direction: column;
      gap: 0.35rem;
      text-align: left;
    }

    .sticker-note {
      text-align: left;
    }

    .sticker-body {
      display: flex;
      flex-wrap: wrap;
      gap: 0.7rem;
      min-height: 0;
      padding: 1rem 0 1.5rem;
    }

    .sticker {
      position: relative;
      top: auto;
      left: auto;
      flex: 1 1 132px;
      width: auto;
      min-height: 78px;
      transform: rotate(var(--r));
    }

    .sticker:hover,
    .sticker:focus-visible {
      transform: rotate(var(--r)) translateY(-3px);
    }

    .sticker-foot {
      position: static;
      margin-top: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticker,
    .sticker-peel {
      transition: none;
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-sticker]').forEach((sticker) => {
    if (reducedMotion) return;

    let dragging = false;
    let startX = 0;
    let startY = 0;
    let offsetX = 0;
    let offsetY = 0;
    let pointerId: number | null = null;

    const baseRotation = Number(sticker.dataset.rotate ?? 0);

    const onPointerDown = (event: PointerEvent) => {
      if (event.pointerType !== 'mouse') return;
      dragging = true;
      pointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      offsetX = 0;
      offsetY = 0;
      sticker.classList.add('is-peeling');
      sticker.setPointerCapture(event.pointerId);
      sticker.style.transition = 'none';
    };

    const onPointerMove = (event: PointerEvent) => {
      if (!dragging || event.pointerId !== pointerId) return;
      offsetX = event.clientX - startX;
      offsetY = event.clientY - startY;
      sticker.style.transform = `translate(calc(-50% + ${offsetX}px), calc(-50% + ${offsetY}px)) rotate(${baseRotation}deg)`;
    };

    const onPointerUp = (event: PointerEvent) => {
      if (!dragging || event.pointerId !== pointerId) return;
      dragging = false;
      sticker.classList.remove('is-peeling');
      sticker.style.transition = '';
      sticker.style.transform = '';
      sticker.releasePointerCapture(event.pointerId);
      pointerId = null;
    };

    sticker.addEventListener('pointerdown', onPointerDown);
    sticker.addEventListener('pointermove', onPointerMove);
    sticker.addEventListener('pointerup', onPointerUp);
    sticker.addEventListener('pointercancel', onPointerUp);
    sticker.addEventListener('pointerleave', (event) => {
      if (dragging && event.pointerType === 'mouse' && event.buttons === 0) onPointerUp(event);
    });
  });
</script>
