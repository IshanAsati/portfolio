---
/**
 * Docket — an Astro-native rebuild of the Framer card-file component.
 * A brass plate, a set of folder tabs, and a drawer of project cards.
 */
import { ArrowRight } from '@lucide/astro';

interface Entry {
  id: string;
  index: string;
  title: string;
  category: string;
  status: string;
  year: string;
  deck: string;
  href: string;
}

interface Props {
  entries: Entry[];
  label?: string;
  class?: string;
}

const { entries, label = 'Project docket', class: className = '' } = Astro.props;
const uid = `docket-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['docket', className]} data-docket>
  <div class="docket-plate" aria-hidden="true">
    <span class="docket-plate-main">Index</span>
    <span class="docket-plate-sub">{entries.length} entries / active record</span>
    <span class="docket-rivet docket-rivet--left"></span>
    <span class="docket-rivet docket-rivet--right"></span>
  </div>

  <div class="docket-tabs" role="tablist" aria-label={label}>
    {entries.map((entry, index) => (
      <button
        class:list={['docket-tab', { 'is-active': index === 0 }]}
        id={`${uid}-tab-${index}`}
        type="button"
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`${uid}-panel-${index}`}
        tabindex={index === 0 ? 0 : -1}
        data-docket-tab={index}
        style={`--tab-order:${index}`}
      >
        <span class="docket-tab-index">{entry.index}</span>
        <span class="docket-tab-title">{entry.title}</span>
      </button>
    ))}
  </div>

  <div class="docket-drawer">
    <div class="docket-handle" aria-hidden="true">
      <span></span>
      <i></i>
      <span></span>
    </div>

    <div class="docket-stack">
      {entries.map((entry, index) => (
        <article
          class:list={['docket-card', { 'is-active': index === 0 }]}
          id={`${uid}-panel-${index}`}
          role="tabpanel"
          aria-labelledby={`${uid}-tab-${index}`}
          data-docket-card={index}
          hidden={index !== 0}
          style={`--card-order:${index}`}
        >
          <div class="docket-card-top">
            <span>No. {entry.index}</span>
            <span>{entry.year}</span>
          </div>

          <h3>{entry.title}</h3>
          <p class="docket-card-deck">{entry.deck}</p>

          <dl class="docket-card-facts">
            <div>
              <dt>Field</dt>
              <dd>{entry.category}</dd>
            </div>
            <div>
              <dt>Status</dt>
              <dd>{entry.status}</dd>
            </div>
          </dl>

          <a class="docket-card-link" href={entry.href}>
            Open the entry
            <ArrowRight aria-hidden="true" stroke-width="1.4" />
          </a>

          <span class="docket-stamp" aria-hidden="true">{entry.index}</span>
          <span class="docket-crease" aria-hidden="true"></span>
        </article>
      ))}
    </div>

    <p class="docket-foot" aria-hidden="true">
      <span>Filed by real stage, not by ambition.</span>
      <span>Pull a tab.</span>
    </p>
  </div>
</div>

<style>
  .docket {
    position: relative;
    padding: clamp(0.75rem, 1.8vw, 1.2rem);
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(120% 150% at 50% -10%, color-mix(in srgb, var(--apricot) 8%, transparent), transparent 55%),
      linear-gradient(180deg, var(--warm), #171412);
    box-shadow: var(--shadow-lg);
  }

  .docket-plate {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin: -1.65rem auto 0;
    width: min(100%, 24rem);
    padding: 0.5rem 1.4rem;
    border: 1px solid color-mix(in srgb, var(--apricot) 55%, var(--border));
    border-radius: 2px;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--apricot) 38%, #2a2118), #201812 55%, #17110c);
    color: var(--ink);
    box-shadow:
      0 10px 22px -12px #000000e6,
      inset 0 1px 0 color-mix(in srgb, white 18%, transparent);
    transform: rotate(-0.6deg);
  }

  .docket-plate-main {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 550;
    letter-spacing: 0.02em;
  }

  .docket-plate-sub {
    color: color-mix(in srgb, var(--ink) 60%, transparent);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .docket-rivet {
    position: absolute;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #f4e2ae, #86662c 70%);
    transform: translateY(-50%);
  }

  .docket-rivet--left {
    left: 0.55rem;
  }

  .docket-rivet--right {
    right: 0.55rem;
  }

  .docket-tabs {
    position: relative;
    z-index: 3;
    display: flex;
    gap: 3px;
    margin-top: 1.4rem;
    padding-inline: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .docket-tabs::-webkit-scrollbar {
    display: none;
  }

  .docket-tab {
    position: relative;
    display: flex;
    flex: 0 0 auto;
    align-items: baseline;
    gap: 0.45rem;
    min-height: 46px;
    padding: 0 0.8rem;
    border: 1px solid color-mix(in srgb, var(--border) 90%, transparent);
    border-bottom: 0;
    border-radius: 7px 7px 0 0;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    color: var(--muted);
    text-align: left;
    transform: translateY(4px);
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease),
      transform 240ms var(--ease-out);
  }

  .docket-tab:hover {
    background: var(--warm);
    color: var(--ink);
  }

  .docket-tab.is-active {
    z-index: 1;
    background: var(--card-paper, #241f18);
    color: var(--ink);
    transform: translateY(0);
  }

  .docket-tab-index {
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .docket-tab-title {
    font-family: var(--font-sans);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .docket-drawer {
    position: relative;
    z-index: 2;
    padding: clamp(1rem, 2.4vw, 1.6rem);
    border: 1px solid var(--border);
    border-radius: 0 12px 12px 12px;
    background:
      linear-gradient(180deg, #100e0c, #191511 22%, #1f1a15 100%);
    box-shadow:
      inset 0 18px 32px -28px #000000,
      inset 0 -1px 0 color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .docket-handle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: min(100%, 18rem);
    margin: -0.2rem auto 1rem;
    padding: 0.45rem 1rem;
    border: 1px solid color-mix(in srgb, var(--apricot) 22%, var(--border));
    border-radius: 999px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--ink) 5%, transparent), transparent);
  }

  .docket-handle span {
    width: 28px;
    height: 1px;
    background: color-mix(in srgb, var(--apricot) 55%, transparent);
  }

  .docket-handle i {
    width: 7px;
    height: 7px;
    border: 1px solid color-mix(in srgb, var(--apricot) 60%, transparent);
    border-radius: 50%;
  }

  .docket-stack {
    position: relative;
    min-height: 28rem;
  }

  .docket-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 26rem;
    padding: clamp(1.25rem, 3vw, 2.2rem);
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    border-radius: 12px;
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in srgb, var(--primary) 8%, transparent), transparent 48%),
      linear-gradient(180deg, #29231c, #221d17 55%, #1e1914);
    color: var(--ink);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 7%, transparent),
      0 20px 40px -26px #000000;
    overflow: hidden;
  }

  .docket-card[hidden] {
    display: none;
  }

  .docket-card.is-active {
    animation: docket-in 480ms var(--ease-out) both;
  }

  .docket-card::before {
    position: absolute;
    inset: 0;
    content: "";
    opacity: 0.2;
    mix-blend-mode: soft-light;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.88' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  .docket-card-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.625rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .docket-card h3 {
    position: relative;
    z-index: 1;
    max-width: 16ch;
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .docket-card-deck {
    position: relative;
    z-index: 1;
    max-width: 52ch;
    margin-top: 1rem;
    color: var(--ink-soft);
    font-size: 0.96875rem;
    line-height: 1.75;
  }

  .docket-card-facts {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .docket-card-facts div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .docket-card-facts dt {
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .docket-card-facts dd {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  .docket-card-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    min-height: 44px;
    margin-top: 1.1rem;
    color: var(--primary);
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 180ms var(--ease);
  }

  .docket-card-link svg {
    width: 0.85rem;
    height: 0.85rem;
    transition: transform 200ms var(--ease);
  }

  .docket-card-link:hover {
    color: var(--control-highlight);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .docket-card-link:hover svg {
    transform: translateX(3px);
  }

  .docket-stamp {
    position: absolute;
    right: 1.2rem;
    bottom: 0.3rem;
    color: color-mix(in srgb, var(--ink) 7%, transparent);
    font-family: var(--font-display);
    font-size: clamp(6rem, 14vw, 11rem);
    font-weight: 300;
    letter-spacing: -0.08em;
    line-height: 0.8;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    user-select: none;
  }

  .docket-crease {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 0 46%, color-mix(in srgb, white 4%, transparent) 47%, transparent 48%);
  }

  .docket-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 1rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  @keyframes docket-in {
    from {
      opacity: 0;
      transform: translateY(0.7rem) rotate(-0.35deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .docket {
      padding: 0.75rem;
    }

    .docket-plate {
      margin-top: -1.4rem;
      width: calc(100% - 1.5rem);
      padding-inline: 1rem;
    }

    .docket-tab {
      min-height: 44px;
      padding-inline: 0.65rem;
    }

    .docket-drawer {
      padding: 0.75rem;
    }

    .docket-stack {
      min-height: 24rem;
    }

    .docket-card {
      min-height: 22rem;
      padding: 1.15rem;
    }

    .docket-card h3 {
      font-size: clamp(1.9rem, 9vw, 2.6rem);
    }

    .docket-stamp {
      font-size: 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .docket-tab,
    .docket-card-link svg {
      transition: none;
    }

    .docket-card.is-active {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-docket]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-docket-tab]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-docket-card]'));

    if (!tabs.length || tabs.length !== cards.length) return;

    const activate = (index: number, focus = false) => {
      const activeTab = tabs[index];
      if (!activeTab) return;

      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.classList.toggle('is-active', selected);
        tab.setAttribute('aria-selected', selected ? 'true' : 'false');
        tab.tabIndex = selected ? 0 : -1;
      });

      cards.forEach((card, cardIndex) => {
        const selected = cardIndex === index;
        card.hidden = !selected;
        card.classList.toggle('is-active', selected);
      });

      if (focus) activeTab.focus();
      activeTab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight' || event.key === 'ArrowDown') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(next, true);
      });
    });
  });
</script>
