---
/**
 * Site header: the exact Framer "Motion Overlay Menu" module, place into a
 * fixed dock so the bar stays above the page. The reading-progress line is
 * page chrome that lives outside the component.
 */
import OverlayMenu from './react/OverlayMenu.jsx';
import { navigation, site, socialLinks } from '../../config';

const links = [...navigation, { label: 'Contact', href: '/contact' }].map((item) => ({
  label: item.label,
  link: item.href,
}));

const secondary = socialLinks.map((item) => ({
  label: item.label,
  link: item.href,
  newTab: item.external,
}));
---

<div class="site-header" data-motion-header>
  <div class="site-header-bar">
    <OverlayMenu
      client:only="react"
      logo="image"
      logoImage={{ src: '/mark.png', alt: '' }}
      logoSize={26}
      brand={site.name}
      brandLink="/"
      links={links}
      secondary={secondary}
      note={`${site.email} — ${site.tagline}`}
      noteLink={`mailto:${site.email}`}
      menuLabel="Index"
      showLabel={true}
      showNumbers={true}
      align="left"
      reveal="circle"
      duration={0.8}
      stagger={70}
      headerColor="#f4efe6"
      barBackground="rgba(19, 17, 16, 0.97)"
      barBorder="rgba(58, 52, 46, 0.9)"
      barRadius="999px"
      overlayBackground="rgba(19, 17, 16, 0.97)"
      overlayText="#f4efe6"
      overlayBar="rgba(244, 239, 230, 0.08)"
      accent="#cf5a3c"
      glow="rgba(207, 90, 60, 0.18)"
      barBlur={24}
      brandFont={{ fontFamily: "'Redaction 35', serif", fontSize: '21px', fontWeight: 500, letterSpacing: '-0.03em' }}
      linkFont={{ fontFamily: "'Redaction 35', serif", fontSize: '64px', fontWeight: 400, letterSpacing: '-0.03em' }}
    />
  </div>

  <div class="read-progress" aria-hidden="true"><span data-reading-progress></span></div>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 60;
    pointer-events: none;
  }

  .site-header-bar {
    padding: 0.65rem var(--gutter) 0;
    pointer-events: auto;
  }

  .read-progress {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    pointer-events: none;
  }

  .read-progress span {
    display: block;
    height: 100%;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  @media (max-width: 860px) {
    .site-header-bar {
      padding: 0.5rem var(--gutter) 0;
    }
  }
</style>

<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');

  if (progress) {
    let frame = 0;

    const paint = () => {
      frame = 0;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
      progress.style.transform = `scaleX(${ratio})`;
    };

    const queue = () => {
      if (!frame) frame = window.requestAnimationFrame(paint);
    };

    paint();
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
  }
</script>
