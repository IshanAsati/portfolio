---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import planShot from '../assets/projects/atlas-fit/mobile-plan.png';
import workoutShot from '../assets/projects/atlas-fit/mobile-session.png';
import bodyShot from '../assets/projects/atlas-fit/mobile-library.png';
import atlasLanding from '../assets/projects/atlas/landing-1440.png';
import atlasPhone from '../assets/projects/atlas/landing-390.png';
import studyflowDash from '../assets/projects/studyflow/dashboard-1440.png';
import studyflowPhone from '../assets/projects/studyflow/dashboard-390.png';
import halcyonBoard from '../assets/projects/halcyon/board-1440.png';
import halcyonPhone from '../assets/projects/halcyon/now-390.png';

interface Props {
  kind: 'dermoai' | 'atlas-fit' | 'atlas' | 'studyflow' | 'halcyon' | 'robotics' | 'programming';
  class?: string;
  priority?: boolean;
  caption?: string;
}

const { kind, class: className = '', priority = false, caption } = Astro.props;

const atlasShots: Array<{
  src: ImageMetadata;
  alt: string;
  label: string;
  className: string;
}> = [
  {
    src: planShot,
    alt: 'Atlas Fit plan screen showing a generated training plan by day.',
    label: 'Plan',
    className: 'phone--plan',
  },
  {
    src: workoutShot,
    alt: 'Atlas Fit workout screen showing a guided training session and set logging.',
    label: 'Session',
    className: 'phone--workout',
  },
  {
    src: bodyShot,
    alt: 'Atlas Fit exercise library screen showing the muscle-focused library.',
    label: 'Library',
    className: 'phone--body',
  },
];
---

<figure class:list={['artwork', `artwork--${kind}`, className]}>
  {kind === 'dermoai' && (
    <div class="plate plate--dermoai">
      <div class="plate-meta">
        <span>Fig. 01 — Classification study</span>
        <span>ConvNeXt-Base / TTA</span>
      </div>

      <div class="dermoai-diagram" aria-hidden="true">
        <div class="diagram-node diagram-input">
          <span class="diagram-label">Input</span>
          <div class="pixel-grid">
            {Array.from({ length: 36 }).map((_, i) => (
              <i style={`--i:${(i * 37) % 100}`} />
            ))}
          </div>
          <span class="diagram-sub">Skin image</span>
        </div>

        <div class="diagram-link">
          <span class="link-dot" />
          <span class="link-line" />
          <span class="link-dot" />
        </div>

        <div class="diagram-node diagram-model">
          <span class="diagram-label">Backbone</span>
          <div class="model-bars">
            {Array.from({ length: 5 }).map((_, i) => (
              <i style={`--i:${i}`} />
            ))}
          </div>
          <span class="diagram-sub">Fine-tuned features</span>
        </div>

        <div class="diagram-link">
          <span class="link-dot" />
          <span class="link-line" />
          <span class="link-dot" />
        </div>

        <div class="diagram-node diagram-output">
          <span class="diagram-label">Output</span>
          <div class="class-bars">
            {[46, 30, 64, 38, 84, 52, 22, 70, 42, 58, 34, 48].map((height, i) => (
              <i style={`--h:${height}%;--i:${i}`} />
            ))}
          </div>
          <span class="diagram-sub">12 classes</span>
        </div>
      </div>

      <div class="plate-metrics">
        <div class="metric">
          <span class="metric-value">82.79<span>%</span></span>
          <span class="metric-label">Reported accuracy</span>
        </div>
        <div class="metric">
          <span class="metric-value">87.30<span>%</span></span>
          <span class="metric-label">Cancer-class sensitivity</span>
        </div>
        <div class="metric metric--note">
          <span class="metric-value metric-value--small">12</span>
          <span class="metric-label">Output classes</span>
        </div>
      </div>

      <div class="plate-foot">
        <span>Research prototype — not clinically validated</span>
        <span>I. Asati</span>
      </div>
    </div>
  )}

  {kind === 'atlas-fit' && (
    <div class="plate plate--atlas">
      <div class="plate-meta">
        <span>Fig. 02 — Product study</span>
        <span>Offline-first PWA</span>
      </div>

      <div class="atlas-stage">
        <div class="atlas-index" aria-hidden="true">
          <span>Local</span>
          <span>data</span>
          <span>ownership</span>
        </div>

        {atlasShots.map((shot, i) => (
          <div class:list={['phone', shot.className]}>
            <div class="phone-frame">
              <Image
                src={shot.src}
                alt={shot.alt}
                widths={[240, 360, 480]}
                sizes="(max-width: 700px) 32vw, 220px"
                loading={priority ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
            <span class="phone-label">
              <em>0{i + 1}</em> {shot.label}
            </span>
          </div>
        ))}

        <div class="atlas-stamp" aria-hidden="true">
          <span>Offline</span>
          <span>by default</span>
        </div>
      </div>

      <div class="plate-foot">
        <span>React · TypeScript · Dexie</span>
        <span>In development</span>
      </div>
    </div>
  )}

  {kind === 'atlas' && (
    <div class="plate plate--study plate--atlas-app">
      <div class="plate-meta">
        <span>Fig. 03 — Study operating system</span>
        <span>Landing / welcome</span>
      </div>

      <div class="study-stage study-stage--duo">
        <div class="study-shot study-shot--wide">
          <Image
            src={atlasLanding}
            alt="Atlas landing page: a study coach that argues back, with a Socratic coaching exchange."
            widths={[640, 960, 1280]}
            sizes="(max-width: 700px) 88vw, 760px"
            loading={priority ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
        <div class="study-shot study-shot--phone" aria-hidden="true">
          <Image
            src={atlasPhone}
            alt=""
            widths={[180, 280, 390]}
            sizes="180px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div class="study-tags">
        <span>PDF extraction</span>
        <span>Streaming coach</span>
        <span>Confidence model</span>
      </div>

      <div class="plate-foot">
        <span>Next.js · DeepSeek · Appwrite</span>
        <span>Six screens built</span>
      </div>
    </div>
  )}

  {kind === 'studyflow' && (
    <div class="plate plate--study plate--studyflow">
      <div class="plate-meta">
        <span>Fig. 04 — Study companion</span>
        <span>Dashboard / dark theme</span>
      </div>

      <div class="study-stage study-stage--duo">
        <div class="study-shot study-shot--wide">
          <Image
            src={studyflowDash}
            alt="StudyFlow dashboard showing the Pomodoro timer, study statistics and today's tasks."
            widths={[640, 960, 1280]}
            sizes="(max-width: 700px) 88vw, 760px"
            loading={priority ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
        <div class="study-shot study-shot--phone" aria-hidden="true">
          <Image
            src={studyflowPhone}
            alt=""
            widths={[180, 280, 390]}
            sizes="180px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div class="study-tags">
        <span>Pomodoro</span>
        <span>Tasks</span>
        <span>Analytics</span>
      </div>

      <div class="plate-foot">
        <span>React · TypeScript · Appwrite</span>
        <span>Complete loop</span>
      </div>
    </div>
  )}

  {kind === 'halcyon' && (
    <div class="plate plate--study plate--halcyon">
      <div class="plate-meta">
        <span>Fig. 05 — Focus ritual</span>
        <span>Board / dark theme</span>
      </div>

      <div class="study-stage study-stage--duo">
        <div class="study-shot study-shot--wide">
          <Image
            src={halcyonBoard}
            alt="Halcyon board view with backlog, today, in progress and done columns."
            widths={[640, 960, 1280]}
            sizes="(max-width: 700px) 88vw, 760px"
            loading={priority ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
        <div class="study-shot study-shot--phone" aria-hidden="true">
          <Image
            src={halcyonPhone}
            alt=""
            widths={[180, 280, 390]}
            sizes="180px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <div class="study-tags">
        <span>Local-first</span>
        <span>Focus timer</span>
        <span>Ambient studio</span>
      </div>

      <div class="plate-foot">
        <span>Next.js · TypeScript · IndexedDB</span>
        <span>Account-free</span>
      </div>
    </div>
  )}

  {kind === 'robotics' && (
    <div class="plate plate--robotics">
      <div class="plate-meta">
        <span>Fig. 06 — System sketch</span>
        <span>ESP32 / sensors</span>
      </div>

      <svg
        class="circuit"
        viewBox="0 0 820 500"
        role="img"
        aria-labelledby="circuit-title circuit-desc"
      >
        <title id="circuit-title">Concept schematic of an ESP32-based sensor device</title>
        <desc id="circuit-desc">
          An ESP32 board at the centre connected to PIR, infrared, ultrasonic and sound sensors,
          plus an LCD, LEDs, a buzzer and physical buttons. The drawing is a concept diagram,
          not a verified wiring diagram.
        </desc>

        <g class="circuit-grid" aria-hidden="true">
          {Array.from({ length: 17 }).map((_, i) => (
            <line x1={i * 50} y1="0" x2={i * 50} y2="500" />
          ))}
          {Array.from({ length: 11 }).map((_, i) => (
            <line x1="0" y1={i * 50} x2="820" y2={i * 50} />
          ))}
        </g>

        <g class="circuit-traces" aria-hidden="true">
          <path d="M 350 250 H 235 V 150 H 190" />
          <path d="M 350 250 H 235 V 250 H 190" />
          <path d="M 350 250 H 235 V 350 H 190" />
          <path d="M 470 250 H 585 V 150 H 630" />
          <path d="M 470 250 H 585 V 250 H 630" />
          <path d="M 470 250 H 585 V 350 H 630" />
          <path d="M 410 205 V 105 H 290" />
          <path d="M 410 295 V 405 H 530" />
          <circle cx="235" cy="150" r="4" />
          <circle cx="235" cy="250" r="4" />
          <circle cx="235" cy="350" r="4" />
          <circle cx="585" cy="150" r="4" />
          <circle cx="585" cy="250" r="4" />
          <circle cx="585" cy="350" r="4" />
          <circle cx="290" cy="105" r="4" />
          <circle cx="530" cy="405" r="4" />
        </g>

        <g class="circuit-board">
          <rect x="345" y="195" width="130" height="110" rx="12" />
          <text x="410" y="236" text-anchor="middle" class="board-name">ESP32</text>
          <text x="410" y="258" text-anchor="middle" class="board-sub">MICROCONTROLLER</text>
          <g class="board-pins">
            {Array.from({ length: 7 }).map((_, i) => (
              <line x1={345 + i * 18 + 9} y1="195" x2={345 + i * 18 + 9} y2="185" />
            ))}
            {Array.from({ length: 7 }).map((_, i) => (
              <line x1={345 + i * 18 + 9} y1="305" x2={345 + i * 18 + 9} y2="315" />
            ))}
          </g>
        </g>

        <g class="circuit-nodes">
          <g>
            <rect x="105" y="132" width="85" height="36" rx="10" />
            <text x="147" y="155" text-anchor="middle">PIR</text>
          </g>
          <g>
            <rect x="105" y="232" width="85" height="36" rx="10" />
            <text x="147" y="255" text-anchor="middle">IR</text>
          </g>
          <g>
            <rect x="105" y="332" width="85" height="36" rx="10" />
            <text x="147" y="355" text-anchor="middle">ULTRASONIC</text>
          </g>
          <g>
            <rect x="630" y="132" width="85" height="36" rx="10" />
            <text x="672" y="155" text-anchor="middle">LCD</text>
          </g>
          <g>
            <rect x="630" y="232" width="85" height="36" rx="10" />
            <text x="672" y="255" text-anchor="middle">LEDS</text>
          </g>
          <g>
            <rect x="630" y="332" width="85" height="36" rx="10" />
            <text x="672" y="355" text-anchor="middle">BUZZER</text>
          </g>
          <g>
            <rect x="220" y="87" width="70" height="30" rx="10" />
            <text x="255" y="106" text-anchor="middle">SOUND</text>
          </g>
          <g>
            <rect x="530" y="390" width="80" height="30" rx="10" />
            <text x="570" y="409" text-anchor="middle">BUTTONS</text>
          </g>
        </g>

        <g class="circuit-annotations">
          <text x="105" y="112">SENSE</text>
          <text x="630" y="112">RESPOND</text>
          <text x="105" y="455">CONCEPT DIAGRAM — NOT A VERIFIED WIRING DIAGRAM</text>
          <text x="715" y="455" text-anchor="end">VOL. 01</text>
        </g>
      </svg>

      <div class="plate-foot">
        <span>PIR · IR · ultrasonic · sound</span>
        <span>Prototypes / concepts</span>
      </div>
    </div>
  )}

  {kind === 'programming' && (
    <div class="plate plate--programming">
      <div class="plate-meta">
        <span>Fig. 07 — Reserved pages</span>
        <span>Python / Pygame</span>
      </div>

      <div class="programming-stage" aria-hidden="true">
        <div class="programming-word">
          <span class="programming-number">07</span>
          <span class="programming-title">Forth<em>coming</em></span>
        </div>
        <div class="programming-grid">
          {['Game loop', 'Sprite study', 'Input', 'Physics', 'Score', 'Idea pending'].map((label, i) => (
            <div class="programming-cell" style={`--i:${i}`}>
              <span class="cell-mark">+</span>
              <span class="cell-label">{label}</span>
              <span class="cell-line" />
            </div>
          ))}
        </div>
      </div>

      <div class="plate-foot">
        <span>No finished projects published yet</span>
        <span>Index entry</span>
      </div>
    </div>
  )}

  {caption && <figcaption class="artwork-caption">{caption}</figcaption>}
</figure>

<style>
  .artwork {
    margin: 0;
  }

  .plate {
    position: relative;
    overflow: hidden;
    padding: clamp(0.9rem, 2vw, 1.35rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .plate-meta,
  .plate-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.5625rem;
    font-weight: 650;
    letter-spacing: 0.07em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .plate-meta {
    padding-bottom: 0.85rem;
  }

  .plate-foot {
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }

  .plate-foot span:last-child {
    text-align: right;
  }

  /* DermoAI */

  .plate--dermoai {
    background:
      repeating-linear-gradient(90deg, transparent 0, transparent 79px, rgba(250, 249, 245, 0.04) 80px),
      repeating-linear-gradient(0deg, transparent 0, transparent 79px, rgba(250, 249, 245, 0.04) 80px),
      #10100f;
  }

  .dermoai-diagram {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1rem);
    padding-block: clamp(1.75rem, 4.5vw, 3.25rem);
  }

  .diagram-node {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    min-width: 0;
  }

  .diagram-label {
    color: var(--primary);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .diagram-sub {
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .pixel-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 2px;
    aspect-ratio: 1;
    max-width: 7.5rem;
    padding: 5px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .pixel-grid i {
    border-radius: 1px;
    background: color-mix(
      in srgb,
      var(--muted) calc(18% + (var(--i) * 0.42%)),
      #10100f
    );
  }

  .model-bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 4rem;
    max-width: 6rem;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--border);
  }

  .model-bars i {
    flex: 1;
    height: calc(30% + (var(--i) * 13%));
    border-radius: 2px 2px 0 0;
    background: var(--primary);
    opacity: calc(0.4 + (var(--i) * 0.15));
  }

  .class-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 4rem;
    max-width: 8.5rem;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--border);
  }

  .class-bars i {
    flex: 1;
    height: var(--h);
    border-radius: 2px 2px 0 0;
    background: var(--ink);
    opacity: calc(0.3 + (var(--i) * 0.04));
  }

  .class-bars i:nth-child(5) {
    background: var(--control-highlight);
    opacity: 1;
  }

  .diagram-link {
    display: flex;
    align-items: center;
    width: clamp(0.9rem, 2.5vw, 2.2rem);
  }

  .link-dot {
    width: 3px;
    height: 3px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--muted);
  }

  .link-line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .plate-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 1rem;
    padding-block: clamp(1.25rem, 3vw, 1.85rem);
    border-top: 1px solid var(--line);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .metric-value {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5vw, 3.9rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }

  .metric-value span {
    color: var(--primary);
    font-size: 0.55em;
    letter-spacing: 0;
  }

  .metric-value--small {
    color: var(--ink);
  }

  .metric-label {
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* Atlas Fit */

  .plate--atlas {
    background:
      radial-gradient(circle at 82% 12%, color-mix(in srgb, var(--primary) 20%, transparent), transparent 42%),
      var(--warm);
  }

  .atlas-stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    gap: clamp(0.5rem, 2vw, 1.25rem);
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(0.25rem, 3vw, 1.5rem) clamp(1.5rem, 3.5vw, 2.25rem);
  }

  .atlas-index {
    position: absolute;
    top: 1.25rem;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .phone {
    position: relative;
    min-width: 0;
  }

  .phone--plan {
    transform: translateY(0.5rem) rotate(-1.6deg);
  }

  .phone--workout {
    z-index: 1;
    transform: translateY(-0.75rem);
  }

  .phone--body {
    transform: translateY(1rem) rotate(1.6deg);
  }

  .phone-frame {
    padding: clamp(3px, 0.6vw, 5px);
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #0f0f0e;
    box-shadow: 0 18px 36px #00000052;
  }

  .phone-frame :global(img) {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .phone-label {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .phone-label em {
    font-style: normal;
    color: var(--primary);
  }

  .atlas-stamp {
    position: absolute;
    right: 0;
    bottom: 0.4rem;
    display: flex;
    flex-direction: column;
    color: var(--muted);
    font-size: 0.5rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    line-height: 1.45;
    text-align: right;
    text-transform: uppercase;
  }

  /* Screenshot plates */

  .plate--study {
    background:
      radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--primary) 10%, transparent), transparent 38%),
      var(--paper);
  }

  .study-stage {
    position: relative;
    padding-block: clamp(1rem, 2.4vw, 1.6rem);
  }

  .study-shot {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #0f0f0e;
    box-shadow: 0 20px 50px #0000004d;
  }

  .study-shot :global(img) {
    width: 100%;
    height: auto;
  }

  .study-stage--duo {
    padding-right: clamp(0.5rem, 5vw, 2.75rem);
  }

  .study-shot--wide {
    width: 100%;
  }

  .study-shot--phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(78px, 19%, 150px);
    transform: rotate(3deg) translateY(-0.25rem);
    box-shadow: 0 20px 40px #00000070;
  }

  .study-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-block: 0 0.95rem;
  }

  .study-tags span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 26px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: 100px;
    background: color-mix(in srgb, var(--warm) 80%, transparent);
    color: var(--muted);
